  "headings": {
    "REV.1.1.s1": {
      "en": "The revelation of Jesus {{christos:Christ|the Messiah}}",
      "sw": "Ufunuo wa Yesu {{christos:Kristo|Masihi}}",
      "am": "የኢየሱስ {{christos:ክርስቶስ|መሲሑ}} ራእይ"
    },
    "REV.1.9.s1": {
      "en": "One like a son of man among the lampstands",
      "sw": "Mmoja kama mwana wa mtu kati ya vinara",
      "am": "በመቅረዞቹ መካከል የሰው ልጅ የሚመስል"
    },
    "REV.2.1.s1": {
      "en": "To the church in Ephesus",
      "sw": "Kwa kanisa la Efeso",
      "am": "በኤፌሶን ላለችው ቤተ ክርስቲያን"
    },
    "REV.2.8.s1": {
      "en": "To the church in Smyrna",
      "sw": "Kwa kanisa la Smirna",
      "am": "በሰምርኔስ ላለችው ቤተ ክርስቲያን"
    },
    "REV.2.12.s1": {
      "en": "To the church in Pergamum",
      "sw": "Kwa kanisa la Pergamo",
      "am": "በጴርጋሞን ላለችው ቤተ ክርስቲያን"
    },
    "REV.2.18.s1": {
      "en": "To the church in Thyatira",
      "sw": "Kwa kanisa la Thiatira",
      "am": "በትያጥሮን ላለችው ቤተ ክርስቲያን"
    },
    "REV.3.1.s1": {
      "en": "To the church in Sardis",
      "sw": "Kwa kanisa la Sardi",
      "am": "በሰርዴስ ላለችው ቤተ ክርስቲያን"
    },
    "REV.3.7.s1": {
      "en": "To the church in Philadelphia",
      "sw": "Kwa kanisa la Filadelfia",
      "am": "በፊልድልፍያ ላለችው ቤተ ክርስቲያን"
    },
    "REV.3.14.s1": {
      "en": "To the church in Laodicea",
      "sw": "Kwa kanisa la Laodikia",
      "am": "በሎዶቅያ ላለችው ቤተ ክርስቲያን"
    },
    "REV.4.1.s1": {
      "en": "The throne in heaven",
      "sw": "Kiti cha enzi mbinguni",
      "am": "በሰማይ ያለው ዙፋን"
    },
    "REV.5.1.s1": {
      "en": "The sealed scroll",
      "sw": "Gombo lililotiwa muhuri",
      "am": "የታተመው ጥቅልል"
    },
    "REV.5.6.s1": {
      "en": "The Lamb takes the scroll",
      "sw": "Mwanakondoo anachukua gombo",
      "am": "በጉ ጥቅልሉን ወሰደ"
    },
    "REV.6.1.s1": {
      "en": "The first four seals",
      "sw": "Mihuri minne ya kwanza",
      "am": "የመጀመሪያዎቹ አራት ማኅተሞች"
    },
    "REV.6.9.s1": {
      "en": "The fifth seal: the souls under the altar",
      "sw": "Muhuri wa tano: roho chini ya madhabahu",
      "am": "አምስተኛው ማኅተም፤ ከመሠዊያው በታች ያሉ ነፍሳት"
    },
    "REV.6.12.s1": {
      "en": "The sixth seal: the great day",
      "sw": "Muhuri wa sita: siku kuu",
      "am": "ስድስተኛው ማኅተም፤ ታላቁ ቀን"
    },
    "REV.7.1.s1": {
      "en": "God's servants are sealed",
      "sw": "Watumishi wa Mungu wanatiwa muhuri",
      "am": "የእግዚአብሔር ባሪያዎች ታተሙ"
    },
    "REV.7.9.s1": {
      "en": "A crowd from every nation",
      "sw": "Umati kutoka kila taifa",
      "am": "ከሕዝብ ሁሉ የመጣ እልፍ ሕዝብ"
    },
    "REV.8.1.s1": {
      "en": "The seventh seal and the golden censer",
      "sw": "Muhuri wa saba na chetezo cha dhahabu",
      "am": "ሰባተኛው ማኅተምና የወርቁ ጥና"
    },
    "REV.8.6.s1": {
      "en": "The first four trumpets",
      "sw": "Tarumbeta nne za kwanza",
      "am": "የመጀመሪያዎቹ አራት መለከቶች"
    },
    "REV.9.1.s1": {
      "en": "The fifth trumpet: locusts from the abyss",
      "sw": "Tarumbeta ya tano: nzige kutoka kilindini",
      "am": "አምስተኛው መለከት፤ ከጥልቁ የወጡ አንበጦች"
    },
    "REV.9.13.s1": {
      "en": "The sixth trumpet: the army from the Euphrates",
      "sw": "Tarumbeta ya sita: jeshi kutoka Frati",
      "am": "ስድስተኛው መለከት፤ ከኤፍራጥስ የመጣው ሠራዊት"
    },
    "REV.10.1.s1": {
      "en": "The angel and the little scroll",
      "sw": "Malaika na gombo dogo",
      "am": "መልአኩና ትንሿ ጥቅልል"
    },
    "REV.11.1.s1": {
      "en": "The two witnesses",
      "sw": "Mashahidi wawili",
      "am": "ሁለቱ ምስክሮች"
    },
    "REV.11.15.s1": {
      "en": "The seventh trumpet",
      "sw": "Tarumbeta ya saba",
      "am": "ሰባተኛው መለከት"
    },
    "REV.12.1.s1": {
      "en": "The woman and the dragon",
      "sw": "Mwanamke na joka",
      "am": "ሴቲቱና ዘንዶው"
    },
    "REV.12.7.s1": {
      "en": "War in heaven",
      "sw": "Vita mbinguni",
      "am": "በሰማይ የሆነ ጦርነት"
    },
    "REV.12.13.s1": {
      "en": "The dragon pursues the woman",
      "sw": "Joka linamfuatia mwanamke",
      "am": "ዘንዶው ሴቲቱን አሳደዳት"
    },
    "REV.13.1.s1": {
      "en": "The beast from the sea",
      "sw": "Mnyama kutoka baharini",
      "am": "ከባሕር የወጣው አውሬ"
    },
    "REV.13.11.s1": {
      "en": "The beast from the earth",
      "sw": "Mnyama kutoka nchi kavu",
      "am": "ከምድር የወጣው አውሬ"
    },
    "REV.14.1.s1": {
      "en": "The Lamb and the 144,000",
      "sw": "Mwanakondoo na wale 144,000",
      "am": "በጉና 144,000ዎቹ"
    },
    "REV.14.6.s1": {
      "en": "Three angels",
      "sw": "Malaika watatu",
      "am": "ሦስቱ መላእክት"
    },
    "REV.14.14.s1": {
      "en": "The harvest of the earth",
      "sw": "Mavuno ya dunia",
      "am": "የምድር መከር"
    },
    "REV.15.1.s1": {
      "en": "Seven angels with the last plagues",
      "sw": "Malaika saba wenye mapigo ya mwisho",
      "am": "የመጨረሻ መቅሠፍቶች የያዙ ሰባት መላእክት"
    },
    "REV.16.1.s1": {
      "en": "The seven bowls of God's fury",
      "sw": "Mabakuli saba ya hasira kali ya Mungu",
      "am": "የእግዚአብሔር ቁጣ ሰባቱ ጽዋዎች"
    },
    "REV.17.1.s1": {
      "en": "The prostitute on the beast",
      "sw": "Kahaba juu ya mnyama",
      "am": "በአውሬው ላይ የተቀመጠችው ጋለሞታ"
    },
    "REV.18.1.s1": {
      "en": "The fall of Babylon",
      "sw": "Kuanguka kwa Babeli",
      "am": "የባቢሎን መውደቅ"
    },
    "REV.18.4.s1": {
      "en": "Come out of her, my people",
      "sw": "Tokeni kwake, watu {{deity_pronoun:wangu|Wangu}}",
      "am": "ሕዝቤ ሆይ፣ ከእርሷ ውጡ"
    },
    "REV.19.1.s1": {
      "en": "Hallelujah in heaven",
      "sw": "Haleluya mbinguni",
      "am": "በሰማይ የተሰማ ሃሌ ሉያ"
    },
    "REV.19.11.s1": {
      "en": "The rider on the white horse",
      "sw": "Mpanda farasi mweupe",
      "am": "በነጭ ፈረስ ላይ የተቀመጠው"
    },
    "REV.20.1.s1": {
      "en": "The thousand years",
      "sw": "Miaka elfu",
      "am": "ሺው ዓመት"
    },
    "REV.20.11.s1": {
      "en": "The great white throne",
      "sw": "Kiti kikuu cheupe cha enzi",
      "am": "ታላቁ ነጭ ዙፋን"
    },
    "REV.21.1.s1": {
      "en": "A new heaven and a new earth",
      "sw": "Mbingu mpya na nchi mpya",
      "am": "አዲስ ሰማይና አዲስ ምድር"
    },
    "REV.21.9.s1": {
      "en": "The new Jerusalem",
      "sw": "Yerusalemu mpya",
      "am": "አዲሲቱ ኢየሩሳሌም"
    },
    "REV.22.1.s1": {
      "en": "The river of the water of life",
      "sw": "Mto wa maji ya uzima",
      "am": "የሕይወት ውኃ ወንዝ"
    },
    "REV.22.6.s1": {
      "en": "I am coming soon",
      "sw": "Ninakuja upesi",
      "am": "ቶሎ እመጣለሁ"
    }
  }
}
