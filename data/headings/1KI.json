      "ko": "이스라엘 왕 오므리"
    },
    "1KI.16.29.s1": {
      "en": "Ahab king of Israel",
      "sw": "Ahabu mfalme wa Israeli",
      "am": "የእስራኤል ንጉሥ አክዓብ",
      "vi": "A-háp, vua Y-sơ-ra-ên",
      "ko": "이스라엘 왕 아합"
    },
    "1KI.17.1.s1": {
      "en": "Elijah announces a drought",
      "sw": "Eliya anatangaza ukame",
      "am": "ኤልያስ ድርቅ እንደሚመጣ ተናገረ",
      "vi": "Ê-li báo trước hạn hán",
      "ko": "가뭄을 선포하는 엘리야"
    },
    "1KI.17.8.s1": {
      "en": "The widow of Zarephath",
      "sw": "Mjane wa Sarepta",
      "am": "የሰራፕታዋ መበለት",
      "vi": "Người góa phụ ở Sa-rép-ta",
      "ko": "사렙다의 과부"
    },
    "1KI.17.17.s1": {
      "en": "Elijah raises the widow's son",
      "sw": "Eliya anamfufua mwana wa mjane",
      "am": "ኤልያስ የመበለቲቱን ልጅ ከሞት አስነሣ",
      "vi": "Ê-li làm cho con trai người góa phụ sống lại",
      "ko": "과부의 아들을 살린 엘리야"
    },
    "1KI.18.1.s1": {
      "en": "Elijah and Obadiah",
      "sw": "Eliya na Obadia",
      "am": "ኤልያስና አብድዩ",
      "vi": "Ê-li và Áp-đia",
      "ko": "엘리야와 오바댜"
    },
    "1KI.18.15.s1": {
      "en": "Elijah and the prophets of Baal on Mount Carmel",
      "sw": "Eliya na manabii wa Baali juu ya Mlima Karmeli",
      "am": "ኤልያስና የበኣል ነቢያት በቀርሜሎስ ተራራ ላይ",
      "vi": "Ê-li và các tiên tri của Ba-anh trên núi Cạt-mên",
      "ko": "갈멜 산의 엘리야와 바알 예언자들"
    },
    "1KI.19.1.s1": {
      "en": "Elijah flees to Horeb",
      "sw": "Eliya anakimbilia Horebu",
      "am": "ኤልያስ ወደ ኮሬብ ሸሸ",
      "vi": "Ê-li trốn đến Hô-rếp",
      "ko": "호렙으로 도망한 엘리야"
    },
    "1KI.19.15.s1": {
      "en": "The call of Elisha",
      "sw": "Kuitwa kwa Elisha",
      "am": "የኤልሳዕ መጠራት",
      "vi": "Ê-li-sê được kêu gọi",
      "ko": "엘리사를 부르시다"
    },
    "1KI.20.1.s1": {
      "en": "Ben-hadad besieges Samaria",
      "sw": "Ben-hadadi anauzingira Samaria",
      "am": "ቤንሃዳድ ሰማርያን ከበበ",
      "vi": "Bên-Ha-đát vây hãm Sa-ma-ri",
      "ko": "사마리아를 포위한 벤하닷"
    },
    "1KI.20.23.s1": {
      "en": "Israel defeats Aram at Aphek",
      "sw": "Israeli wanaishinda Aramu huko Afeki",
      "am": "እስራኤል አራምን በአፌቅ ድል አደረገ",
      "vi": "Y-sơ-ra-ên đánh bại A-ram tại A-phéc",
      "ko": "아벡에서 아람을 무찌른 이스라엘"
    },
    "1KI.20.35.s1": {
      "en": "A prophet condemns Ahab",
      "sw": "Nabii anamhukumu Ahabu",
      "am": "አንድ ነቢይ በአክዓብ ላይ ፈረደ",
      "vi": "Một nhà tiên tri lên án A-háp",
      "ko": "아합을 꾸짖는 예언자"
    },
    "1KI.21.1.s1": {
      "en": "Naboth's vineyard",
      "sw": "Shamba la mizabibu la Nabothi",
      "am": "የናቡቴ የወይን ቦታ",
      "vi": "Vườn nho của Na-bốt",
      "ko": "나봇의 포도원"
    },
    "1KI.21.17.s1": {
      "en": "Elijah confronts Ahab",
      "sw": "Eliya anamkabili Ahabu",
      "am": "ኤልያስ አክዓብን ገጠመው",
      "vi": "Ê-li đối chất với A-háp",
      "ko": "아합을 꾸짖는 엘리야"
    },
    "1KI.21.27.s1": {
      "en": "Ahab humbles himself",
      "sw": "Ahabu anajinyenyekeza",
      "am": "አክዓብ ራሱን አዋረደ",
      "vi": "A-háp hạ mình",
      "ko": "겸손해진 아합"
    },
    "1KI.22.1.s1": {
      "en": "Micaiah warns Ahab",
      "sw": "Mikaya anamwonya Ahabu",
      "am": "ሚክያስ አክዓብን አስጠነቀቀ",
      "vi": "Mi-chê cảnh báo A-háp",
      "ko": "아합에게 경고하는 미가야"
    },
    "1KI.22.41.s1": {
      "en": "Jehoshaphat king of Judah",
      "sw": "Yehoshafati mfalme wa Yuda",
      "am": "የይሁዳ ንጉሥ ኢዮሣፍጥ",
      "vi": "Giô-sa-phát, vua Giu-đa",
      "ko": "유다 왕 여호사밧"
    },
    "1KI.22.52.s1": {
      "en": "Ahaziah king of Israel",
      "sw": "Ahazia mfalme wa Israeli",
      "am": "የእስራኤል ንጉሥ አካዝያስ",
      "vi": "A-cha-xia, vua Y-sơ-ra-ên",
      "ko": "이스라엘 왕 아하시야"
    }
  }
}
