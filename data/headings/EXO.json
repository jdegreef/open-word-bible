    "EXO.36.14.s1": {
      "en": "Making the tent of goats' hair",
      "sw": "Kutengeneza hema la manyoya ya mbuzi",
      "am": "የፍየል ጠጉር ድንኳኑን መሥራት"
    },
    "EXO.36.20.s1": {
      "en": "Making the frames and the inner curtain",
      "sw": "Kutengeneza fremu na pazia la ndani",
      "am": "ሳንቃዎቹንና ውስጠኛውን መጋረጃ መሥራት"
    },
    "EXO.37.1.s1": {
      "en": "Making the ark",
      "sw": "Kutengeneza sanduku",
      "am": "ታቦቱን መሥራት"
    },
    "EXO.37.10.s1": {
      "en": "Making the table",
      "sw": "Kutengeneza meza",
      "am": "ገበታውን መሥራት"
    },
    "EXO.37.17.s1": {
      "en": "Making the lampstand",
      "sw": "Kutengeneza kinara cha taa",
      "am": "መቅረዙን መሥራት"
    },
    "EXO.37.25.s1": {
      "en": "Making the altar of incense",
      "sw": "Kutengeneza madhabahu ya uvumba",
      "am": "የዕጣኑን መሠዊያ መሥራት"
    },
    "EXO.38.1.s1": {
      "en": "Making the altar of burnt offering",
      "sw": "Kutengeneza madhabahu ya sadaka ya kuteketezwa",
      "am": "የሚቃጠለውን መሥዋዕት መሠዊያ መሥራት"
    },
    "EXO.38.9.s1": {
      "en": "Making the courtyard",
      "sw": "Kutengeneza ua",
      "am": "አደባባዩን መሥራት"
    },
    "EXO.38.21.s1": {
      "en": "Metals used for the tabernacle",
      "sw": "Madini yaliyotumika kwa maskani",
      "am": "ለማደሪያው የዋሉ ማዕድናት"
    },
    "EXO.39.1.s1": {
      "en": "Making the priestly garments",
      "sw": "Kutengeneza mavazi ya kikuhani",
      "am": "የክህነት ልብሶችን መሥራት"
    },
    "EXO.39.8.s1": {
      "en": "Making the breastpiece",
      "sw": "Kutengeneza kifuko cha kifuani",
      "am": "የደረት ኪሱን መሥራት"
    },
    "EXO.39.32.s1": {
      "en": "The work is finished",
      "sw": "Kazi imekamilika",
      "am": "ሥራው ተፈጸመ"
    },
    "EXO.40.1.s1": {
      "en": "Instructions to set up the tabernacle",
      "sw": "Maagizo ya kusimamisha maskani",
      "am": "ማደሪያውን ስለ መትከል የተሰጠ መመሪያ"
    },
    "EXO.40.17.s1": {
      "en": "Moses sets up the tabernacle",
      "sw": "Musa anasimamisha maskani",
      "am": "ሙሴ ማደሪያውን ተከለ"
    },
    "EXO.40.34.s1": {
      "en": "The cloud and the glory",
      "sw": "Wingu na utukufu",
      "am": "ደመናውና ክብሩ"
    }
  }
}
