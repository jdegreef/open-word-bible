      "sw": "Vibao viwili vya ushuhuda",
      "am": "ሁለቱ የምስክር ጽላቶች"
    },
    "EXO.32.1.s1": {
      "en": "The calf of gold",
      "sw": "Ndama wa dhahabu",
      "am": "የወርቁ ጥጃ"
    },
    "EXO.32.7.s1": {
      "en": "Moses pleads for the people",
      "sw": "Musa anawaombea watu",
      "am": "ሙሴ ስለ ሕዝቡ ለመነ"
    },
    "EXO.32.15.s1": {
      "en": "Moses breaks the tablets",
      "sw": "Musa anavunja vibao",
      "am": "ሙሴ ጽላቶቹን ሰበረ"
    },
    "EXO.33.1.s1": {
      "en": "A grim message and the tent outside the camp",
      "sw": "Ujumbe mzito na hema nje ya kambi",
