    "EXO.35.30.s1": {
      "en": "Skilled workers for the sanctuary",
      "sw": "Mafundi stadi kwa ajili ya mahali patakatifu",
      "am": "ለመቅደሱ የተመረጡ ብልሃተኛ ሠራተኞች"
    },
    "EXO.36.1.s1": {
      "en": "The people give more than enough",
      "sw": "Watu wanatoa zaidi ya kutosha",
      "am": "ሕዝቡ ከሚበቃው በላይ ሰጡ"
