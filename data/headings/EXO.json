    "EXO.30.11.s1": {
      "en": "Atonement money",
      "sw": "Fedha ya upatanisho",
      "am": "የማስተስረያ ገንዘብ"
    },
    "EXO.30.17.s1": {
      "en": "The bronze basin",
      "sw": "Birika la shaba",
      "am": "የነሐሱ መታጠቢያ ሰን"
    },
    "EXO.30.22.s1": {
      "en": "The holy anointing oil",
      "sw": "Mafuta matakatifu ya kupaka",
      "am": "የተቀደሰው የቅብዓት ዘይት"
    },
    "EXO.30.34.s1": {
      "en": "The holy incense",
      "sw": "Uvumba mtakatifu",
      "am": "የተቀደሰው ዕጣን"
    },
    "EXO.31.1.s1": {
      "en": "Bezalel and Oholiab are chosen",
      "sw": "Bezaleli na Oholiabu wanachaguliwa",
      "am": "ባስልኤልና ኦሆሊያብ ተመረጡ"
    },
    "EXO.31.12.s1": {
      "en": "The Sabbath as a sign",
      "sw": "Sabato kama ishara",
      "am": "ሰንበት እንደ ምልክት"
