    },
    "EXO.33.12.s1": {
      "en": "Moses asks for God's presence",
      "sw": "Musa anaomba uwepo wa Mungu",
      "am": "ሙሴ የእግዚአብሔርን ሀልዎት ለመነ"
    },
    "EXO.33.17.s1": {
      "en": "Moses asks to see God's glory",
      "sw": "Musa anaomba kuuona utukufu wa Mungu",
      "am": "ሙሴ የእግዚአብሔርን ክብር ለማየት ለመነ"
    },
    "EXO.34.1.s1": {
      "en": "New tablets and the covenant renewed",
      "sw": "Vibao vipya na agano linafanywa upya",
