    },
    "AMO.1.3.s1": {
      "en": "Damascus, Gaza and Tyre",
      "sw": "Dameski, Gaza na Tiro",
      "am": "ደማስቆ፣ ጋዛና ጢሮስ"
    },
    "AMO.1.11.s1": {
      "en": "Edom and Ammon",
      "sw": "Edomu na Waamoni",
      "am": "ኤዶምና አሞናውያን"
    },
    "AMO.2.1.s1": {
      "en": "Moab and Judah",
      "sw": "Moabu na Yuda",
      "am": "ሞዓብና ይሁዳ"
    },
    "AMO.2.6.s1": {
      "en": "Israel",
      "sw": "Israeli",
      "am": "እስራኤል"
    },
    "AMO.3.1.s1": {
      "en": "You alone have I known",
      "sw": "Ni ninyi peke yenu niliowajua",
      "am": "እናንተን ብቻ አውቄአለሁ"
    },
    "AMO.3.11.s1": {
      "en": "An enemy will surround the land",
      "sw": "Adui ataizunguka nchi",
      "am": "ጠላት ምድሪቱን ይከብባል"
    },
    "AMO.4.1.s1": {
      "en": "Hear this word, cows of Bashan",
      "sw": "Sikilizeni neno hili, enyi ng'ombe wa Bashani",
      "am": "እናንተ የባሳን ላሞች፣ ይህን ቃል ስሙ"
    },
    "AMO.4.12.s1": {
      "en": "Prepare to meet your God",
      "sw": "Jiandae kukutana na Mungu wako",
      "am": "አምላክህን ለመገናኘት ተዘጋጅ"
    },
    "AMO.5.1.s1": {
      "en": "A lament for Israel",
      "sw": "Maombolezo kwa ajili ya Israeli",
      "am": "ለእስራኤል የሚደረግ ሙሾ"
    },
    "AMO.5.4.s1": {
      "en": "Seek {{divine_name:the LORD|Yahweh}} and live",
      "sw": "Mtafuteni {{divine_name:BWANA|Yahwe}} mpate kuishi",
      "am": "{{divine_name:እግዚአብሔርን|ያህዌን}} ፈልጉ፤ በሕይወትም ኑሩ"
    },
    "AMO.5.16.s1": {
      "en": "Wailing in every street",
      "sw": "Kilio katika kila mtaa",
      "am": "በየመንገዱ ዋይታ"
    },
    "AMO.5.18.s1": {
      "en": "The day of {{divine_name:the LORD|Yahweh}}",
      "sw": "Siku ya {{divine_name:BWANA|Yahwe}}",
      "am": "{{divine_name:የእግዚአብሔር|የያህዌ}} ቀን"
    },
    "AMO.6.1.s1": {
      "en": "Woe to those at ease in Zion",
      "sw": "Ole wao wanaostarehe Sayuni",
      "am": "በጽዮን ተደላድለው ለሚኖሩ ወዮላቸው"
    },
    "AMO.6.8.s1": {
      "en": "The proud city handed over",
      "sw": "Mji wenye kiburi unatolewa",
      "am": "ትዕቢተኛዪቱ ከተማ ተላልፋ ተሰጠች"
    },
    "AMO.7.1.s1": {
      "en": "Locusts and fire",
      "sw": "Nzige na moto",
      "am": "አንበጣና እሳት"
    },
    "AMO.7.7.s1": {
      "en": "The plumb line",
      "sw": "Timazi",
      "am": "ቱንቢው"
    },
    "AMO.7.10.s1": {
      "en": "Amos and Amaziah",
      "sw": "Amosi na Amazia",
      "am": "አሞጽና አሜስያስ"
    },
    "AMO.8.1.s1": {
      "en": "A basket of summer fruit",
      "sw": "Kikapu cha matunda ya kiangazi",
      "am": "የበጋ ፍሬ ቅርጫት"
    },
    "AMO.8.4.s1": {
      "en": "Cheating the poor",
      "sw": "Kuwadanganya maskini",
      "am": "ድሆችን ማታለል"
    },
    "AMO.8.9.s1": {
      "en": "Darkness at noon and a famine of the word",
      "sw": "Giza wakati wa adhuhuri na njaa ya neno",
      "am": "በቀትር ጨለማና የቃል ራብ"
    },
    "AMO.9.1.s1": {
      "en": "The Lord beside the altar",
      "sw": "Bwana kando ya madhabahu",
      "am": "ጌታ በመሠዊያው አጠገብ"
    },
    "AMO.9.13.s1": {
      "en": "The days are coming",
      "sw": "Siku zinakuja",
      "am": "ቀኖች ይመጣሉ"
    }
  }
