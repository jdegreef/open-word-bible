    "GAL.1.1.s1": {
      "en": "Greeting",
      "sw": "Salamu",
      "am": "ሰላምታ"
    },
    "GAL.1.6.s1": {
      "en": "There is no other gospel",
      "sw": "Hakuna Injili nyingine",
      "am": "ሌላ ወንጌል የለም"
    },
    "GAL.1.11.s1": {
      "en": "Paul's gospel came from God, not from people",
      "sw": "Injili ya Paulo ilitoka kwa Mungu, si kwa wanadamu",
      "am": "የጳውሎስ ወንጌል ከሰው ሳይሆን ከእግዚአብሔር መጣ"
    },
    "GAL.1.18.s1": {
      "en": "Paul's first visit to Jerusalem",
      "sw": "Ziara ya kwanza ya Paulo Yerusalemu",
      "am": "ጳውሎስ ለመጀመሪያ ጊዜ ኢየሩሳሌምን ጎበኘ"
    },
    "GAL.2.1.s1": {
      "en": "The leaders in Jerusalem accept Paul",
      "sw": "Viongozi wa Yerusalemu wanampokea Paulo",
      "am": "የኢየሩሳሌም መሪዎች ጳውሎስን ተቀበሉ"
    },
    "GAL.2.11.s1": {
      "en": "Paul opposes Cephas at Antioch",
      "sw": "Paulo anampinga Kefa huko Antiokia",
      "am": "ጳውሎስ በአንጾኪያ ኬፋን ተቃወመ"
    },
    "GAL.3.1.s1": {
      "en": "Faith or works of the law?",
      "sw": "Imani au matendo ya sheria?",
      "am": "እምነት ወይስ የሕግ ሥራ?"
    },
    "GAL.3.7.s1": {
      "en": "Abraham's children by faith",
      "sw": "Watoto wa Abrahamu kwa imani",
      "am": "በእምነት የአብርሃም ልጆች"
    },
    "GAL.3.10.s1": {
      "en": "Christ set us free from the curse",
      "sw": "{{christos:Kristo|Masihi}} alituweka huru kutoka kwa laana",
      "am": "{{christos:ክርስቶስ|መሲሑ}} ከእርግማን ነጻ አወጣን"
    },
    "GAL.3.15.s1": {
      "en": "The law cannot cancel the promise",
      "sw": "Sheria haiwezi kufuta ahadi",
      "am": "ሕግ የተስፋውን ቃል ሊሽር አይችልም"
    },
    "GAL.3.19.s1": {
      "en": "Why the law was given",
      "sw": "Kwa nini sheria ilitolewa",
      "am": "ሕግ የተሰጠበት ምክንያት"
    },
    "GAL.3.23.s1": {
      "en": "No longer under a guardian",
      "sw": "Si chini ya mlezi tena",
      "am": "ከእንግዲህ ከሞግዚት በታች አይደለንም"
    },
    "GAL.4.1.s1": {
      "en": "No longer slaves but heirs",
      "sw": "Si watumwa tena bali warithi",
      "am": "ከእንግዲህ ባሪያዎች ሳይሆን ወራሾች"
    },
    "GAL.4.8.s1": {
      "en": "Why turn back to slavery?",
      "sw": "Kwa nini kurudi utumwani?",
      "am": "ወደ ባርነት ለምን ትመለሳላችሁ?"
    },
    "GAL.4.12.s1": {
      "en": "Paul pleads with the Galatians",
      "sw": "Paulo anawasihi Wagalatia",
      "am": "ጳውሎስ የገላትያን ሰዎች ተማጸነ"
    },
    "GAL.4.21.s1": {
      "en": "Hagar and Sarah: two covenants",
      "sw": "Hajiri na Sara: maagano mawili",
      "am": "አጋርና ሣራ፤ ሁለት ኪዳኖች"
    },
    "GAL.5.1.s1": {
      "en": "Stand firm in your freedom",
      "sw": "Simameni imara katika uhuru wenu",
      "am": "በነጻነታችሁ ጸንታችሁ ቁሙ"
    },
    "GAL.5.7.s1": {
      "en": "Who blocked your way?",
      "sw": "Ni nani aliyewazuia njia?",
      "am": "መንገዳችሁን የዘጋባችሁ ማን ነው?"
    },
    "GAL.5.13.s1": {
      "en": "Free to serve one another in love",
      "sw": "Huru kutumikiana kwa upendo",
      "am": "በፍቅር እርስ በርስ ለመገልገል ነጻ"
    },
    "GAL.5.16.s1": {
      "en": "Walk by the Spirit",
      "sw": "Enendeni kwa Roho",
      "am": "በመንፈስ ተመላለሱ"
    },
    "GAL.6.1.s1": {
      "en": "Carry one another's burdens",
      "sw": "Chukulianeni mizigo",
      "am": "አንዱ የሌላውን ሸክም ተሸከሙ"
    },
    "GAL.6.6.s1": {
      "en": "You will reap what you sow",
      "sw": "Mtavuna mlichopanda",
      "am": "የዘራችሁትን ታጭዳላችሁ"
    },
    "GAL.6.11.s1": {
      "en": "Paul's last words in his own hand",
      "sw": "Maneno ya mwisho ya Paulo kwa mkono wake mwenyewe",
      "am": "ጳውሎስ በገዛ እጁ የጻፈው የመጨረሻ ቃል"
    }
  }
}
