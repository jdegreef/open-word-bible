    "1TH.1.1.s1": {
      "en": "Greeting",
      "sw": "Salamu",
      "am": "ሰላምታ"
    },
    "1TH.1.2.s1": {
      "en": "Thanks for the Thessalonians' faith",
      "sw": "Shukrani kwa imani ya Wathesalonike",
      "am": "ስለ ተሰሎንቄ ሰዎች እምነት የቀረበ ምስጋና"
    },
    "1TH.2.1.s1": {
      "en": "Paul's work among them",
      "sw": "Kazi ya Paulo kati yao",
      "am": "ጳውሎስ በመካከላቸው የሠራው ሥራ"
    },
    "1TH.2.13.s1": {
      "en": "They received God's own word",
      "sw": "Walipokea neno la Mungu mwenyewe",
      "am": "የእግዚአብሔርን ቃል ራሱን ተቀበሉ"
    },
    "1TH.2.17.s1": {
      "en": "Paul longs to see them",
      "sw": "Paulo anatamani kuwaona",
      "am": "ጳውሎስ ሊያያቸው ናፈቀ"
    },
    "1TH.3.1.s1": {
      "en": "Timothy sent to strengthen them",
      "sw": "Timotheo anatumwa kuwaimarisha",
      "am": "ጢሞቴዎስ እንዲያጸናቸው ተላከ"
    },
    "1TH.3.6.s1": {
      "en": "Timothy's good news",
      "sw": "Habari njema za Timotheo",
      "am": "ጢሞቴዎስ ያመጣው መልካም ዜና"
    },
    "1TH.4.1.s1": {
      "en": "A life that pleases God",
      "sw": "Maisha yanayompendeza Mungu",
      "am": "እግዚአብሔርን ደስ የሚያሰኝ ሕይወት"
    },
    "1TH.4.9.s1": {
      "en": "Love and quiet work",
      "sw": "Upendo na kazi ya utulivu",
      "am": "ፍቅርና በጸጥታ መሥራት"
    },
    "1TH.4.13.s1": {
      "en": "Those who have fallen asleep",
      "sw": "Wale waliolala",
      "am": "ያንቀላፉት"
    },
    "1TH.5.1.s1": {
      "en": "The Lord's day comes like a thief",
      "sw": "Siku ya Bwana inakuja kama mwizi",
      "am": "የጌታ ቀን እንደ ሌባ ይመጣል"
    },
    "1TH.5.12.s1": {
      "en": "Final instructions",
      "sw": "Maagizo ya mwisho",
      "am": "የመጨረሻ መመሪያዎች"
    },
    "1TH.5.23.s1": {
      "en": "Blessing and farewell",
      "sw": "Baraka na kuagana",
      "am": "በረከትና ስንብት"
