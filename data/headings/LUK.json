    "LUK.11.1.s1": {
      "en": "Lord, teach us to pray",
      "sw": "Bwana, tufundishe kuomba",
      "am": "ጌታ ሆይ፣ መጸለይን አስተምረን"
    },
    "LUK.11.5.s1": {
      "en": "The friend at midnight",
      "sw": "Rafiki usiku wa manane",
      "am": "በእኩለ ሌሊት የመጣ ወዳጅ"
    },
    "LUK.11.9.s1": {
      "en": "Ask, search, knock",
      "sw": "Ombeni, tafuteni, bisheni",
      "am": "ለምኑ፣ ፈልጉ፣ አንኳኩ"
    },
    "LUK.11.14.s1": {
      "en": "By the finger of God",
      "sw": "Kwa kidole cha Mungu",
      "am": "በእግዚአብሔር ጣት"
    },
    "LUK.11.24.s1": {
      "en": "The unclean spirit returns",
      "sw": "Pepo mchafu anarudi",
      "am": "ርኩስ መንፈስ ተመለሰ"
    },
    "LUK.11.27.s1": {
      "en": "Hearing and keeping God's word",
      "sw": "Kulisikia na kulishika neno la Mungu",
      "am": "የእግዚአብሔርን ቃል መስማትና መጠበቅ"
    },
    "LUK.11.29.s1": {
      "en": "Something greater than Jonah",
      "sw": "Aliye mkuu kuliko Yona",
      "am": "ከዮናስ የሚበልጥ"
    },
    "LUK.11.33.s1": {
      "en": "Light within",
      "sw": "Nuru iliyo ndani",
      "am": "በውስጥ ያለ ብርሃን"
    },
    "LUK.11.37.s1": {
      "en": "The inside of the cup",
      "sw": "Ndani ya kikombe",
      "am": "የጽዋው ውስጥ"
    },
    "LUK.11.42.s1": {
      "en": "How terrible for you",
      "sw": "Ole wenu",
      "am": "ወዮላችሁ"
    },
    "LUK.11.45.s1": {
      "en": "Loads too heavy to carry",
      "sw": "Mizigo mizito mno kubeba",
      "am": "ለመሸከም የሚከብድ ሸክም"
    },
    "LUK.12.1.s1": {
      "en": "The leaven of the Pharisees",
      "sw": "Chachu ya Mafarisayo",
      "am": "የፈሪሳውያን እርሾ"
    },
    "LUK.12.4.s1": {
      "en": "The one to fear",
      "sw": "Yule mnayepaswa kumwogopa",
      "am": "ልትፈሩት የሚገባው"
    },
    "LUK.12.13.s1": {
      "en": "A rich man and his barns",
      "sw": "Tajiri na ghala zake",
      "am": "ሀብታሙ ሰውና ጎተራዎቹ"
    },
    "LUK.12.22.s1": {
      "en": "Life is more than food",
      "sw": "Uhai ni zaidi ya chakula",
      "am": "ሕይወት ከምግብ ይበልጣል"
    },
    "LUK.12.35.s1": {
      "en": "Servants waiting for their master",
      "sw": "Watumishi wanaomngoja bwana wao",
      "am": "ጌታቸውን የሚጠባበቁ ባሪያዎች"
    },
    "LUK.12.49.s1": {
      "en": "Fire on the earth",
      "sw": "Moto duniani",
      "am": "በምድር ላይ እሳት"
    },
    "LUK.12.54.s1": {
      "en": "Reading the time",
      "sw": "Kutambua nyakati",
      "am": "ዘመኑን ማስተዋል"
    },
    "LUK.13.1.s1": {
      "en": "Unless you repent",
      "sw": "Msipotubu",
      "am": "ንስሓ ካልገባችሁ"
    },
    "LUK.13.6.s1": {
      "en": "A fig tree with no fruit",
      "sw": "Mtini usiozaa matunda",
      "am": "ፍሬ የሌላት በለስ"
    },
    "LUK.13.10.s1": {
      "en": "A daughter of Abraham set free",
      "sw": "Binti wa Abrahamu anawekwa huru",
      "am": "የአብርሃም ልጅ ነጻ ወጣች"
    },
    "LUK.13.18.s1": {
      "en": "Like a mustard seed, like yeast",
      "sw": "Kama mbegu ya haradali, kama chachu",
      "am": "እንደ ሰናፍጭ ቅንጣት፣ እንደ እርሾ"
    },
    "LUK.13.22.s1": {
      "en": "Strive to enter",
      "sw": "Jitahidini kuingia",
      "am": "ለመግባት ተጋደሉ"
    },
    "LUK.13.31.s1": {
      "en": "A message for Herod",
      "sw": "Ujumbe kwa Herode",
      "am": "ለሄሮድስ የተላከ መልእክት"
    },
    "LUK.14.1.s1": {
      "en": "A Sabbath meal and a man with dropsy",
      "sw": "Chakula cha Sabato na mtu mwenye istiska",
      "am": "የሰንበት ማዕድና የውኃ እብጠት የያዘው ሰው"
    },
    "LUK.14.7.s1": {
      "en": "Taking the lowest place",
      "sw": "Kuchukua nafasi ya chini kabisa",
      "am": "የመጨረሻውን ስፍራ መያዝ"
    },
    "LUK.14.12.s1": {
      "en": "Guests who cannot repay",
      "sw": "Wageni wasioweza kulipa",
      "am": "ብድር መመለስ የማይችሉ እንግዶች"
    },
    "LUK.14.15.s1": {
      "en": "The dinner the guests refused",
      "sw": "Karamu ambayo wageni waliikataa",
      "am": "እንግዶቹ እምቢ ያሉት ግብዣ"
    },
    "LUK.14.25.s1": {
      "en": "Counting the cost of following",
      "sw": "Kuhesabu gharama ya kufuata",
      "am": "የመከተልን ዋጋ ማስላት"
    },
    "LUK.14.34.s1": {
      "en": "Salt that loses its taste",
      "sw": "Chumvi inayopoteza ladha yake",
      "am": "ጣዕሙን የሚያጣ ጨው"
    },
    "LUK.15.1.s1": {
      "en": "One sheep out of a hundred",
      "sw": "Kondoo mmoja kati ya mia",
      "am": "ከመቶ በጎች አንዱ"
    },
    "LUK.15.8.s1": {
      "en": "A coin swept for and found",
      "sw": "Sarafu iliyotafutwa na kupatikana",
      "am": "ተፈልጎ የተገኘ ሳንቲም"
    },
    "LUK.15.11.s1": {
      "en": "A father and his two sons",
      "sw": "Baba na wanawe wawili",
      "am": "አንድ አባትና ሁለቱ ልጆቹ"
    },
    "LUK.15.25.s1": {
      "en": "The older son",
      "sw": "Mwana mkubwa",
      "am": "ታላቁ ልጅ"
    },
    "LUK.16.1.s1": {
      "en": "A manager who acted shrewdly",
      "sw": "Msimamizi aliyetenda kwa werevu",
      "am": "በብልሃት የሠራው መጋቢ"
    },
    "LUK.16.14.s1": {
      "en": "Lovers of money",
      "sw": "Wapenda fedha",
      "am": "ገንዘብ ወዳጆች"
    },
    "LUK.16.19.s1": {
      "en": "A rich man and a poor man named Lazarus",
      "sw": "Tajiri na maskini aitwaye Lazaro",
      "am": "ሀብታሙ ሰውና አልዓዛር የተባለው ድሀ"
    },
    "LUK.17.1.s1": {
      "en": "Stumbling, forgiveness and faith",
      "sw": "Kukwaza, msamaha na imani",
      "am": "ማሰናከል፣ ይቅርታና እምነት"
    },
    "LUK.17.7.s1": {
      "en": "Servants who only did their duty",
      "sw": "Watumishi waliofanya wajibu wao tu",
      "am": "ግዴታቸውን ብቻ የፈጸሙ ባሪያዎች"
    },
    "LUK.17.11.s1": {
      "en": "Ten healed, one returns",
      "sw": "Kumi wanaponywa, mmoja anarudi",
      "am": "ዐሥሩ ተፈወሱ፤ አንዱ ተመለሰ"
    },
    "LUK.17.20.s1": {
      "en": "Where the kingdom of God is",
      "sw": "Ufalme wa Mungu uko wapi",
      "am": "የእግዚአብሔር መንግሥት የት ናት"
    },
    "LUK.17.22.s1": {
      "en": "The day the Son of Man is revealed",
      "sw": "Siku Mwana wa Adamu atakapofunuliwa",
      "am": "የሰው ልጅ የሚገለጥበት ቀን"
    },
    "LUK.18.1.s1": {
      "en": "A widow who kept coming",
      "sw": "Mjane aliyeendelea kuja",
      "am": "ደጋግማ የመጣችው መበለት"
    },
    "LUK.18.15.s1": {
      "en": "Children and the kingdom",
      "sw": "Watoto na ufalme",
      "am": "ሕፃናትና መንግሥቱ"
    },
    "LUK.18.18.s1": {
      "en": "A rich leader's question",
      "sw": "Swali la kiongozi tajiri",
      "am": "የአንድ ሀብታም አለቃ ጥያቄ"
    },
    "LUK.18.31.s1": {
      "en": "Going up to Jerusalem",
      "sw": "Kupanda Yerusalemu",
      "am": "ወደ ኢየሩሳሌም መውጣት"
    },
    "LUK.18.35.s1": {
      "en": "A blind man at Jericho sees",
      "sw": "Kipofu wa Yeriko anaona",
      "am": "በኢያሪኮ የነበረው ዓይነ ስውር አየ"
    },
    "LUK.19.1.s1": {
      "en": "Zacchaeus climbs a tree",
      "sw": "Zakayo anapanda mti",
      "am": "ዘኬዎስ ዛፍ ላይ ወጣ"
    },
    "LUK.19.11.s1": {
      "en": "Ten servants and ten minas",
      "sw": "Watumishi kumi na mina kumi",
      "am": "ዐሥር ባሪያዎችና ዐሥር ምናን"
    },
    "LUK.19.28.s1": {
      "en": "The king comes riding on a colt",
      "sw": "Mfalme anakuja akipanda mwana-punda",
      "am": "ንጉሡ በውርንጫ ላይ ተቀምጦ መጣ"
    },
    "LUK.19.41.s1": {
      "en": "Jesus weeps over Jerusalem",
      "sw": "Yesu anaulilia Yerusalemu",
      "am": "ኢየሱስ ስለ ኢየሩሳሌም አለቀሰ"
    },
    "LUK.19.45.s1": {
      "en": "A house of prayer",
      "sw": "Nyumba ya sala",
      "am": "የጸሎት ቤት"
    },
    "LUK.20.1.s1": {
      "en": "A question about authority",
      "sw": "Swali kuhusu mamlaka",
      "am": "ስለ ሥልጣን የቀረበ ጥያቄ"
    },
    "LUK.20.9.s1": {
      "en": "The tenant farmers and the owner's son",
      "sw": "Wapangaji na mwana wa mwenye shamba",
      "am": "ተከራዮቹና የባለቤቱ ልጅ"
    },
    "LUK.20.20.s1": {
      "en": "Paying tribute to Caesar",
      "sw": "Kumlipa Kaisari kodi",
      "am": "ለቄሳር ግብር መክፈል"
    },
    "LUK.20.27.s1": {
      "en": "A question about the resurrection",
      "sw": "Swali kuhusu ufufuo",
      "am": "ስለ ትንሣኤ የቀረበ ጥያቄ"
    },
    "LUK.20.41.s1": {
      "en": "David's son and David's Lord",
      "sw": "Mwana wa Daudi na Bwana wa Daudi",
      "am": "የዳዊት ልጅና የዳዊት ጌታ"
    },
    "LUK.21.1.s1": {
      "en": "A poor widow's gift",
      "sw": "Sadaka ya mjane maskini",
      "am": "የድሀዋ መበለት ስጦታ"
    },
    "LUK.21.5.s1": {
      "en": "Not one stone on another",
      "sw": "Hakuna jiwe litakalobaki juu ya jiwe",
      "am": "ድንጋይ በድንጋይ ላይ አይቀርም"
    },
    "LUK.21.20.s1": {
      "en": "Jerusalem surrounded",
      "sw": "Yerusalemu imezungukwa",
      "am": "ኢየሩሳሌም ተከበበች"
    },
    "LUK.21.25.s1": {
      "en": "The Son of Man comes in a cloud",
      "sw": "Mwana wa Adamu anakuja katika wingu",
      "am": "የሰው ልጅ በደመና ይመጣል"
    },
    "LUK.21.29.s1": {
      "en": "Learn from the fig tree",
      "sw": "Jifunzeni kutoka kwa mtini",
      "am": "ከበለስ ተማሩ"
    },
    "LUK.21.34.s1": {
      "en": "Stay awake and pray",
      "sw": "Kesheni na kuomba",
      "am": "ንቁ፤ ጸልዩም"
    },
    "LUK.22.1.s1": {
      "en": "The leaders plot, and Judas joins them",
      "sw": "Viongozi wanapanga njama, na Yuda anajiunga nao",
      "am": "መሪዎቹ ሤራ ጠነሰሱ፤ ይሁዳም ተባበራቸው"
    },
    "LUK.22.7.s1": {
      "en": "Preparing the Passover",
      "sw": "Kuandaa Pasaka",
      "am": "ፋሲካን ማዘጋጀት"
    },
    "LUK.22.14.s1": {
      "en": "The Passover meal with the apostles",
      "sw": "Chakula cha Pasaka pamoja na mitume",
      "am": "ከሐዋርያት ጋር የተበላው የፋሲካ ራት"
    },
    "LUK.22.24.s1": {
      "en": "The greatest is the one who serves",
      "sw": "Aliye mkuu ni yule anayetumikia",
      "am": "ታላቁ የሚያገለግለው ነው"
    },
    "LUK.22.35.s1": {
      "en": "Purse, bag and sword",
      "sw": "Mfuko, mkoba na upanga",
      "am": "ኪስ፣ ከረጢትና ሰይፍ"
    },
    "LUK.22.39.s1": {
      "en": "Not my will but yours",
      "sw": "Si mapenzi {{deity_pronoun:yangu|Yangu}} bali {{deity_pronoun:yako|Yako}}",
      "am": "የእኔ ፈቃድ ሳይሆን የአንተ"
    },
    "LUK.22.47.s1": {
      "en": "Judas comes with a crowd",
      "sw": "Yuda anakuja pamoja na umati",
      "am": "ይሁዳ ከሕዝብ ጋር መጣ"
    },
    "LUK.22.54.s1": {
      "en": "Peter's three denials",
      "sw": "Petro anakana mara tatu",
      "am": "ጴጥሮስ ሦስት ጊዜ ካደ"
    },
    "LUK.22.63.s1": {
      "en": "Blindfolded and mocked",
      "sw": "Anafungwa macho na kudhihakiwa",
      "am": "ዓይኑን ሸፍነው አፌዙበት"
    },
    "LUK.22.66.s1": {
      "en": "Questioned by the council",
      "sw": "Anahojiwa na Baraza",
      "am": "በሸንጎው ፊት ተመረመረ"
    },
    "LUK.23.1.s1": {
      "en": "Jesus is brought to Pilate",
      "sw": "Yesu analetwa kwa Pilato",
      "am": "ኢየሱስ ወደ ጲላጦስ ቀረበ"
    },
    "LUK.23.18.s1": {
      "en": "The crowd asks for Barabbas",
      "sw": "Umati unaomba Baraba",
      "am": "ሕዝቡ በርባንን ጠየቀ"
    },
    "LUK.23.26.s1": {
      "en": "On the way to the Skull",
      "sw": "Njiani kwenda Fuvu",
      "am": "የራስ ቅል ወደሚባለው ስፍራ በሚወስደው መንገድ"
    },
    "LUK.23.39.s1": {
      "en": "The two criminals",
      "sw": "Wahalifu wawili",
      "am": "ሁለቱ ወንጀለኞች"
    },
    "LUK.23.44.s1": {
      "en": "Darkness at midday and Jesus' last words",
      "sw": "Giza adhuhuri na maneno ya mwisho ya Yesu",
      "am": "በቀትር የሆነው ጨለማና የኢየሱስ የመጨረሻ ቃል"
    },
    "LUK.23.50.s1": {
      "en": "Joseph lays Jesus in a tomb",
      "sw": "Yusufu anamlaza Yesu kaburini",
      "am": "ዮሴፍ ኢየሱስን በመቃብር አኖረው"
    },
    "LUK.24.13.s1": {
      "en": "Two disciples walk to Emmaus",
      "sw": "Wanafunzi wawili wanatembea kwenda Emau",
      "am": "ሁለት ደቀ መዛሙርት ወደ ኤማሁስ ሄዱ"
    },
    "LUK.24.36.s1": {
      "en": "Flesh and bones",
      "sw": "Nyama na mifupa",
      "am": "ሥጋና አጥንት"
    },
    "LUK.24.44.s1": {
