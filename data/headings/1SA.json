    "1SA.27.7.s1": {
      "en": "David raids from Ziklag",
      "sw": "Daudi anavamia kutoka Siklagi",
      "am": "ዳዊት ከጺቅላግ እየወጣ ወረራ አደረገ"
    },
    "1SA.28.3.s1": {
      "en": "Saul and the medium at Endor",
      "sw": "Sauli na mwanamke anayewaita wafu huko Endori",
      "am": "ሳኦልና በዓይንዶር የነበረችው ሙታን ጠሪ"
    },
    "1SA.28.15.s1": {
      "en": "Samuel's word to Saul",
      "sw": "Neno la Samweli kwa Sauli",
      "am": "ሳሙኤል ለሳኦል የተናገረው ቃል"
    },
    "1SA.29.1.s1": {
      "en": "The Philistine commanders send David back",
      "sw": "Makamanda wa Wafilisti wanamrudisha Daudi",
      "am": "የፍልስጥኤማውያን አለቆች ዳዊትን መለሱት"
    },
    "1SA.30.1.s1": {
      "en": "The Amalekites raid Ziklag",
      "sw": "Waamaleki wanavamia Siklagi",
      "am": "አማሌቃውያን ጺቅላግን ወረሩ"
    },
    "1SA.30.7.s1": {
      "en": "David pursues the raiders",
      "sw": "Daudi anawafuatia wavamizi",
      "am": "ዳዊት ወራሪዎቹን አሳደደ"
    },
    "1SA.30.22.s1": {
      "en": "Equal shares for those who stayed behind",
      "sw": "Mafungu sawa kwa waliobaki nyuma",
      "am": "ወደ ኋላ ለቀሩት እኩል ድርሻ"
    },
    "1SA.30.26.s1": {
      "en": "Gifts to the elders of Judah",
      "sw": "Zawadi kwa wazee wa Yuda",
      "am": "ለይሁዳ ሽማግሌዎች የተላከ ስጦታ"
    },
    "1SA.31.1.s1": {
      "en": "Saul and his sons fall on Mount Gilboa",
      "sw": "Sauli na wanawe wanaanguka juu ya Mlima Gilboa",
      "am": "ሳኦልና ልጆቹ በጊልቦዓ ተራራ ላይ ወደቁ"
    },
    "1SA.31.8.s1": {
      "en": "The men of Jabesh-gilead honor Saul",
      "sw": "Watu wa Yabeshi-gileadi wanamheshimu Sauli",
      "am": "የኢያቢስ ገለዓድ ሰዎች ሳኦልን አከበሩ"
    }
  }
}
