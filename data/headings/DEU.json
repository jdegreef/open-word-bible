      "en": "Curses for not obeying",
      "sw": "Laana kwa kutotii",
      "am": "ላለመታዘዝ የሚመጣ እርግማን"
    },
    "DEU.28.69.s1": {
      "en": "The covenant in the land of Moab",
      "sw": "Agano katika nchi ya Moabu",
      "am": "በሞዓብ ምድር የተገባ ቃል ኪዳን"
    },
    "DEU.29.9.s1": {
      "en": "Standing today before {{divine_name:the LORD|Yahweh}}",
      "sw": "Kusimama leo mbele za {{divine_name:BWANA|Yahwe}}",
      "am": "ዛሬ {{divine_name:በእግዚአብሔር|በያህዌ}} ፊት መቆም"
    },
    "DEU.30.1.s1": {
      "en": "Turning back to {{divine_name:the LORD|Yahweh}}",
      "sw": "Kumrudia {{divine_name:BWANA|Yahwe}}",
      "am": "ወደ {{divine_name:እግዚአብሔር|ያህዌ}} መመለስ"
    },
    "DEU.30.11.s1": {
      "en": "The word is very near you",
      "sw": "Neno liko karibu sana nawe",
      "am": "ቃሉ ለአንተ እጅግ ቅርብ ነው"
    },
    "DEU.30.15.s1": {
      "en": "Life and good, death and harm",
      "sw": "Uzima na mema, kifo na mabaya",
      "am": "ሕይወትና መልካም፣ ሞትና ክፉ"
    },
    "DEU.31.1.s1": {
      "en": "Joshua to go before the people",
      "sw": "Yoshua atawatangulia watu",
      "am": "ኢያሱ ሕዝቡን ይመራል"
    },
    "DEU.31.14.s1": {
      "en": "Joshua commissioned at the tent of meeting",
      "sw": "Yoshua anapewa jukumu katika Hema la Kukutania",
      "am": "ኢያሱ በመገናኛው ድንኳን ኃላፊነት ተሰጠው"
    },
    "DEU.31.16.s1": {
      "en": "Write down this song",
      "sw": "Uandike wimbo huu",
      "am": "ይህን መዝሙር ጻፉ"
    },
    "DEU.32.1.s1": {
      "en": "The song of Moses",
      "sw": "Wimbo wa Musa",
      "am": "የሙሴ መዝሙር"
    },
    "DEU.32.44.s1": {
      "en": "It is your very life",
      "sw": "Ni uzima wenu wenyewe",
      "am": "ሕይወታችሁ ነው"
    },
    "DEU.32.48.s1": {
      "en": "Moses to die on Mount Nebo",
      "sw": "Musa atakufa juu ya Mlima Nebo",
      "am": "ሙሴ በናባው ተራራ ላይ ይሞታል"
    },
    "DEU.33.1.s1": {
      "en": "Moses blesses the tribes",
      "sw": "Musa anayabariki makabila",
      "am": "ሙሴ ነገዶቹን ባረከ"
    },
    "DEU.33.13.s1": {
      "en": "The blessing of Joseph",
      "sw": "Baraka ya Yusufu",
      "am": "የዮሴፍ በረከት"
    },
    "DEU.33.18.s1": {
      "en": "Zebulun, Issachar, Gad, Dan and Asher",
      "sw": "Zabuloni, Isakari, Gadi, Dani na Asheri",
      "am": "ዛብሎን፣ ይሳኮር፣ ጋድ፣ ዳንና አሴር"
    },
    "DEU.34.1.s1": {
      "en": "The death of Moses",
      "sw": "Kifo cha Musa",
      "am": "የሙሴ ሞት"
    }
  }
}
