      "am": "ከተማን መውጋት",
      "vi": "Tấn công một thành",
      "ko": "성읍을 공격할 때"
    },
    "DEU.21.1.s1": {
      "en": "When someone is found slain",
      "sw": "Mtu anapopatikana ameuawa",
      "am": "ተገድሎ የተገኘ ሰው",
      "vi": "Khi tìm thấy một người bị giết",
      "ko": "살해된 사람이 발견되었을 때"
    },
    "DEU.21.10.s1": {
      "en": "Women taken captive",
      "sw": "Wanawake waliotekwa",
      "am": "የተማረኩ ሴቶች",
      "vi": "Phụ nữ bị bắt làm tù binh",
      "ko": "포로로 잡혀 온 여자"
    },
    "DEU.21.15.s1": {
      "en": "The right of the firstborn",
      "sw": "Haki ya mzaliwa wa kwanza",
      "am": "የበኩር መብት",
      "vi": "Quyền của con trưởng",
      "ko": "맏아들의 권리"
    },
    "DEU.21.18.s1": {
      "en": "A stubborn and rebellious son",
      "sw": "Mwana mkaidi na mwasi",
      "am": "እልከኛና ዓመፀኛ ልጅ",
      "vi": "Đứa con ngang bướng và phản nghịch",
      "ko": "고집 세고 반항하는 아들"
    },
    "DEU.22.1.s1": {
      "en": "Your neighbor’s animals",
      "sw": "Wanyama wa jirani yako",
      "am": "የባልንጀራህ እንስሳት",
      "vi": "Súc vật của người lân cận",
      "ko": "이웃의 짐승"
    },
    "DEU.22.6.s1": {
      "en": "A bird’s nest by the road",
      "sw": "Kiota cha ndege kando ya njia",
      "am": "በመንገድ ዳር ያለ የወፍ ጎጆ",
      "vi": "Tổ chim bên đường",
      "ko": "길가의 새 둥지"
    },
    "DEU.22.9.s1": {
      "en": "Two kinds together",
      "sw": "Aina mbili pamoja",
      "am": "ሁለት ዓይነቶችን አንድ ላይ",
      "vi": "Hai loại lẫn với nhau",
      "ko": "두 가지를 섞지 말라"
    },
    "DEU.22.13.s1": {
      "en": "Charges against a bride",
      "sw": "Mashtaka dhidi ya bibi arusi",
      "am": "በሙሽራይቱ ላይ የቀረበ ክስ",
      "vi": "Lời buộc tội cô dâu",
      "ko": "신부에 대한 고발"
    },
    "DEU.22.22.s1": {
      "en": "A married or engaged woman",
      "sw": "Mwanamke aliyeolewa au aliyeposwa",
      "am": "ያገባች ወይም የታጨች ሴት",
      "vi": "Phụ nữ đã có chồng hoặc đã đính hôn",
      "ko": "남편이 있거나 약혼한 여자"
    },
    "DEU.23.2.s1": {
      "en": "The assembly of {{divine_name:the LORD|Yahweh}}",
      "sw": "Kusanyiko la {{divine_name:BWANA|Yahwe}}",
      "am": "{{divine_name:የእግዚአብሔር|የያህዌ}} ጉባኤ",
      "vi": "Hội của {{divine_name:CHÚA|Gia-vê}}",
      "ko": "{{divine_name:주|야훼}}의 총회"
    },
    "DEU.23.10.s1": {
      "en": "Keeping the camp holy",
      "sw": "Kuitunza kambi iwe takatifu",
      "am": "ሰፈሩን ቅዱስ አድርጎ መጠበቅ",
      "vi": "Giữ cho trại quân thánh khiết",
      "ko": "진을 거룩하게 지키라"
    },
    "DEU.23.16.s1": {
      "en": "An escaped slave",
      "sw": "Mtumwa aliyetoroka",
      "am": "ያመለጠ ባሪያ",
      "vi": "Nô lệ trốn thoát",
      "ko": "도망친 노예"
    },
    "DEU.23.22.s1": {
      "en": "Vows and a neighbor’s harvest",
      "sw": "Nadhiri na mavuno ya jirani",
      "am": "ስእለትና የባልንጀራ መከር",
      "vi": "Lời khấn nguyện và mùa màng của người lân cận",
      "ko": "서원과 이웃의 곡식"
    },
    "DEU.24.1.s1": {
      "en": "Divorce and remarriage",
      "sw": "Talaka na kuolewa tena",
      "am": "ፍቺና እንደ ገና ማግባት",
      "vi": "Ly dị và tái hôn",
      "ko": "이혼과 재혼"
    },
    "DEU.24.10.s1": {
      "en": "Pledges and wages",
      "sw": "Rehani na mishahara",
      "am": "መያዣና ደመወዝ",
      "vi": "Đồ cầm và tiền công",
      "ko": "담보물과 품삯"
    },
    "DEU.24.17.s1": {
      "en": "The outsider, the fatherless and the widow",
      "sw": "Mgeni, yatima na mjane",
      "am": "መጻተኛው፣ አባት የሌለውና መበለቲቱ",
      "vi": "Ngoại kiều, trẻ mồ côi và quả phụ",
      "ko": "나그네와 고아와 과부"
    },
    "DEU.25.1.s1": {
      "en": "No more than forty strokes",
      "sw": "Si zaidi ya mapigo arobaini",
      "am": "ከአርባ ግርፋት አይበልጥ",
      "vi": "Không quá bốn mươi roi",
      "ko": "마흔 대를 넘지 않게"
    },
    "DEU.25.5.s1": {
      "en": "A brother’s widow",
      "sw": "Mjane wa ndugu",
      "am": "የወንድም መበለት",
      "vi": "Vợ góa của anh em",
      "ko": "형제의 아내였던 과부"
    },
    "DEU.25.13.s1": {
      "en": "Honest weights and measures",
      "sw": "Mizani na vipimo vya haki",
      "am": "ትክክለኛ ሚዛንና መስፈሪያ",
      "vi": "Cân và đo lường trung thực",
      "ko": "정직한 저울과 되"
    },
    "DEU.25.17.s1": {
      "en": "Remember Amalek",
      "sw": "Kumbuka Amaleki",
      "am": "አማሌቅን አስታውስ",
      "vi": "Hãy nhớ A-ma-léc",
      "ko": "아말렉을 기억하라"
    },
    "DEU.26.1.s1": {
      "en": "The first fruits",
      "sw": "Malimbuko",
      "am": "በኩራት",
      "vi": "Hoa quả đầu mùa",
      "ko": "첫 열매"
    },
    "DEU.26.12.s1": {
      "en": "The tithe of the third year",
      "sw": "Zaka ya mwaka wa tatu",
      "am": "የሦስተኛው ዓመት አሥራት",
      "vi": "Phần mười của năm thứ ba",
      "ko": "셋째 해의 십분의 일"
    },
    "DEU.26.16.s1": {
      "en": "His treasured possession",
      "sw": "Hazina {{deity_pronoun:yake|Yake}} ya pekee",
      "am": "ውድ ሀብቱ",
      "vi": "Dân báu vật của {{deity_pronoun:ngài|Ngài}}",
      "ko": "그분의 소중한 보물"
    },
    "DEU.27.1.s1": {
      "en": "Stones and an altar on Mount Ebal",
      "sw": "Mawe na madhabahu juu ya Mlima Ebali",
      "am": "በጌባል ተራራ ላይ የሚቆሙ ድንጋዮችና መሠዊያ",
      "vi": "Đá và bàn thờ trên núi Ê-banh",
      "ko": "에발 산의 돌과 제단"
    },
    "DEU.27.9.s1": {
      "en": "Today you have become the people of {{divine_name:the LORD|Yahweh}}",
      "sw": "Leo mmekuwa watu wa {{divine_name:BWANA|Yahwe}}",
      "am": "ዛሬ {{divine_name:የእግዚአብሔር|የያህዌ}} ሕዝብ ሆናችኋል",
      "vi": "Hôm nay anh em đã trở thành dân của {{divine_name:CHÚA|Gia-vê}}",
      "ko": "오늘 너희는 {{divine_name:주|야훼}}의 백성이 되었다"
    },
    "DEU.27.11.s1": {
      "en": "The curses from Mount Ebal",
      "sw": "Laana kutoka Mlima Ebali",
      "am": "ከጌባል ተራራ የሚነገሩ እርግማኖች",
      "vi": "Những lời nguyền rủa từ núi Ê-banh",
      "ko": "에발 산에서 선포할 저주"
    },
    "DEU.28.1.s1": {
      "en": "Blessings for obeying",
      "sw": "Baraka kwa kutii",
      "am": "ለመታዘዝ የሚገኝ በረከት",
      "vi": "Phước lành cho sự vâng lời",
      "ko": "순종하면 받을 복"
    },
    "DEU.28.15.s1": {
      "en": "Curses for not obeying",
      "sw": "Laana kwa kutotii",
      "am": "ላለመታዘዝ የሚመጣ እርግማን",
      "vi": "Sự nguyền rủa cho sự bất tuân",
      "ko": "순종하지 않으면 받을 저주"
    },
    "DEU.28.69.s1": {
      "en": "The covenant in the land of Moab",
      "sw": "Agano katika nchi ya Moabu",
      "am": "በሞዓብ ምድር የተገባ ቃል ኪዳን",
      "vi": "Giao ước trong xứ Mô-áp",
      "ko": "모압 땅에서 맺은 언약"
    },
    "DEU.29.9.s1": {
      "en": "Standing today before {{divine_name:the LORD|Yahweh}}",
      "sw": "Kusimama leo mbele za {{divine_name:BWANA|Yahwe}}",
      "am": "ዛሬ {{divine_name:በእግዚአብሔር|በያህዌ}} ፊት መቆም",
      "vi": "Hôm nay đứng trước mặt {{divine_name:CHÚA|Gia-vê}}",
      "ko": "오늘 {{divine_name:주|야훼}} 앞에 서다"
    },
    "DEU.30.1.s1": {
      "en": "Turning back to {{divine_name:the LORD|Yahweh}}",
      "sw": "Kumrudia {{divine_name:BWANA|Yahwe}}",
      "am": "ወደ {{divine_name:እግዚአብሔር|ያህዌ}} መመለስ",
      "vi": "Quay trở về với {{divine_name:CHÚA|Gia-vê}}",
      "ko": "{{divine_name:주|야훼}}께로 돌아오다"
    },
    "DEU.30.11.s1": {
      "en": "The word is very near you",
      "sw": "Neno liko karibu sana nawe",
      "am": "ቃሉ ለአንተ እጅግ ቅርብ ነው",
      "vi": "Lời ấy rất gần anh em",
      "ko": "그 말씀은 너희에게 아주 가까이 있다"
    },
    "DEU.30.15.s1": {
      "en": "Life and good, death and harm",
      "sw": "Uzima na mema, kifo na mabaya",
      "am": "ሕይወትና መልካም፣ ሞትና ክፉ",
      "vi": "Sự sống và phước hạnh, sự chết và tai họa",
      "ko": "생명과 복, 죽음과 화"
    },
    "DEU.31.1.s1": {
      "en": "Joshua to go before the people",
      "sw": "Yoshua atawatangulia watu",
      "am": "ኢያሱ ሕዝቡን ይመራል",
      "vi": "Giô-suê sẽ đi trước dân chúng",
      "ko": "백성보다 앞서 갈 여호수아"
    },
    "DEU.31.14.s1": {
      "en": "Joshua commissioned at the tent of meeting",
      "sw": "Yoshua anapewa jukumu katika Hema la Kukutania",
      "am": "ኢያሱ በመገናኛው ድንኳን ኃላፊነት ተሰጠው",
      "vi": "Giô-suê được ủy nhiệm tại Lều Hội Kiến",
      "ko": "회막에서 임명받은 여호수아"
    },
    "DEU.31.16.s1": {
      "en": "Write down this song",
      "sw": "Uandike wimbo huu",
      "am": "ይህን መዝሙር ጻፉ",
      "vi": "Hãy chép bài ca này",
      "ko": "이 노래를 기록하라"
    },
    "DEU.32.1.s1": {
      "en": "The song of Moses",
      "sw": "Wimbo wa Musa",
      "am": "የሙሴ መዝሙር",
      "vi": "Bài ca của Môi-se",
      "ko": "모세의 노래"
    },
    "DEU.32.44.s1": {
      "en": "It is your very life",
      "sw": "Ni uzima wenu wenyewe",
      "am": "ሕይወታችሁ ነው",
      "vi": "Đó chính là sự sống của anh em",
      "ko": "이것이 바로 너희의 생명이다"
    },
    "DEU.32.48.s1": {
      "en": "Moses to die on Mount Nebo",
      "sw": "Musa atakufa juu ya Mlima Nebo",
      "am": "ሙሴ በናባው ተራራ ላይ ይሞታል",
      "vi": "Môi-se sẽ qua đời trên núi Nê-bô",
      "ko": "느보 산에서 죽을 모세"
    },
    "DEU.33.1.s1": {
      "en": "Moses blesses the tribes",
      "sw": "Musa anayabariki makabila",
      "am": "ሙሴ ነገዶቹን ባረከ",
      "vi": "Môi-se chúc phước cho các chi tộc",
      "ko": "지파들을 축복하는 모세"
    },
    "DEU.33.13.s1": {
      "en": "The blessing of Joseph",
      "sw": "Baraka ya Yusufu",
      "am": "የዮሴፍ በረከት",
      "vi": "Lời chúc phước cho Giô-sép",
      "ko": "요셉을 위한 축복"
    },
    "DEU.33.18.s1": {
      "en": "Zebulun, Issachar, Gad, Dan and Asher",
      "sw": "Zabuloni, Isakari, Gadi, Dani na Asheri",
      "am": "ዛብሎን፣ ይሳኮር፣ ጋድ፣ ዳንና አሴር",
      "vi": "Sa-bu-lôn, Y-sa-ca, Gát, Đan và A-se",
      "ko": "스불론, 잇사갈, 갓, 단, 아셀"
    },
    "DEU.34.1.s1": {
      "en": "The death of Moses",
      "sw": "Kifo cha Musa",
      "am": "የሙሴ ሞት",
      "vi": "Môi-se qua đời",
      "ko": "모세의 죽음"
    }
  }
}
