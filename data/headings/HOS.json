    "HOS.14.2.s1": {
      "en": "Return to {{divine_name:the LORD|Yahweh}}",
      "vi": "Hãy trở về cùng {{divine_name:CHÚA|Gia-vê}}",
      "ko": "{{divine_name:주|야훼}}께 돌아오너라"
