      "ko": "기브아에서 경보를 울려라"
    },
    "HOS.6.1.s1": {
      "en": "Come, let us return",
      "vi": "Hãy đến, chúng ta hãy trở về",
      "ko": "오라, 우리가 돌아가자"
    },
    "HOS.7.1.s1": {
