      "vi": "Khốn cho chúng",
      "ko": "그들에게 화가 있다"
    },
    "HOS.8.1.s1": {
      "en": "Sound the alarm",
      "vi": "Hãy báo động",
      "ko": "경보를 울려라"
    },
    "HOS.9.1.s1": {
      "en": "No joy at the harvest",
