  "headings": {
    "HOS.1.1.s1": {
      "en": "The word of {{divine_name:the LORD|Yahweh}} to Hosea",
      "sw": "Neno la {{divine_name:BWANA|Yahwe}} kwa Hosea",
      "am": "ወደ ሆሴዕ የመጣው {{divine_name:የእግዚአብሔር|የያህዌ}} ቃል"
    },
    "HOS.2.1.s1": {
      "en": "Children of the living God",
      "sw": "Watoto wa Mungu aliye hai",
      "am": "የሕያው አምላክ ልጆች"
    },
    "HOS.2.16.s1": {
      "en": "Led back into the wilderness",
      "sw": "Kuongozwa tena nyikani",
      "am": "ወደ ምድረ በዳ ተመልሶ መመራት"
    },
    "HOS.3.1.s1": {
      "en": "Go again and love",
      "sw": "Nenda tena ukapende",
      "am": "እንደ ገና ሂድና ውደድ"
    },
    "HOS.4.1.s1": {
      "en": "{{divine_name:The LORD|Yahweh}}'s case against Israel",
      "sw": "Mashtaka ya {{divine_name:BWANA|Yahwe}} dhidi ya Israeli",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} በእስራኤል ላይ ያቀረበው ክስ"
    },
    "HOS.5.1.s1": {
      "en": "A snare at Mizpah",
      "sw": "Mtego huko Mizpa",
      "am": "በምጽጳ ያለ ወጥመድ"
    },
    "HOS.5.8.s1": {
      "en": "Sound the alarm in Gibeah",
      "sw": "Pigeni baragumu huko Gibea",
      "am": "በጊብዓ መለከት ንፉ"
    },
    "HOS.6.1.s1": {
      "en": "Come, let us return",
      "sw": "Njooni, tumrudie",
      "am": "ኑ፤ እንመለስ"
    },
    "HOS.7.1.s1": {
      "en": "When I would heal Israel",
      "sw": "Nilipotaka kumponya Israeli",
      "am": "እስራኤልን ልፈውስ ስፈልግ"
    },
    "HOS.7.13.s1": {
      "en": "Woe to them",
      "sw": "Ole wao",
      "am": "ወዮላቸው"
    },
    "HOS.8.1.s1": {
      "en": "Sound the alarm",
      "sw": "Pigeni baragumu",
      "am": "መለከት ንፉ"
    },
    "HOS.9.1.s1": {
      "en": "No joy at the harvest",
      "sw": "Hakuna furaha wakati wa mavuno",
      "am": "በመከር ደስታ የለም"
    },
    "HOS.9.10.s1": {
      "en": "Grapes in the wilderness",
      "sw": "Zabibu nyikani",
      "am": "በምድረ በዳ ያለ ወይን"
    },
    "HOS.10.1.s1": {
      "en": "A spreading vine",
      "sw": "Mzabibu unaoenea",
      "am": "የተንሰራፋ የወይን ግንድ"
    },
    "HOS.10.9.s1": {
      "en": "Since the days of Gibeah",
      "sw": "Tangu siku za Gibea",
      "am": "ከጊብዓ ዘመን ጀምሮ"
    },
    "HOS.11.1.s1": {
      "en": "Out of Egypt I called my son",
      "sw": "Nilimwita mwana {{deity_pronoun:wangu|Wangu}} kutoka Misri",
      "am": "ልጄን ከግብፅ ጠራሁት"
    },
    "HOS.12.1.s1": {
      "en": "Surrounded with lies",
      "sw": "Kuzungukwa na uongo",
      "am": "በሐሰት መከበብ"
    },
    "HOS.13.1.s1": {
      "en": "Ephraim's idols",
      "sw": "Sanamu za Efraimu",
      "am": "የኤፍሬም ጣዖታት"
    },
    "HOS.14.1.s1": {
      "en": "Samaria's guilt",
      "sw": "Hatia ya Samaria",
      "am": "የሰማርያ በደል"
    },
    "HOS.14.2.s1": {
      "en": "Return to {{divine_name:the LORD|Yahweh}}",
      "sw": "Mrudieni {{divine_name:BWANA|Yahwe}}",
      "am": "ወደ {{divine_name:እግዚአብሔር|ያህዌ}} ተመለሱ"
    }
  }
