      "vi": "{{divine_name:CHÚA|Gia-vê}} kiện cáo Y-sơ-ra-ên",
      "ko": "{{divine_name:주|야훼}}께서 이스라엘을 고발하시다"
    },
    "HOS.5.1.s1": {
