{
  "description": "Section headings the reader shows above a paragraph, keyed by the record that opens it. They are editorial aids, not translation: they are not in the source, they are written from Open Word Bible's own wording, and they may use reader settings. Every heading is an AI draft until a named reviewer approves it.",
  "status": "ai_draft",
  "headings": {
    "ROM.1.1.s1": {
      "en": "Greeting",
      "sw": "Salamu",
      "am": "ሰላምታ"
    },
    "ROM.1.8.s1": {
      "en": "Paul longs to visit Rome",
      "sw": "Paulo anatamani kutembelea Roma",
      "am": "ጳውሎስ ሮምን ለመጎብኘት ናፈቀ"
    },
    "ROM.1.16.s1": {
      "en": "The power of the gospel",
      "sw": "Nguvu ya Injili",
      "am": "የወንጌል ኃይል"
    },
    "ROM.1.18.s1": {
      "en": "Humanity turns from the Creator",
      "sw": "Wanadamu wanamwacha Muumba",
      "am": "የሰው ልጆች ከፈጣሪ ዞር አሉ"
    },
    "ROM.2.1.s1": {
      "en": "God judges without favor",
      "sw": "Mungu anahukumu bila upendeleo",
      "am": "እግዚአብሔር ያለ አድልዎ ይፈርዳል"
    },
    "ROM.2.12.s1": {
      "en": "The law and those without it",
      "sw": "Sheria na wale wasio nayo",
      "am": "ሕጉና ሕግ የሌላቸው"
    },
    "ROM.2.17.s1": {
      "en": "Teaching others, not yourself",
      "sw": "Kuwafundisha wengine, si nafsi yako",
      "am": "ሌሎችን እያስተማሩ ራስን አለማስተማር"
    },
    "ROM.2.25.s1": {
      "en": "Circumcision of the heart",
      "sw": "Tohara ya moyo",
      "am": "የልብ መገረዝ"
    },
    "ROM.3.1.s1": {
      "en": "God is faithful",
      "sw": "Mungu ni mwaminifu",
      "am": "እግዚአብሔር ታማኝ ነው"
    },
    "ROM.3.9.s1": {
      "en": "No one is righteous",
      "sw": "Hakuna mwenye haki",
      "am": "ጻድቅ የለም"
    },
    "ROM.3.21.s1": {
      "en": "God's righteousness through faith",
      "sw": "Haki ya Mungu kwa njia ya imani",
      "am": "በእምነት የሚገኘው የእግዚአብሔር ጽድቅ"
    },
    "ROM.3.27.s1": {
      "en": "No room for boasting",
      "sw": "Hakuna nafasi ya kujivuna",
      "am": "የመመካት ስፍራ የለም"
    },
    "ROM.4.1.s1": {
      "en": "Abraham counted righteous by faith",
      "sw": "Abrahamu anahesabiwa haki kwa imani",
      "am": "አብርሃም በእምነት ጻድቅ ተብሎ ተቈጠረ"
    },
    "ROM.4.13.s1": {
      "en": "The promise comes through faith",
      "sw": "Ahadi inakuja kwa njia ya imani",
      "am": "የተስፋው ቃል በእምነት ይመጣል"
    },
    "ROM.4.16.s1": {
      "en": "Abraham, the father of us all",
      "sw": "Abrahamu, baba yetu sote",
      "am": "የሁላችን አባት አብርሃም"
    },
    "ROM.4.23.s1": {
      "en": "Written for us too",
      "sw": "Imeandikwa kwa ajili yetu pia",
      "am": "ለእኛም ደግሞ ተጻፈ"
    },
    "ROM.5.1.s1": {
      "en": "At peace with God through faith",
      "sw": "Amani na Mungu kwa njia ya imani",
      "am": "በእምነት ከእግዚአብሔር ጋር ሰላም"
    },
    "ROM.5.6.s1": {
      "en": "God's love shown while we were sinners",
      "sw": "Upendo wa Mungu unaonyeshwa tulipokuwa bado wenye dhambi",
      "am": "ገና ኃጢአተኞች ሳለን የተገለጠው የእግዚአብሔር ፍቅር"
    },
    "ROM.5.12.s1": {
      "en": "Through one man sin, through one man grace",
      "sw": "Kwa mtu mmoja dhambi, kwa mtu mmoja neema",
      "am": "በአንድ ሰው ኃጢአት፣ በአንድ ሰው ጸጋ"
    },
    "ROM.6.1.s1": {
      "en": "Dead to sin, alive to God",
      "sw": "Wafu kwa dhambi, hai kwa Mungu",
      "am": "ለኃጢአት ሙታን፣ ለእግዚአብሔር ሕያዋን"
    },
    "ROM.6.15.s1": {
      "en": "Slaves of righteousness",
      "sw": "Watumwa wa haki",
      "am": "የጽድቅ ባሪያዎች"
    },
    "ROM.7.1.s1": {
      "en": "Free from the law",
      "sw": "Huru kutoka kwa sheria",
      "am": "ከሕግ ነጻ"
    },
    "ROM.7.7.s1": {
      "en": "The law and sin",
      "sw": "Sheria na dhambi",
      "am": "ሕግና ኃጢአት"
    },
    "ROM.7.14.s1": {
      "en": "Wanting the good, not doing it",
      "sw": "Kutaka mema, bila kuyatenda",
      "am": "መልካሙን መፈለግ፣ አለማድረግ"
    },
    "ROM.8.1.s1": {
      "en": "Set free by the Spirit of life",
      "sw": "Huru kwa Roho wa uzima",
      "am": "በሕይወት መንፈስ ነጻ የወጡ"
    },
    "ROM.8.12.s1": {
      "en": "God's children by the Spirit",
      "sw": "Watoto wa Mungu kwa Roho",
      "am": "በመንፈስ የእግዚአብሔር ልጆች"
    },
    "ROM.8.18.s1": {
      "en": "Creation waits to be set free",
      "sw": "Uumbaji unangoja kuwekwa huru",
      "am": "ፍጥረት ነጻ ለመውጣት ይጠባበቃል"
    },
    "ROM.8.26.s1": {
      "en": "The Spirit pleads for us",
      "sw": "Roho anatuombea",
      "am": "መንፈስ ስለ እኛ ይማልዳል"
    },
    "ROM.8.28.s1": {
      "en": "Called according to God's purpose",
      "sw": "Walioitwa kwa kusudi la Mungu",
      "am": "እንደ እግዚአብሔር ዓላማ የተጠሩ"
    },
    "ROM.8.31.s1": {
      "en": "If God is on our side",
      "sw": "Ikiwa Mungu yuko upande wetu",
      "am": "እግዚአብሔር ከእኛ ጋር ከሆነ"
    },
    "ROM.9.1.s1": {
      "en": "Paul's grief for Israel",
      "sw": "Huzuni ya Paulo kwa ajili ya Israeli",
      "am": "ጳውሎስ ስለ እስራኤል ያዘነው ኀዘን"
    },
    "ROM.9.6.s1": {
      "en": "God's word has not failed",
      "sw": "Neno la Mungu halijashindwa",
      "am": "የእግዚአብሔር ቃል አልወደቀም"
    },
    "ROM.9.14.s1": {
      "en": "Is God unjust?",
      "sw": "Je, Mungu si mwenye haki?",
      "am": "እግዚአብሔር ዐመፀኛ ነውን?"
    },
    "ROM.9.19.s1": {
      "en": "The potter and the clay",
      "sw": "Mfinyanzi na udongo",
      "am": "ሸክላ ሠሪውና ጭቃው"
    },
    "ROM.9.30.s1": {
      "en": "Israel and the stone of stumbling",
      "sw": "Israeli na jiwe la kujikwaa",
      "am": "እስራኤልና የማሰናከያ ድንጋይ"
    },
    "ROM.10.1.s1": {
      "en": "The righteousness that comes by faith",
      "sw": "Haki inayokuja kwa imani",
      "am": "በእምነት የሚገኘው ጽድቅ"
    },
    "ROM.10.14.s1": {
      "en": "How will they hear?",
      "sw": "Watasikiaje?",
      "am": "እንዴት ይሰማሉ?"
    },
    "ROM.10.18.s1": {
      "en": "Israel heard and refused",
      "sw": "Israeli walisikia wakakataa",
      "am": "እስራኤል ሰምተው እምቢ አሉ"
    },
    "ROM.11.1.s1": {
      "en": "The remnant of Israel",
      "sw": "Mabaki ya Israeli",
      "am": "የእስራኤል ቅሬታ"
    },
    "ROM.11.11.s1": {
      "en": "Israel's stumbling and the Gentiles' salvation",
      "sw": "Kujikwaa kwa Israeli na wokovu wa mataifa",
      "am": "የእስራኤል መሰናከልና የአሕዛብ መዳን"
    },
    "ROM.11.17.s1": {
      "en": "The olive tree and its branches",
      "sw": "Mzeituni na matawi yake",
      "am": "የወይራ ዛፉና ቅርንጫፎቹ"
    },
    "ROM.11.25.s1": {
      "en": "All Israel will be saved",
      "sw": "Israeli wote wataokolewa",
      "am": "እስራኤል ሁሉ ይድናሉ"
    },
    "ROM.11.33.s1": {
      "en": "Praise to God's wisdom",
      "sw": "Sifa kwa hekima ya Mungu",
      "am": "ለእግዚአብሔር ጥበብ የቀረበ ምስጋና"
    },
    "ROM.12.1.s1": {
      "en": "A living sacrifice",
      "sw": "Dhabihu iliyo hai",
      "am": "ሕያው መሥዋዕት"
    },
    "ROM.12.3.s1": {
      "en": "One body, many gifts",
      "sw": "Mwili mmoja, karama nyingi",
      "am": "አንድ አካል፣ ብዙ ስጦታዎች"
    },
    "ROM.12.9.s1": {
      "en": "Love without pretense",
      "sw": "Upendo usio na unafiki",
      "am": "ግብዝነት የሌለበት ፍቅር"
    },
    "ROM.13.1.s1": {
      "en": "Living under governing authorities",
      "sw": "Kuishi chini ya wenye mamlaka wanaotawala",
      "am": "ለሚያስተዳድሩ ባለ ሥልጣናት ተገዝቶ መኖር"
    },
    "ROM.13.8.s1": {
      "en": "Love fulfills the law",
      "sw": "Upendo unatimiza sheria",
      "am": "ፍቅር ሕግን ይፈጽማል"
    },
    "ROM.13.11.s1": {
      "en": "The day is near",
      "sw": "Siku imekaribia",
      "am": "ቀኑ ቀርቧል"
    },
    "ROM.14.1.s1": {
      "en": "The weak and the strong",
      "sw": "Wanyonge na wenye nguvu",
      "am": "ደካሞችና ብርቱዎች"
    },
    "ROM.14.10.s1": {
      "en": "We will all stand before God",
      "sw": "Sote tutasimama mbele ya Mungu",
      "am": "ሁላችን በእግዚአብሔር ፊት እንቆማለን"
    },
    "ROM.14.13.s1": {
      "en": "Do not make another believer stumble",
      "sw": "Msimfanye mwamini mwingine ajikwae",
      "am": "ሌላውን አማኝ አታሰናክሉ"
    },
    "ROM.15.1.s1": {
      "en": "Bearing with the weak, as Christ did",
      "sw": "Kuwachukulia wanyonge, kama {{christos:Kristo|Masihi}} alivyofanya",
      "am": "{{christos:ክርስቶስ|መሲሑ}} እንዳደረገው ደካሞችን መታገሥ"
    },
    "ROM.15.7.s1": {
      "en": "The Gentiles glorify God for his mercy",
      "sw": "Mataifa wanamtukuza Mungu kwa rehema {{deity_pronoun:yake|Yake}}",
      "am": "አሕዛብ ስለ ምሕረቱ እግዚአብሔርን አከበሩ"
    },
    "ROM.15.14.s1": {
      "en": "Paul's work as a minister to the Gentiles",
      "sw": "Kazi ya Paulo kama mhudumu kwa mataifa",
      "am": "ጳውሎስ ለአሕዛብ አገልጋይ ሆኖ የሠራው ሥራ"
    },
    "ROM.15.22.s1": {
      "en": "Paul's plans: Jerusalem, Rome and Spain",
      "sw": "Mipango ya Paulo: Yerusalemu, Roma na Uhispania",
      "am": "የጳውሎስ ዕቅድ፤ ኢየሩሳሌም፣ ሮምና እስጳንያ"
    },
    "ROM.15.30.s1": {
      "en": "A request for prayer",
      "sw": "Ombi la kuombewa",
      "am": "የጸሎት ልመና"
    },
    "ROM.16.1.s1": {
      "en": "Paul commends Phoebe",
      "sw": "Paulo anampendekeza Fibi",
      "am": "ጳውሎስ ፌቤንን አደራ ሰጠ"
    },
    "ROM.16.3.s1": {
      "en": "Greetings to believers in Rome",
      "sw": "Salamu kwa waumini walioko Roma",
      "am": "በሮም ላሉ አማኞች የተላከ ሰላምታ"
    },
    "ROM.16.17.s1": {
      "en": "A warning against those who divide",
      "sw": "Onyo dhidi ya wanaoleta mafarakano",
      "am": "ከሚከፋፍሉ ሰዎች ተጠንቀቁ"
    },
    "ROM.16.21.s1": {
      "en": "Greetings from Paul's companions",
      "sw": "Salamu kutoka kwa wenzake Paulo",
      "am": "ከጳውሎስ ባልደረቦች የተላከ ሰላምታ"
    }
  }
}
