  "headings": {
    "PRO.1.1.s1": {
      "en": "The purpose of the proverbs",
      "sw": "Kusudi la mithali",
      "am": "የምሳሌዎቹ ዓላማ"
    },
    "PRO.1.8.s1": {
      "en": "Refuse the invitation of sinners",
      "sw": "Kataa mwaliko wa wenye dhambi",
      "am": "የኃጢአተኞችን ግብዣ እንቢ በል"
    },
    "PRO.1.20.s1": {
      "en": "Wisdom calls in the streets",
      "sw": "Hekima anaita barabarani",
      "am": "ጥበብ በመንገድ ላይ ትጣራለች"
    },
    "PRO.2.1.s1": {
      "en": "Wisdom is worth the search",
      "sw": "Hekima anastahili kutafutwa",
      "am": "ጥበብ ልትፈለግ የሚገባት ናት"
    },
    "PRO.3.1.s1": {
      "en": "Keep my teaching",
      "sw": "Shika mafundisho yangu",
      "am": "ትምህርቴን ጠብቅ"
    },
    "PRO.3.5.s1": {
      "en": "Trust God, not your own insight",
      "sw": "Mtumaini Mungu, si ufahamu wako mwenyewe",
      "am": "በራስህ ማስተዋል ሳይሆን በእግዚአብሔር ታመን"
    },
    "PRO.3.11.s1": {
      "en": "{{divine_name:The LORD|Yahweh}}'s discipline and the worth of wisdom",
      "sw": "Nidhamu ya {{divine_name:BWANA|Yahwe}} na thamani ya hekima",
      "am": "{{divine_name:የእግዚአብሔር|የያህዌ}} ተግሣጽና የጥበብ ዋጋ"
    },
    "PRO.3.19.s1": {
      "en": "Wisdom in creation and among neighbors",
      "sw": "Hekima katika uumbaji na kati ya majirani",
      "am": "ጥበብ በፍጥረትና በባልንጀሮች መካከል"
    },
    "PRO.4.1.s1": {
      "en": "Get wisdom at any cost",
      "sw": "Pata hekima kwa gharama yoyote",
      "am": "በማንኛውም ዋጋ ጥበብን አግኝ"
    },
    "PRO.4.20.s1": {
      "en": "Guard your heart",
      "sw": "Linda moyo wako",
      "am": "ልብህን ጠብቅ"
    },
    "PRO.5.1.s1": {
      "en": "The bitter end of adultery",
      "sw": "Mwisho mchungu wa uzinzi",
      "am": "የምንዝርና መራራ ፍጻሜ"
    },
    "PRO.5.7.s1": {
      "en": "Keep away from her door",
      "sw": "Kaa mbali na mlango wake",
      "am": "ከደጃፏ ራቅ"
    },
    "PRO.6.1.s1": {
      "en": "Get free from a rash pledge",
      "sw": "Jiokoe kutoka katika dhamana ya haraka",
      "am": "በችኮላ ከገባህበት ዋስትና ራስህን ነጻ አውጣ"
    },
    "PRO.6.6.s1": {
      "en": "Learn from the ant",
      "sw": "Jifunze kutoka kwa chungu",
      "am": "ከጉንዳን ተማር"
    },
    "PRO.6.12.s1": {
      "en": "The troublemaker",
      "sw": "Mfanya fujo",
      "am": "ችግር ፈጣሪው ሰው"
    },
    "PRO.6.16.s1": {
      "en": "Seven things {{divine_name:the LORD|Yahweh}} hates",
      "sw": "Mambo saba anayochukia {{divine_name:BWANA|Yahwe}}",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} የሚጠላቸው ሰባት ነገሮች"
    },
    "PRO.6.20.s1": {
      "en": "Another man's wife",
      "sw": "Mke wa mtu mwingine",
      "am": "የሌላ ሰው ሚስት"
    },
    "PRO.6.27.s1": {
      "en": "Playing with fire",
      "sw": "Kuchezea moto",
      "am": "በእሳት መጫወት"
    },
    "PRO.7.1.s1": {
      "en": "The young man and the adulteress",
      "sw": "Kijana na mwanamke mzinzi",
      "am": "ወጣቱና አመንዝራዪቱ ሴት"
    },
    "PRO.7.24.s1": {
      "en": "Her house is the road to death",
      "sw": "Nyumba yake ni njia ya kifo",
      "am": "ቤቷ የሞት መንገድ ነው"
    },
    "PRO.8.1.s1": {
      "en": "Wisdom calls to everyone",
      "sw": "Hekima anamwita kila mtu",
      "am": "ጥበብ ሁሉንም ትጣራለች"
    },
    "PRO.8.22.s1": {
      "en": "Wisdom at the creation",
      "sw": "Hekima wakati wa uumbaji",
      "am": "ጥበብ በፍጥረት ጊዜ"
    },
    "PRO.8.32.s1": {
      "en": "Listen and live",
      "sw": "Sikilizeni mkaishi",
      "am": "ስሙ፤ በሕይወትም ኑሩ"
    },
    "PRO.9.1.s1": {
      "en": "Wisdom's feast",
      "sw": "Karamu ya Hekima",
      "am": "የጥበብ ግብዣ"
    },
    "PRO.9.10.s1": {
      "en": "Wisdom and the woman Folly",
      "sw": "Hekima na mwanamke Upumbavu",
      "am": "ጥበብና ሞኝነት የተባለችው ሴት"
    },
    "PRO.10.1.s1": {
      "en": "The proverbs of Solomon",
      "sw": "Mithali za Sulemani",
      "am": "የሰሎሞን ምሳሌዎች"
    },
    "PRO.22.22.s1": {
      "en": "Thirty sayings of the wise",
      "sw": "Maneno thelathini ya wenye hekima",
      "am": "የጠቢባን ሠላሳ አባባሎች"
    },
    "PRO.24.23.s1": {
      "en": "More sayings of the wise",
      "sw": "Maneno mengine ya wenye hekima",
      "am": "ሌሎች የጠቢባን አባባሎች"
    },
    "PRO.25.1.s1": {
      "en": "Proverbs copied by Hezekiah's officials",
      "sw": "Mithali zilizonakiliwa na maafisa wa Hezekia",
      "am": "የሕዝቅያስ ሹማምንት የገለበጧቸው ምሳሌዎች"
    },
    "PRO.27.23.s1": {
      "en": "Look after your flocks",
      "sw": "Watunze makundi yako",
      "am": "መንጋዎችህን ተንከባከብ"
    },
    "PRO.30.1.s1": {
      "en": "The words of Agur",
      "sw": "Maneno ya Aguri",
      "am": "የአጉር አባባሎች"
    },
    "PRO.31.1.s1": {
      "en": "The words of King Lemuel",
      "sw": "Maneno ya Mfalme Lemueli",
      "am": "የንጉሥ ልሙኤል ቃሎች"
    },
    "PRO.31.10.s1": {
      "en": "The capable wife",
      "sw": "Mke hodari",
      "am": "ምግባረ መልካም ሚስት"
    }
  }
}
