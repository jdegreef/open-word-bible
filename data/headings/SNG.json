  "headings": {
    "SNG.1.1.s1": {
      "en": "The Song of Songs",
      "sw": "Wimbo wa Nyimbo",
      "am": "የመዝሙሮች መዝሙር"
    },
    "SNG.1.5.s1": {
      "en": "Dark and lovely",
      "sw": "Mweusi na mrembo",
      "am": "ጠይምና ውብ"
    },
    "SNG.1.9.s1": {
      "en": "The lovers praise each other",
      "sw": "Wapenzi wanasifiana",
      "am": "ፍቅረኞቹ እርስ በርሳቸው ይሞጋገሳሉ"
    },
    "SNG.1.15.s1": {
      "en": "How beautiful you are",
      "sw": "Jinsi ulivyo mzuri",
      "am": "ምንኛ ውብ ነሽ"
    },
    "SNG.2.1.s1": {
      "en": "A lily among thorns",
      "sw": "Yungiyungi katikati ya michongoma",
      "am": "በእሾኾች መካከል የሱሰን አበባ"
    },
    "SNG.2.8.s1": {
      "en": "Come away, my darling",
      "sw": "Njoo, mpenzi wangu",
      "am": "ወዳጄ ሆይ፣ ነዪ"
    },
    "SNG.2.14.s1": {
      "en": "My dove in the clefts of the rock",
      "sw": "Njiwa wangu katika mapango ya mwamba",
      "am": "በዓለት ንቃቃት ውስጥ ያለሽ ርግቤ"
    },
    "SNG.2.15.s1": {
      "en": "The little foxes",
      "sw": "Mbweha wadogo",
      "am": "ትናንሽ ቀበሮዎች"
    },
    "SNG.3.1.s1": {
      "en": "A search by night",
      "sw": "Kutafuta usiku",
      "am": "የሌሊት ፍለጋ"
    },
    "SNG.3.6.s1": {
      "en": "A procession from the wilderness",
      "sw": "Msafara kutoka jangwani",
      "am": "ከምድረ በዳ የሚመጣ ሰልፍ"
    },
    "SNG.4.1.s1": {
      "en": "He praises her beauty",
      "sw": "Anasifu uzuri wake",
      "am": "ውበቷን ያወድሳል"
    },
    "SNG.4.8.s1": {
      "en": "Come with me from Lebanon, my bride",
      "sw": "Njoo pamoja nami kutoka Lebanoni, bibi arusi wangu",
      "am": "ሙሽራዬ ሆይ፣ ከሊባኖስ ከእኔ ጋር ነዪ"
    },
    "SNG.4.12.s1": {
      "en": "A garden locked, a fountain sealed",
      "sw": "Bustani iliyofungwa, chemchemi iliyotiwa muhuri",
      "am": "የተቆለፈ የአትክልት ቦታ፣ የታተመ ምንጭ"
    },
    "SNG.5.1.s1": {
      "en": "I have come into my garden",
      "sw": "Nimeingia bustanini mwangu",
      "am": "ወደ አትክልቴ ገብቻለሁ"
    },
    "SNG.5.2.s1": {
      "en": "A knock at the door",
      "sw": "Kubisha mlangoni",
      "am": "በሩን ማንኳኳት"
    },
    "SNG.6.1.s1": {
      "en": "Where has your beloved gone?",
      "sw": "Mpendwa wako amekwenda wapi?",
      "am": "ውድሽ ወዴት ሄደ?"
    },
    "SNG.6.10.s1": {
      "en": "Like the dawn",
      "sw": "Kama mapambazuko",
      "am": "እንደ ንጋት"
    },
    "SNG.6.11.s1": {
      "en": "The grove of nut trees",
      "sw": "Shamba la miti ya jozi",
      "am": "የለውዝ ዛፎች ስፍራ"
    },
    "SNG.7.1.s1": {
      "en": "Come back, Shulammite",
      "sw": "Rudi, ewe Mshulami",
      "am": "ሱላማዊት ሆይ፣ ተመለሺ"
    },
    "SNG.7.12.s1": {
      "en": "She invites him to the fields",
      "sw": "Anamwalika mashambani",
      "am": "ወደ መስክ ትጋብዘዋለች"
    },
    "SNG.8.1.s1": {
      "en": "If only you were like a brother",
      "sw": "Laiti ungekuwa kama kaka",
      "am": "ምነው እንደ ወንድም በሆንክልኝ"
    },
    "SNG.8.5.s1": {
      "en": "Love as strong as death",
      "sw": "Upendo wenye nguvu kama kifo",
      "am": "እንደ ሞት የበረታ ፍቅር"
    },
    "SNG.8.8.s1": {
      "en": "Our little sister",
      "sw": "Dada yetu mdogo",
      "am": "ታናሽ እኅታችን"
    },
    "SNG.8.11.s1": {
      "en": "Solomon's vineyard and my own",
      "sw": "Shamba la mizabibu la Sulemani na langu mwenyewe",
      "am": "የሰሎሞን የወይን ቦታና የራሴ የወይን ቦታ"
    }
  }
}
