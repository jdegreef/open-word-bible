  "headings": {
    "ECC.1.1.s1": {
      "en": "Breath upon breath",
      "sw": "Pumzi juu ya pumzi",
      "am": "እስትንፋስ፣ ፍጹም እስትንፋስ"
    },
    "ECC.1.12.s1": {
      "en": "The Teacher searches out wisdom",
      "sw": "Mwalimu anachunguza hekima",
      "am": "መምህሩ ጥበብን መረመረ"
    },
    "ECC.2.1.s1": {
      "en": "Testing pleasure and great works",
      "sw": "Kujaribu anasa na kazi kubwa",
      "am": "ተድላንና ታላላቅ ሥራዎችን መፈተን"
    },
    "ECC.3.1.s1": {
      "en": "A time for everything",
      "sw": "Wakati kwa kila jambo",
      "am": "ለሁሉ ጊዜ አለው"
    },
    "ECC.3.9.s1": {
      "en": "The task God has given",
      "sw": "Kazi ambayo Mungu ametoa",
      "am": "እግዚአብሔር የሰጠው ሥራ"
    },
    "ECC.4.1.s1": {
      "en": "Tears with no one to comfort",
      "sw": "Machozi bila mfariji",
      "am": "አጽናኝ የሌለው እንባ"
    },
    "ECC.5.1.s1": {
      "en": "Let your words be few",
      "sw": "Maneno yako na yawe machache",
      "am": "ቃልህ ጥቂት ይሁን"
    },
    "ECC.6.1.s1": {
      "en": "Wealth without enjoyment",
      "sw": "Utajiri bila kuufurahia",
      "am": "ደስታ የሌለበት ሀብት"
    },
    "ECC.7.1.s1": {
      "en": "Better than",
      "sw": "Bora kuliko",
      "am": "የሚበልጡ ነገሮች"
    },
    "ECC.8.1.s1": {
      "en": "Wisdom before a king",
      "sw": "Hekima mbele ya mfalme",
      "am": "በንጉሥ ፊት ጥበብ"
    },
    "ECC.9.1.s1": {
      "en": "One fate for all",
      "sw": "Hatima moja kwa wote",
      "am": "ለሁሉም አንድ ዕጣ ፈንታ"
    },
    "ECC.9.11.s1": {
      "en": "Time and chance",
      "sw": "Majira na matukio",
      "am": "ጊዜና አጋጣሚ"
    },
    "ECC.10.1.s1": {
      "en": "A little folly",
      "sw": "Upumbavu kidogo",
      "am": "ጥቂት ሞኝነት"
    },
    "ECC.11.1.s1": {
      "en": "Send your bread on the waters",
      "sw": "Peleka mkate wako juu ya maji",
      "am": "እንጀራህን በውኃ ላይ ስደድ"
    },
    "ECC.12.1.s1": {
      "en": "Remember your Creator",
      "sw": "Mkumbuke Muumba wako",
      "am": "ፈጣሪህን አስታውስ"
    }
  }
}
