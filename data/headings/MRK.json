      "sw": "Yesu anabatizwa",
      "am": "ኢየሱስ ተጠመቀ"
    },
    "MRK.1.12.s1": {
      "en": "Forty days in the wilderness",
      "sw": "Siku arobaini nyikani",
      "am": "በምድረ በዳ አርባ ቀን"
    },
    "MRK.1.14.s1": {
      "en": "The kingdom of God has come near",
      "sw": "Ufalme wa Mungu umekaribia",
      "am": "የእግዚአብሔር መንግሥት ቀርባለች"
    },
    "MRK.1.16.s1": {
      "en": "Four fishermen follow Jesus",
      "sw": "Wavuvi wanne wanamfuata Yesu",
      "am": "አራት ዓሣ አጥማጆች ኢየሱስን ተከተሉ"
    },
    "MRK.1.21.s1": {
      "en": "A new teaching, with authority",
      "sw": "Mafundisho mapya, yenye mamlaka",
      "am": "በሥልጣን የሆነ አዲስ ትምህርት"
    },
    "MRK.1.29.s1": {
      "en": "Simon's mother-in-law",
      "sw": "Mama mkwe wa Simoni",
      "am": "የስምዖን አማት"
    },
    "MRK.1.32.s1": {
      "en": "The whole town at the door",
      "sw": "Mji wote mlangoni",
      "am": "ከተማው ሁሉ በደጅ"
    },
    "MRK.1.35.s1": {
      "en": "On to the nearby towns",
      "sw": "Kwenda miji iliyo jirani",
      "am": "ወደ አቅራቢያ ከተሞች"
    },
    "MRK.1.40.s1": {
      "en": "A man with a skin disease is made clean",
      "sw": "Mtu mwenye ugonjwa wa ngozi anatakaswa",
      "am": "ለምጽ የያዘው ሰው ነጻ"
    },
    "MRK.2.1.s1": {
      "en": "Let down through the roof",
      "sw": "Anashushwa kupitia paa",
      "am": "በጣራው በኩል ወረደ"
    },
    "MRK.2.13.s1": {
      "en": "Levi leaves his tax office",
      "sw": "Lawi anaacha kibanda chake cha ushuru",
      "am": "ሌዊ የቀረጥ ቢሮውን ትቶ ሄደ"
    },
    "MRK.2.15.s1": {
      "en": "A meal with tax collectors and sinners",
      "sw": "Chakula pamoja na watoza ushuru na wenye dhambi",
      "am": "ከቀራጮችና ከኃጢአተኞች ጋር የተበላ ማዕድ"
    },
    "MRK.2.18.s1": {
      "en": "While the bridegroom is with them",
      "sw": "Bwana harusi akiwa pamoja nao",
      "am": "ሙሽራው ከእነርሱ ጋር ሳለ"
    },
    "MRK.2.23.s1": {
      "en": "The Sabbath was made for people",
      "sw": "Sabato iliwekwa kwa ajili ya watu",
      "am": "ሰንበት የተሠራው ለሰው ነው"
    },
    "MRK.3.1.s1": {
      "en": "A withered hand on the Sabbath",
      "sw": "Mkono uliopooza siku ya Sabato",
      "am": "በሰንበት የሰለለ እጅ"
    },
    "MRK.3.7.s1": {
      "en": "Crowds from every region",
      "sw": "Umati kutoka kila mkoa",
      "am": "ከየአውራጃው የመጡ ሕዝብ"
    },
    "MRK.3.13.s1": {
      "en": "Twelve chosen to be with {{deity_pronoun:him|Him}}",
      "sw": "Kumi na Wawili wanachaguliwa wawe pamoja {{deity_pronoun:naye|Naye}}",
      "am": "ከእርሱ ጋር እንዲሆኑ አሥራ ሁለቱ ተመረጡ"
    },
    "MRK.3.20.s1": {
      "en": "The strong man is bound",
      "sw": "Mtu mwenye nguvu anafungwa",
      "am": "ብርቱው ሰው ታሰረ"
    },
    "MRK.3.31.s1": {
      "en": "Whoever does the will of God",
      "sw": "Yeyote anayefanya mapenzi ya Mungu",
      "am": "የእግዚአብሔርን ፈቃድ የሚያደርግ ሁሉ"
    },
    "MRK.4.1.s1": {
      "en": "A farmer goes out to sow",
      "sw": "Mkulima anatoka kwenda kupanda",
      "am": "ገበሬ ሊዘራ ወጣ"
    },
    "MRK.4.10.s1": {
      "en": "Why Jesus speaks in parables",
      "sw": "Kwa nini Yesu anasema kwa mifano",
      "am": "ኢየሱስ በምሳሌ የሚናገርበት ምክንያት"
    },
    "MRK.4.13.s1": {
      "en": "The seed is the word",
      "sw": "Mbegu ni neno",
      "am": "ዘሩ ቃሉ ነው"
    },
    "MRK.4.21.s1": {
      "en": "Nothing hidden that will not come to light",
      "sw": "Hakuna kilichofichwa ambacho hakitafunuliwa",
      "am": "የማይገለጥ የተሰወረ ነገር የለም"
    },
    "MRK.4.26.s1": {
      "en": "Seed that grows by itself",
      "sw": "Mbegu inayokua yenyewe",
      "am": "በራሱ የሚያድግ ዘር"
    },
    "MRK.4.30.s1": {
      "en": "The smallest of seeds",
      "sw": "Mbegu iliyo ndogo kuliko zote",
      "am": "ከዘሮች ሁሉ የምታንሰው"
    },
    "MRK.4.35.s1": {
      "en": "Even the wind and the sea obey {{deity_pronoun:him|Him}}",
      "sw": "Hata upepo na bahari vinamtii",
      "am": "ነፋስና ባሕር እንኳ ይታዘዙለታል"
    },
    "MRK.5.1.s1": {
      "en": "A man called Legion",
      "sw": "Mtu aitwaye Legioni",
      "am": "ሌጌዎን የተባለው ሰው"
    },
    "MRK.5.21.s1": {
      "en": "Jairus pleads for his daughter",
      "sw": "Yairo anamsihi kwa ajili ya binti yake",
      "am": "ኢያኢሮስ ስለ ልጁ ለመነ"
    },
    "MRK.5.24.s2": {
      "en": "Twelve years of bleeding",
      "sw": "Miaka kumi na miwili ya kutokwa damu",
      "am": "ለዐሥራ ሁለት ዓመት የፈሰሰ ደም"
    },
    "MRK.5.35.s1": {
      "en": "Little girl, get up",
      "sw": "Msichana, amka",
      "am": "አንቺ ብላቴና፣ ተነሺ"
    },
    "MRK.6.1.s1": {
      "en": "Rejected in {{deity_pronoun:his|His}} hometown",
      "sw": "Anakataliwa katika mji {{deity_pronoun:wake|Wake}}",
      "am": "በገዛ አገሩ ተናቀ"
    },
    "MRK.6.6.s2": {
      "en": "The Twelve sent out two by two",
      "sw": "Kumi na Wawili wanatumwa wawili wawili",
      "am": "አሥራ ሁለቱ ሁለት ሁለት ሆነው ተላኩ"
    },
    "MRK.6.14.s1": {
      "en": "Herod hears about Jesus",
      "sw": "Herode anasikia habari za Yesu",
      "am": "ሄሮድስ ስለ ኢየሱስ ሰማ"
    },
    "MRK.6.17.s1": {
      "en": "The death of John the Baptizer",
      "sw": "Kifo cha Yohana Mbatizaji",
      "am": "የመጥምቁ ዮሐንስ ሞት"
    },
    "MRK.6.30.s1": {
      "en": "Five loaves and two fish",
      "sw": "Mikate mitano na samaki wawili",
      "am": "አምስት እንጀራና ሁለት ዓሣ"
    },
    "MRK.6.45.s1": {
      "en": "Across the lake at night",
      "sw": "Kuvuka ziwa usiku",
      "am": "በሌሊት ሐይቁን መሻገር"
    },
    "MRK.6.53.s1": {
      "en": "Healing at Gennesaret",
      "sw": "Kuponya huko Genesareti",
      "am": "በጌንሴሬጥ የተደረገ ፈውስ"
    },
    "MRK.7.1.s1": {
      "en": "Washed hands and the tradition of the elders",
      "sw": "Mikono iliyonawa na mapokeo ya wazee",
      "am": "የታጠበ እጅና የሽማግሌዎች ወግ"
    },
    "MRK.7.14.s1": {
      "en": "What makes a person unclean",
      "sw": "Kinachomfanya mtu kuwa najisi",
      "am": "ሰውን የሚያረክሰው"
    },
    "MRK.7.24.s1": {
      "en": "Even the little dogs eat the crumbs",
      "sw": "Hata mbwa wadogo hula makombo",
      "am": "ቡችሎችም እንኳ ፍርፋሪ ይበላሉ"
    },
    "MRK.7.31.s1": {
      "en": "Ephphatha: be opened",
      "sw": "Efatha: funguka",
      "am": "ኤፍታሕ፤ ተከፈት"
    },
    "MRK.8.1.s1": {
      "en": "Seven loaves in a deserted place",
      "sw": "Mikate saba mahali pasipo na watu",
      "am": "በምድረ በዳ ሰባት እንጀራ"
    },
    "MRK.8.11.s1": {
      "en": "No sign for this generation",
      "sw": "Hakuna ishara kwa kizazi hiki",
      "am": "ለዚህ ትውልድ ምልክት አይሰጠውም"
    },
    "MRK.8.14.s1": {
      "en": "Do you still not understand?",
      "sw": "Je, bado hamwelewi?",
      "am": "ገና አላስተዋላችሁምን?"
    },
    "MRK.8.27.s1": {
      "en": "You are {{christos:Christ|the Messiah}}",
      "sw": "Wewe ndiwe {{christos:Kristo|Masihi}}",
      "am": "አንተ {{christos:ክርስቶስ|መሲሑ}} ነህ"
    },
    "MRK.8.31.s1": {
      "en": "The Son of Man must suffer",
      "sw": "Mwana wa Adamu lazima ateswe",
      "am": "የሰው ልጅ መከራ ሊቀበል ይገባዋል"
    },
    "MRK.8.34.s1": {
      "en": "Take up your cross",
      "sw": "Ubebe msalaba wako",
      "am": "መስቀልህን ተሸከም"
    },
    "MRK.9.2.s1": {
      "en": "Transfigured on the mountain",
      "sw": "Anabadilika sura mlimani",
      "am": "በተራራ ላይ ተለወጠ"
    },
    "MRK.9.9.s1": {
      "en": "Elijah has come",
      "sw": "Eliya amekwisha kuja",
      "am": "ኤልያስ መጥቷል"
    },
    "MRK.9.14.s1": {
      "en": "I believe; help my unbelief",
      "sw": "Ninaamini; nisaidie kutoamini kwangu",
      "am": "አምናለሁ፤ አለማመኔን እርዳው"
    },
    "MRK.9.30.s1": {
      "en": "Handed over, killed, and raised",
      "sw": "Atakabidhiwa, atauawa, na atafufuliwa",
      "am": "ተላልፎ ይሰጣል፣ ይገደላል፣ ይነሣልም"
    },
    "MRK.9.33.s1": {
      "en": "Who is the greatest?",
      "sw": "Ni nani aliye mkuu zaidi?",
      "am": "ከሁሉ የሚበልጥ ማን ነው?"
    },
    "MRK.9.38.s1": {
      "en": "Whoever is not against us",
      "sw": "Yeyote asiye kinyume chetu",
      "am": "የማይቃወመን ሁሉ"
    },
    "MRK.9.42.s1": {
      "en": "Better to enter life maimed",
      "sw": "Ni afadhali kuingia uzimani ukiwa kilema",
      "am": "ጉንድሽ ሆኖ ወደ ሕይወት መግባት ይሻላል"
    },
    "MRK.10.1.s1": {
      "en": "What God has joined",
      "sw": "Alichokiunganisha Mungu",
      "am": "እግዚአብሔር ያጣመረውን"
    },
    "MRK.10.13.s1": {
      "en": "Let the children come",
      "sw": "Waacheni watoto waje",
      "am": "ሕፃናት ይምጡ"
    },
    "MRK.10.17.s1": {
      "en": "A rich man's question",
      "sw": "Swali la mtu tajiri",
      "am": "የአንድ ሀብታም ሰው ጥያቄ"
    },
    "MRK.10.32.s1": {
      "en": "On the road up to Jerusalem",
      "sw": "Njiani kupanda Yerusalemu",
      "am": "ወደ ኢየሩሳሌም በሚወጣው መንገድ ላይ"
    },
    "MRK.10.35.s1": {
      "en": "Not to be served but to serve",
      "sw": "Si kutumikiwa bali kutumikia",
      "am": "ሊያገለግል እንጂ እንዲያገለግሉት አይደለም"
    },
    "MRK.10.46.s1": {
      "en": "Blind Bartimaeus",
      "sw": "Bartimayo kipofu",
      "am": "ዓይነ ስውሩ በርጤሜዎስ"
    },
    "MRK.11.1.s1": {
      "en": "Hosanna on the road to Jerusalem",
      "sw": "Hosana njiani kwenda Yerusalemu",
      "am": "ወደ ኢየሩሳሌም በሚወስደው መንገድ ላይ ሆሣዕና"
    },
    "MRK.11.12.s1": {
      "en": "A fig tree with nothing but leaves",
      "sw": "Mtini usio na kitu ila majani",
      "am": "ከቅጠል በቀር ምንም የሌላት በለስ"
    },
    "MRK.11.15.s1": {
      "en": "A house of prayer for all the nations",
      "sw": "Nyumba ya sala kwa mataifa yote",
      "am": "ለአሕዛብ ሁሉ የጸሎት ቤት"
    },
    "MRK.11.20.s1": {
      "en": "Have faith in God",
      "sw": "Mwaminini Mungu",
      "am": "በእግዚአብሔር እመኑ"
    },
    "MRK.11.27.s1": {
      "en": "By what authority?",
      "sw": "Kwa mamlaka gani?",
      "am": "በምን ሥልጣን?"
    },
    "MRK.12.1.s1": {
      "en": "The tenants of the vineyard",
      "sw": "Wapangaji wa shamba la mizabibu",
      "am": "የወይኑ ቦታ ተከራዮች"
    },
    "MRK.12.13.s1": {
      "en": "Give back to Caesar",
      "sw": "Mrudishieni Kaisari",
      "am": "ለቄሳር መልሱ"
    },
    "MRK.12.18.s1": {
      "en": "The God of the living",
      "sw": "Mungu wa walio hai",
      "am": "የሕያዋን አምላክ"
    },
    "MRK.12.28.s1": {
      "en": "The first commandment of all",
      "sw": "Amri ya kwanza kuliko zote",
      "am": "ከሁሉ የመጀመሪያዋ ትእዛዝ"
    },
    "MRK.12.35.s1": {
      "en": "David's son and David's Lord",
      "sw": "Mwana wa Daudi na Bwana wa Daudi",
      "am": "የዳዊት ልጅና የዳዊት ጌታ"
    },
    "MRK.12.38.s1": {
      "en": "Beware of the scribes",
      "sw": "Jihadharini na waandishi",
      "am": "ከሕግ መምህራን ተጠንቀቁ"
    },
    "MRK.12.41.s1": {
      "en": "A widow gives everything",
      "sw": "Mjane anatoa kila kitu",
      "am": "መበለቲቱ ያላትን ሁሉ ሰጠች"
    },
    "MRK.13.1.s1": {
      "en": "Not one stone left on another",
      "sw": "Hakuna jiwe litakaloachwa juu ya jiwe",
      "am": "ድንጋይ በድንጋይ ላይ አይቀርም"
    },
    "MRK.13.14.s1": {
      "en": "When you see the abomination",
      "sw": "Mtakapoliona chukizo",
      "am": "ርኩሱን ነገር ስታዩ"
    },
    "MRK.13.24.s1": {
      "en": "The Son of Man coming in the clouds",
      "sw": "Mwana wa Adamu akija katika mawingu",
      "am": "የሰው ልጅ በደመና ሲመጣ"
    },
    "MRK.13.28.s1": {
      "en": "Learn from the fig tree",
      "sw": "Jifunzeni kutoka kwa mtini",
      "am": "ከበለስ ተማሩ"
    },
    "MRK.13.32.s1": {
      "en": "Keep awake",
      "sw": "Kesheni",
      "am": "ንቁ"
    },
    "MRK.14.1.s1": {
      "en": "A plot two days before the Passover",
      "sw": "Njama siku mbili kabla ya Pasaka",
      "am": "ከፋሲካ ሁለት ቀን በፊት የተደረገ ሤራ"
    },
    "MRK.14.3.s1": {
      "en": "Anointed at Bethany",
      "sw": "Anapakwa manukato huko Bethania",
      "am": "በቢታንያ ሽቱ ተቀባ"
    },
    "MRK.14.10.s1": {
      "en": "Judas goes to the chief priests",
      "sw": "Yuda anakwenda kwa makuhani wakuu",
      "am": "ይሁዳ ወደ ካህናት አለቆች ሄደ"
    },
    "MRK.14.12.s1": {
      "en": "Preparing the Passover",
      "sw": "Kuandaa Pasaka",
      "am": "ፋሲካን ማዘጋጀት"
    },
    "MRK.14.17.s1": {
      "en": "One of you will hand {{deity_pronoun:me|Me}} over",
      "sw": "Mmoja wenu atanisaliti",
      "am": "ከእናንተ አንዱ አሳልፎ ይሰጠኛል"
    },
    "MRK.14.22.s1": {
      "en": "My body, my blood of the covenant",
      "sw": "Mwili {{deity_pronoun:wangu|Wangu}}, damu {{deity_pronoun:yangu|Yangu}} ya agano",
      "am": "ሥጋዬ፣ የኪዳን ደሜ"
    },
    "MRK.14.27.s1": {
      "en": "Peter's denial foretold",
      "sw": "Yesu anatabiri kwamba Petro atamkana",
      "am": "ኢየሱስ ጴጥሮስ እንደሚክደው ተናገረ"
    },
    "MRK.14.32.s1": {
      "en": "Gethsemane",
      "sw": "Gethsemane",
      "am": "ጌቴሴማኒ"
    },
    "MRK.14.43.s1": {
      "en": "Arrested with a kiss",
      "sw": "Anakamatwa kwa busu",
      "am": "በመሳም ተያዘ"
    },
    "MRK.14.53.s1": {
      "en": "Before the council",
      "sw": "Mbele ya Baraza",
      "am": "በሸንጎው ፊት"
    },
    "MRK.14.66.s1": {
      "en": "Peter denies knowing {{deity_pronoun:him|Him}}",
      "sw": "Petro anakana kumjua",
      "am": "ጴጥሮስ እንደማያውቀው ካደ"
    },
    "MRK.15.1.s1": {
      "en": "Before Pilate",
      "sw": "Mbele ya Pilato",
      "am": "በጲላጦስ ፊት"
    },
    "MRK.15.16.s1": {
      "en": "The soldiers mock the king",
      "sw": "Askari wanamdhihaki mfalme",
      "am": "ወታደሮቹ በንጉሡ ላይ አፌዙ"
    },
    "MRK.15.21.s1": {
      "en": "Crucified at Golgotha",
      "sw": "Anasulubiwa Golgotha",
      "am": "በጎልጎታ ተሰቀለ"
    },
    "MRK.15.33.s1": {
      "en": "Darkness at noon and the torn curtain",
      "sw": "Giza adhuhuri na pazia lililopasuka",
      "am": "በቀትር የሆነው ጨለማና የተቀደደው መጋረጃ"
    },
    "MRK.15.40.s1": {
      "en": "The women watching from a distance",
      "sw": "Wanawake wanaotazama kwa mbali",
      "am": "ከሩቅ ሆነው የሚመለከቱት ሴቶች"
    },
    "MRK.15.42.s1": {
      "en": "Laid in a tomb cut from rock",
      "sw": "Analazwa katika kaburi lililochongwa mwambani",
      "am": "ከዓለት በተወቀረ መቃብር ተቀበረ"
    },
    "MRK.16.1.s1": {
      "en": "He has been raised",
      "sw": "Amefufuliwa",
      "am": "ተነሥቷል"
    },
    "MRK.16.8.s2": {
      "en": "The shorter ending",
      "sw": "Hitimisho fupi",
      "am": "አጭሩ መደምደሚያ"
    },
    "MRK.16.9.s1": {
      "en": "The longer ending: Jesus appears",
      "sw": "Hitimisho refu: Yesu anajitokeza",
      "am": "ረጅሙ መደምደሚያ፤ ኢየሱስ ተገለጠ"
    },
    "MRK.16.19.s1": {
      "en": "Taken up into heaven",
      "sw": "Anachukuliwa juu mbinguni",
      "am": "ወደ ሰማይ ተወሰደ"
    }
  }
}
