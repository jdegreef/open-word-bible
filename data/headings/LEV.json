    "LEV.26.27.s1": {
      "en": "Exile, and the covenant remembered",
      "sw": "Uhamisho, na agano linakumbukwa",
      "am": "ስደትና የታሰበው ቃል ኪዳን"
    },
    "LEV.27.1.s1": {
      "en": "Vows of people",
      "sw": "Nadhiri za watu",
      "am": "ሰዎችን በተመለከተ የሚደረግ ስእለት"
    },
    "LEV.27.9.s1": {
      "en": "Vows of animals, houses and fields",
      "sw": "Nadhiri za wanyama, nyumba na mashamba",
      "am": "እንስሳትን፣ ቤቶችንና እርሻዎችን በተመለከተ የሚደረግ ስእለት"
    },
    "LEV.27.26.s1": {
      "en": "Firstborn, devoted things and tithes",
      "sw": "Wazaliwa wa kwanza, vitu vilivyowekwa wakfu na zaka",
      "am": "በኩሮች፣ የተለዩ ነገሮችና አሥራት"
    }
  }
}
