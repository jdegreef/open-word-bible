    "EZK.21.6.s1": {
      "en": "The sword drawn from its sheath",
      "sw": "Upanga uliofutwa alani mwake",
      "am": "ከሰገባው የተመዘዘ ሰይፍ",
      "vi": "Gươm được rút ra khỏi vỏ",
      "ko": "칼집에서 뽑힌 칼"
    },
    "EZK.21.13.s1": {
      "en": "The song of the sword",
      "sw": "Wimbo wa upanga",
      "am": "የሰይፉ መዝሙር",
      "vi": "Bài ca về thanh gươm",
      "ko": "칼의 노래"
    },
    "EZK.21.23.s1": {
      "en": "The king of Babylon at the fork in the road",
      "sw": "Mfalme wa Babeli kwenye njia panda",
      "am": "የባቢሎን ንጉሥ በመንገድ መገንጠያ ላይ",
      "vi": "Vua Ba-by-lôn tại ngã ba đường",
      "ko": "갈림길에 선 바빌론 왕"
    },
    "EZK.21.30.s1": {
      "en": "A word to the prince of Israel",
      "sw": "Neno kwa mkuu wa Israeli",
      "am": "ለእስራኤል ገዥ የተነገረ ቃል",
      "vi": "Lời cho thủ lĩnh của Y-sơ-ra-ên",
      "ko": "이스라엘의 군주에게 주는 말씀"
    },
    "EZK.21.33.s1": {
      "en": "A sword against the Ammonites",
      "sw": "Upanga dhidi ya Waamoni",
      "am": "በአሞናውያን ላይ የሚመጣ ሰይፍ",
      "vi": "Gươm nghịch cùng người Am-môn",
      "ko": "암몬 사람들을 치는 칼"
    },
    "EZK.22.1.s1": {
      "en": "The city of bloodshed",
      "sw": "Mji wa umwagaji damu",
      "am": "ደም የምታፈስሰው ከተማ",
      "vi": "Thành đổ máu",
      "ko": "피의 성읍"
    },
    "EZK.22.17.s1": {
      "en": "Dross in the furnace",
      "sw": "Mavi ya chuma tanuruni",
      "am": "በእቶን ውስጥ ያለ ዝቃጭ",
      "vi": "Cặn bã trong lò luyện",
      "ko": "용광로 속의 찌꺼기"
    },
    "EZK.22.23.s1": {
      "en": "No one to stand in the gap",
      "sw": "Hakuna wa kusimama mahali palipobomoka",
      "am": "በክፍተቱ የሚቆም የለም",
      "vi": "Không ai đứng nơi chỗ tường thủng",
      "ko": "무너진 틈에 설 사람이 없다"
    },
    "EZK.23.1.s1": {
      "en": "Two sisters, Oholah and Oholibah",
      "sw": "Dada wawili, Ohola na Oholiba",
      "am": "ሁለቱ እኅትማማቾች ኦሖላና ኦሖሊባ",
      "vi": "Hai chị em, Ô-hô-la và Ô-hô-li-ba",
      "ko": "두 자매 오홀라와 오홀리바"
    },
    "EZK.23.11.s1": {
      "en": "Oholibah follows her sister",
      "sw": "Oholiba anamfuata dada yake",
      "am": "ኦሖሊባ እኅቷን ተከተለች",
      "vi": "Ô-hô-li-ba theo gót chị mình",
      "ko": "오홀리바가 언니의 길을 따르다"
    },
    "EZK.23.22.s1": {
      "en": "Her lovers turned against her",
      "sw": "Wapenzi wake wanamgeukia",
      "am": "ወዳጆቿ በእርሷ ላይ ተነሡ",
      "vi": "Những người tình quay lại chống nàng",
      "ko": "그 여자에게 등을 돌린 정부들"
    },
    "EZK.23.32.s1": {
      "en": "The cup of her sister",
      "sw": "Kikombe cha dada yake",
      "am": "የእኅቷ ጽዋ",
      "vi": "Chén của chị nàng",
      "ko": "언니의 잔"
    },
    "EZK.23.36.s1": {
      "en": "Judgment on both sisters",
      "sw": "Hukumu juu ya dada wote wawili",
      "am": "በሁለቱ እኅትማማቾች ላይ የሚመጣ ፍርድ",
      "vi": "Sự đoán phạt trên cả hai chị em",
      "ko": "두 자매에 대한 심판"
    },
    "EZK.24.1.s1": {
      "en": "The pot on the fire",
      "sw": "Chungu motoni",
      "am": "በእሳት ላይ ያለ ድስት",
      "vi": "Cái nồi trên lửa",
      "ko": "불 위의 가마솥"
    },
    "EZK.24.6.s1": {
      "en": "Woe to the city of bloodshed",
      "sw": "Ole wake mji wa umwagaji damu",
      "am": "ደም ለምታፈስሰው ከተማ ወዮላት",
      "vi": "Khốn cho thành đổ máu",
      "ko": "피의 성읍에 화가 있다"
    },
    "EZK.24.15.s1": {
      "en": "The death of Ezekiel's wife",
      "sw": "Kifo cha mke wa Ezekieli",
      "am": "የሕዝቅኤል ሚስት ሞት",
      "vi": "Vợ của Ê-xê-chi-ên qua đời",
      "ko": "에스겔의 아내가 죽다"
    },
    "EZK.24.25.s1": {
      "en": "A survivor will bring the news",
      "sw": "Aliyenusurika ataleta habari",
      "am": "ያመለጠ ሰው ወሬውን ያመጣል",
      "vi": "Một người sống sót sẽ đem tin đến",
      "ko": "살아남은 사람이 소식을 전할 것이다"
    },
    "EZK.25.1.s1": {
      "en": "Against Ammon",
      "sw": "Dhidi ya Waamoni",
      "am": "በአሞናውያን ላይ",
      "vi": "Nghịch cùng Am-môn",
      "ko": "암몬을 향하여"
    },
    "EZK.25.6.s1": {
      "en": "Ammon's scorn repaid",
      "sw": "Dharau ya Waamoni inalipwa",
      "am": "የአሞናውያን ንቀት ተመለሰባቸው",
      "vi": "Sự khinh miệt của Am-môn bị báo trả",
      "ko": "암몬의 조롱에 대한 보응"
    },
    "EZK.25.8.s1": {
      "en": "Against Moab",
      "sw": "Dhidi ya Moabu",
      "am": "በሞዓብ ላይ",
      "vi": "Nghịch cùng Mô-áp",
      "ko": "모압을 향하여"
    },
    "EZK.25.12.s1": {
      "en": "Against Edom",
      "sw": "Dhidi ya Edomu",
      "am": "በኤዶም ላይ",
      "vi": "Nghịch cùng Ê-đôm",
      "ko": "에돔을 향하여"
    },
    "EZK.25.15.s1": {
      "en": "Against the Philistines",
      "sw": "Dhidi ya Wafilisti",
      "am": "በፍልስጥኤማውያን ላይ",
      "vi": "Nghịch cùng người Phi-li-tin",
      "ko": "블레셋 사람들을 향하여"
    },
    "EZK.26.1.s1": {
      "en": "Tyre will become a bare rock",
      "sw": "Tiro utakuwa mwamba mtupu",
      "am": "ጢሮስ የተራቈተ ዓለት ትሆናለች",
      "vi": "Ty-rơ sẽ thành tảng đá trơ trụi",
      "ko": "두로가 맨바위가 될 것이다"
    },
    "EZK.26.7.s1": {
      "en": "Nebuchadrezzar against Tyre",
      "sw": "Nebukadreza dhidi ya Tiro",
      "am": "ናቡከደነፆር በጢሮስ ላይ",
      "vi": "Nê-bu-cát-rết-sa nghịch cùng Ty-rơ",
      "ko": "두로를 치는 느부갓레살"
    },
    "EZK.26.15.s1": {
      "en": "The princes of the sea mourn",
      "sw": "Wakuu wa bahari wanaomboleza",
      "am": "የባሕር አለቆች አለቀሱ",
      "vi": "Các vương hầu miền biển than khóc",
      "ko": "바다의 군주들이 애곡하다"
    },
    "EZK.26.19.s1": {
      "en": "Down to the pit",
      "sw": "Kushuka shimoni",
      "am": "ወደ ጉድጓድ መውረድ",
      "vi": "Xuống huyệt",
      "ko": "구덩이로 내려가다"
    },
    "EZK.27.1.s1": {
      "en": "A lament for the ship Tyre",
      "sw": "Maombolezo kwa ajili ya meli Tiro",
      "am": "ስለ መርከቢቱ ጢሮስ የሚደረግ ሙሾ",
      "vi": "Bài ai ca cho con tàu Ty-rơ",
      "ko": "배 두로를 위한 애가"
    },
    "EZK.28.1.s1": {
      "en": "The ruler who said, I am a god",
      "sw": "Mtawala aliyesema, Mimi ni mungu",
      "am": "እኔ አምላክ ነኝ ያለው ገዥ",
      "vi": "Kẻ cai trị đã nói: Ta là một vị thần",
      "ko": "\"나는 신이다\" 하고 말한 통치자"
    },
    "EZK.28.6.s1": {
      "en": "A mortal and not a god",
      "sw": "Mwanadamu wala si mungu",
      "am": "ሰው እንጂ አምላክ አይደለም",
      "vi": "Là loài người chứ không phải thần",
      "ko": "신이 아니라 사람일 뿐"
    },
    "EZK.28.11.s1": {
      "en": "A lament for the king of Tyre",
      "sw": "Maombolezo kwa ajili ya mfalme wa Tiro",
      "am": "ስለ ጢሮስ ንጉሥ የሚደረግ ሙሾ",
      "vi": "Bài ai ca cho vua Ty-rơ",
      "ko": "두로 왕을 위한 애가"
    },
    "EZK.28.20.s1": {
      "en": "Against Sidon",
      "sw": "Dhidi ya Sidoni",
      "am": "በሲዶና ላይ",
      "vi": "Nghịch cùng Si-đôn",
      "ko": "시돈을 향하여"
    },
    "EZK.28.25.s1": {
      "en": "Israel gathered and safe",
      "sw": "Israeli anakusanywa na kukaa salama",
      "am": "እስራኤል ተሰብስቦ በሰላም ተቀመጠ",
      "vi": "Y-sơ-ra-ên được nhóm lại và an toàn",
      "ko": "다시 모여 안전하게 사는 이스라엘"
    },
    "EZK.29.1.s1": {
      "en": "Pharaoh, the great monster of the Nile",
      "sw": "Farao, joka kubwa la Nile",
      "am": "ፈርዖን፣ የዓባይ ታላቅ ዘንዶ",
      "vi": "Pha-ra-ôn, con thủy quái lớn của sông Nin",
      "ko": "나일 강의 큰 괴물 바로"
    },
    "EZK.29.8.s1": {
      "en": "Egypt laid waste",
      "sw": "Misri inafanywa ukiwa",
      "am": "ግብፅ ባድማ ሆነች",
      "vi": "Ai Cập bị tàn phá",
      "ko": "황폐해지는 이집트"
    },
    "EZK.29.13.s1": {
      "en": "A lowly kingdom",
      "sw": "Ufalme duni",
      "am": "የተዋረደ መንግሥት",
      "vi": "Một vương quốc thấp hèn",
      "ko": "보잘것없는 왕국"
    },
    "EZK.29.17.s1": {
      "en": "Egypt as Nebuchadrezzar's wages",
      "sw": "Misri kama ujira wa Nebukadreza",
      "am": "ግብፅ ለናቡከደነፆር ደመወዝ",
      "vi": "Ai Cập là tiền công cho Nê-bu-cát-rết-sa",
      "ko": "느부갓레살의 품삯이 된 이집트"
    },
    "EZK.29.19.s1": {
      "en": "Pay for his army",
      "sw": "Malipo kwa jeshi lake",
      "am": "ለሠራዊቱ የሚከፈል ዋጋ",
      "vi": "Tiền công cho quân đội của vua",
      "ko": "그의 군대에게 줄 삯"
    },
    "EZK.29.21.s1": {
      "en": "A horn for Israel",
      "sw": "Pembe kwa ajili ya Israeli",
      "am": "ለእስራኤል የሚበቅል ቀንድ",
      "vi": "Một cái sừng cho Y-sơ-ra-ên",
      "ko": "이스라엘을 위한 뿔"
    },
    "EZK.30.1.s1": {
      "en": "The day of {{divine_name:the LORD|Yahweh}} on Egypt",
      "sw": "Siku ya {{divine_name:BWANA|Yahwe}} juu ya Misri",
      "am": "በግብፅ ላይ {{divine_name:የእግዚአብሔር|የያህዌ}} ቀን",
      "vi": "Ngày của {{divine_name:CHÚA|Gia-vê}} trên Ai Cập",
      "ko": "이집트에 임하는 {{divine_name:주|야훼}}의 날"
    },
    "EZK.30.6.s1": {
      "en": "Egypt's helpers fall",
      "sw": "Wasaidizi wa Misri wanaanguka",
      "am": "የግብፅ ረዳቶች ወደቁ",
      "vi": "Những kẻ giúp Ai Cập sụp đổ",
      "ko": "이집트를 돕는 자들이 쓰러지다"
    },
    "EZK.30.10.s1": {
      "en": "By the hand of Babylon",
      "sw": "Kwa mkono wa Babeli",
      "am": "በባቢሎን እጅ",
      "vi": "Bởi tay Ba-by-lôn",
      "ko": "바빌론의 손으로"
    },
    "EZK.30.13.s1": {
      "en": "Judgment on Egypt's cities",
      "sw": "Hukumu juu ya miji ya Misri",
      "am": "በግብፅ ከተሞች ላይ የሚመጣ ፍርድ",
      "vi": "Sự đoán phạt trên các thành của Ai Cập",
      "ko": "이집트 성읍들에 대한 심판"
    },
    "EZK.30.20.s1": {
      "en": "Pharaoh's broken arm",
      "sw": "Mkono uliovunjika wa Farao",
      "am": "የፈርዖን የተሰበረ ክንድ",
      "vi": "Cánh tay bị gãy của Pha-ra-ôn",
      "ko": "부러진 바로의 팔"
    },
    "EZK.30.22.s1": {
      "en": "Both arms broken",
      "sw": "Mikono yote miwili imevunjika",
      "am": "ሁለቱም ክንዶች ተሰበሩ",
      "vi": "Cả hai cánh tay đều bị gãy",
      "ko": "두 팔이 다 부러지다"
    },
    "EZK.31.1.s1": {
      "en": "A cedar in Lebanon",
      "sw": "Mwerezi katika Lebanoni",
      "am": "በሊባኖስ ያለ ዝግባ",
      "vi": "Cây bá hương ở Li-ban",
      "ko": "레바논의 백향목"
    },
    "EZK.31.10.s1": {
      "en": "The great tree cut down",
      "sw": "Mti mkubwa unakatwa",
      "am": "ታላቁ ዛፍ ተቈረጠ",
      "vi": "Cây lớn bị đốn ngã",
      "ko": "베어 넘어진 큰 나무"
    },
    "EZK.31.15.s1": {
      "en": "Down to Sheol",
      "sw": "Kushuka Kuzimu",
      "am": "ወደ ሙታን ዓለም መውረድ",
      "vi": "Xuống Âm Phủ",
      "ko": "스올로 내려가다"
    },
    "EZK.32.1.s1": {
      "en": "A lament for Pharaoh",
      "sw": "Maombolezo kwa ajili ya Farao",
      "am": "ስለ ፈርዖን የሚደረግ ሙሾ",
      "vi": "Bài ai ca cho Pha-ra-ôn",
      "ko": "바로를 위한 애가"
    },
    "EZK.32.11.s1": {
      "en": "The sword of Babylon",
      "sw": "Upanga wa Babeli",
      "am": "የባቢሎን ሰይፍ",
      "vi": "Gươm của Ba-by-lôn",
      "ko": "바빌론의 칼"
    },
    "EZK.32.17.s1": {
      "en": "Egypt among the fallen",
      "sw": "Misri kati ya walioanguka",
      "am": "ግብፅ ከወደቁት መካከል",
      "vi": "Ai Cập giữa những kẻ đã ngã chết",
      "ko": "쓰러진 자들 가운데 있는 이집트"
    },
    "EZK.33.1.s1": {
      "en": "The watchman's duty",
      "sw": "Wajibu wa mlinzi",
      "am": "የጠባቂው ኃላፊነት",
      "vi": "Bổn phận của người canh gác",
      "ko": "파수꾼의 의무"
    },
    "EZK.33.7.s1": {
      "en": "Ezekiel is appointed watchman again",
      "sw": "Ezekieli anawekwa tena kuwa mlinzi",
      "am": "ሕዝቅኤል እንደ ገና ጠባቂ ሆኖ ተሾመ",
      "vi": "Ê-xê-chi-ên lại được lập làm người canh gác",
      "ko": "에스겔이 다시 파수꾼으로 세워지다"
    },
    "EZK.33.10.s1": {
      "en": "Turn back and live",
      "sw": "Rudini mkaishi",
      "am": "ተመለሱ፤ በሕይወትም ኑሩ",
      "vi": "Hãy quay về và sống",
      "ko": "돌이켜 살아라"
    },
    "EZK.33.12.s1": {
      "en": "Each person judged by their own ways",
      "sw": "Kila mtu anahukumiwa kwa njia zake",
      "am": "እያንዳንዱ እንደ መንገዱ ይፈረድበታል",
      "vi": "Mỗi người bị xét xử theo đường lối riêng của mình",
      "ko": "각 사람이 자기 길대로 심판받다"
    },
    "EZK.33.23.s1": {
      "en": "The claim of those left in the ruins",
      "sw": "Madai ya wale walioachwa magofuni",
      "am": "በፍርስራሹ የቀሩት ሰዎች የይገባናል ጥያቄ",
      "vi": "Lời khẳng định của những người còn sót lại giữa đống đổ nát",
      "ko": "폐허에 남은 사람들의 주장"
    },
    "EZK.33.30.s1": {
      "en": "Hearers who do not act",
      "sw": "Wasikilizaji wasiotenda",
      "am": "የማይፈጽሙ ሰሚዎች",
      "vi": "Những người nghe mà không làm theo",
      "ko": "듣기만 하고 행하지 않는 사람들"
    },
    "EZK.34.1.s1": {
      "en": "The shepherds who fed themselves",
      "sw": "Wachungaji waliojilisha wenyewe",
      "am": "ራሳቸውን የመገቡ እረኞች",
      "vi": "Những người chăn chỉ lo nuôi chính mình",
      "ko": "자기만 먹이는 목자들"
    },
    "EZK.34.11.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} will shepherd {{deity_pronoun:his|His}} flock",
      "sw": "{{divine_name:BWANA|Yahwe}} atalichunga kundi {{deity_pronoun:lake|Lake}}",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} መንጋውን ይጠብቃል",
      "vi": "{{divine_name:CHÚA|Gia-vê}} sẽ chăn bầy chiên của {{deity_pronoun:ngài|Ngài}}",
      "ko": "{{divine_name:주|야훼}}께서 친히 자기 양 떼를 치실 것이다"
    },
    "EZK.34.20.s1": {
      "en": "Judgment between sheep and sheep",
      "sw": "Hukumu kati ya kondoo na kondoo",
      "am": "በበግና በበግ መካከል የሚደረግ ፍርድ",
      "vi": "Sự xét xử giữa chiên với chiên",
      "ko": "양과 양 사이의 심판"
    },
    "EZK.35.1.s1": {
      "en": "A message against Mount Seir",
      "sw": "Ujumbe dhidi ya Mlima Seiri",
      "am": "በሴይር ተራራ ላይ የተነገረ መልእክት",
      "vi": "Sứ điệp nghịch cùng núi Sê-i-rơ",
      "ko": "세일 산을 향한 말씀"
    },
    "EZK.36.1.s1": {
      "en": "Hope for the mountains of Israel",
      "sw": "Tumaini kwa milima ya Israeli",
      "am": "ለእስራኤል ተራሮች ተስፋ",
      "vi": "Niềm hy vọng cho các núi của Y-sơ-ra-ên",
      "ko": "이스라엘의 산들을 위한 소망"
    },
    "EZK.36.16.s1": {
      "en": "For the sake of {{deity_pronoun:his|His}} holy name",
      "sw": "Kwa ajili ya jina {{deity_pronoun:lake|Lake}} takatifu",
      "am": "ስለ ቅዱስ ስሙ",
      "vi": "Vì cớ danh thánh của {{deity_pronoun:ngài|Ngài}}",
      "ko": "그분의 거룩한 이름을 위하여"
    },
    "EZK.36.22.s1": {
      "en": "A new heart and a new spirit",
      "sw": "Moyo mpya na roho mpya",
      "am": "አዲስ ልብና አዲስ መንፈስ",
      "vi": "Một tấm lòng mới và một tâm linh mới",
      "ko": "새 마음과 새 영"
    },
    "EZK.36.33.s1": {
      "en": "Like the garden of Eden",
      "sw": "Kama bustani ya Edeni",
      "am": "እንደ ኤደን የአትክልት ቦታ",
      "vi": "Như vườn Ê-đen",
      "ko": "에덴동산처럼"
    },
    "EZK.37.1.s1": {
      "en": "The valley of dry bones",
      "sw": "Bonde la mifupa mikavu",
      "am": "የደረቁ አጥንቶች ሸለቆ",
      "vi": "Thung lũng xương khô",
      "ko": "마른 뼈의 골짜기"
    },
    "EZK.37.15.s1": {
      "en": "Two sticks become one",
      "sw": "Vijiti viwili vinakuwa kimoja",
      "am": "ሁለቱ እንጨቶች አንድ ሆኑ",
      "vi": "Hai khúc gỗ trở thành một",
      "ko": "두 막대기가 하나가 되다"
    },
    "EZK.38.1.s1": {
      "en": "Gog comes from the north",
      "sw": "Gogu anakuja kutoka kaskazini",
      "am": "ጎግ ከሰሜን መጣ",
      "vi": "Gót đến từ phương bắc",
      "ko": "북쪽에서 오는 곡"
    },
    "EZK.38.10.s1": {
      "en": "Gog's evil plan",
      "sw": "Mpango mbaya wa Gogu",
      "am": "የጎግ ክፉ ዕቅድ",
      "vi": "Kế hoạch gian ác của Gót",
      "ko": "곡의 악한 계획"
    },
    "EZK.38.17.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} shows {{deity_pronoun:his|His}} greatness",
      "sw": "{{divine_name:BWANA|Yahwe}} anaonyesha ukuu {{deity_pronoun:wake|Wake}}",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} ታላቅነቱን አሳየ",
      "vi": "{{divine_name:CHÚA|Gia-vê}} tỏ ra sự vĩ đại của {{deity_pronoun:ngài|Ngài}}",
      "ko": "{{divine_name:주|야훼}}께서 자신의 위대하심을 나타내시다"
    },
    "EZK.39.1.s1": {
      "en": "Gog's defeat",
      "sw": "Kushindwa kwa Gogu",
      "am": "የጎግ መሸነፍ",
      "vi": "Gót bị đánh bại",
      "ko": "곡의 패배"
    },
    "EZK.39.11.s1": {
      "en": "The burial of Gog's army",
      "sw": "Kuzikwa kwa jeshi la Gogu",
      "am": "የጎግ ሠራዊት መቀበር",
      "vi": "Chôn cất đạo quân của Gót",
      "ko": "곡의 군대를 묻다"
    },
    "EZK.39.17.s1": {
      "en": "The feast for the birds and beasts",
      "sw": "Karamu kwa ndege na wanyama",
      "am": "ለወፎችና ለአራዊት የተዘጋጀ ግብዣ",
      "vi": "Bữa tiệc cho chim chóc và thú vật",
      "ko": "새와 짐승을 위한 잔치"
    },
    "EZK.39.25.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} will restore Israel",
      "sw": "{{divine_name:BWANA|Yahwe}} atamrejesha Israeli",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} እስራኤልን ይመልሳል",
      "vi": "{{divine_name:CHÚA|Gia-vê}} sẽ phục hồi Y-sơ-ra-ên",
      "ko": "{{divine_name:주|야훼}}께서 이스라엘을 회복시키실 것이다"
    },
    "EZK.40.1.s1": {
      "en": "The vision of the new temple",
      "sw": "Maono ya hekalu jipya",
      "am": "የአዲሱ ቤተ መቅደስ ራእይ",
      "vi": "Khải tượng về đền thờ mới",
      "ko": "새 성전의 환상"
    },
    "EZK.41.1.s1": {
      "en": "The temple building",
      "sw": "Jengo la hekalu",
      "am": "የቤተ መቅደሱ ሕንፃ",
      "vi": "Tòa nhà đền thờ",
      "ko": "성전 건물"
    },
    "EZK.42.1.s1": {
      "en": "The priests' holy rooms",
      "sw": "Vyumba vitakatifu vya makuhani",
      "am": "የካህናቱ ቅዱሳን ክፍሎች",
      "vi": "Các phòng thánh của thầy tế lễ",
      "ko": "제사장들의 거룩한 방"
    },
    "EZK.43.1.s1": {
      "en": "The glory returns to the temple",
      "sw": "Utukufu unarudi hekaluni",
      "am": "ክብሩ ወደ ቤተ መቅደሱ ተመለሰ",
      "vi": "Vinh quang trở lại đền thờ",
      "ko": "영광이 성전으로 돌아오다"
    },
    "EZK.43.10.s1": {
      "en": "The design of the temple and the altar",
      "sw": "Mpango wa hekalu na madhabahu",
      "am": "የቤተ መቅደሱና የመሠዊያው ንድፍ",
      "vi": "Thiết kế của đền thờ và bàn thờ",
      "ko": "성전과 제단의 설계"
    },
    "EZK.44.1.s1": {
      "en": "The shut east gate",
      "sw": "Lango la mashariki lililofungwa",
      "am": "የተዘጋው የምሥራቅ በር",
      "vi": "Cổng phía đông bị đóng",
      "ko": "닫힌 동문"
    },
    "EZK.44.15.s1": {
      "en": "The priests descended from Zadok",
      "sw": "Makuhani wa uzao wa Sadoki",
      "am": "ከሳዶቅ ዘር የሆኑ ካህናት",
      "vi": "Các thầy tế lễ thuộc dòng dõi Xa-đốc",
      "ko": "사독의 후손인 제사장들"
    },
    "EZK.45.1.s1": {
      "en": "The holy portion of the land",
      "sw": "Fungu takatifu la nchi",
      "am": "የምድሪቱ ቅዱስ ድርሻ",
      "vi": "Phần đất thánh trong xứ",
      "ko": "그 땅의 거룩한 몫"
    },
    "EZK.45.9.s1": {
      "en": "Honest rulers and honest measures",
      "sw": "Watawala waaminifu na vipimo vya haki",
      "am": "ታማኝ ገዦችና ትክክለኛ መስፈሪያዎች",
      "vi": "Người cai trị ngay thẳng và đo lường trung thực",
      "ko": "정직한 통치자와 정직한 도량"
    },
    "EZK.45.18.s1": {
      "en": "The yearly festivals",
      "sw": "Sikukuu za kila mwaka",
      "am": "የየዓመቱ በዓላት",
      "vi": "Các kỳ lễ hằng năm",
      "ko": "해마다 지키는 절기"
    },
    "EZK.46.1.s1": {
      "en": "Offerings for Sabbaths and new moons",
      "sw": "Sadaka za Sabato na mwezi mpya",
      "am": "የሰንበትና የወር መባቻ መሥዋዕቶች",
      "vi": "Tế lễ cho ngày Sa-bát và ngày trăng mới",
      "ko": "안식일과 초하루의 제물"
    },
    "EZK.46.12.s1": {
      "en": "Freewill offerings and the daily offering",
      "sw": "Sadaka za hiari na sadaka ya kila siku",
      "am": "የፈቃድ መሥዋዕትና የዕለት መሥዋዕት",
      "vi": "Tế lễ tự nguyện và tế lễ hằng ngày",
      "ko": "자원 제물과 날마다 드리는 제물"
    },
    "EZK.46.16.s1": {
      "en": "The prince's land",
      "sw": "Nchi ya mkuu",
      "am": "የገዥው ምድር",
      "vi": "Đất của thủ lĩnh",
      "ko": "군주의 땅"
    },
    "EZK.46.20.s1": {
      "en": "The temple kitchens",
      "sw": "Majiko ya hekalu",
      "am": "የቤተ መቅደሱ ማብሰያዎች",
      "vi": "Các nhà bếp của đền thờ",
      "ko": "성전의 부엌"
    },
    "EZK.47.1.s1": {
      "en": "The river flowing from the temple",
      "sw": "Mto unaotiririka kutoka hekaluni",
      "am": "ከቤተ መቅደሱ የሚፈስ ወንዝ",
      "vi": "Dòng sông chảy ra từ đền thờ",
      "ko": "성전에서 흘러나오는 강"
    },
    "EZK.47.13.s1": {
      "en": "The borders of the land",
      "sw": "Mipaka ya nchi",
      "am": "የምድሪቱ ድንበሮች",
      "vi": "Ranh giới của xứ",
      "ko": "그 땅의 경계"
    },
    "EZK.48.1.s1": {
      "en": "The portions of the tribes",
      "sw": "Mafungu ya makabila",
      "am": "የነገዶቹ ድርሻዎች",
      "vi": "Phần đất của các chi tộc",
      "ko": "지파들의 몫"
    },
    "EZK.48.12.s1": {
      "en": "The Levites, the city and the prince",
      "sw": "Walawi, mji na mkuu",
      "am": "ሌዋውያን፣ ከተማዋና ገዥው",
      "vi": "Người Lê-vi, thành và thủ lĩnh",
      "ko": "레위 사람들과 성읍과 군주"
    },
    "EZK.48.30.s1": {
      "en": "The gates of the city",
      "sw": "Malango ya mji",
      "am": "የከተማዋ በሮች",
      "vi": "Các cổng thành",
      "ko": "성읍의 문들"
    }
  }
}
