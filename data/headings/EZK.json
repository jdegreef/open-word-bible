    "EZK.17.22.s1": {
      "en": "The tender shoot on the high mountain",
      "sw": "Chipukizi changa juu ya mlima mrefu",
      "am": "በረጅሙ ተራራ ላይ ያለ ለጋ ቀንበጥ",
      "vi": "Chồi non trên núi cao",
      "ko": "높은 산 위의 연한 가지"
