      "en": "A mortal and not a god",
      "sw": "Mwanadamu wala si mungu",
      "am": "ሰው እንጂ አምላክ አይደለም"
    },
    "EZK.28.11.s1": {
      "en": "A lament for the king of Tyre",
      "sw": "Maombolezo kwa ajili ya mfalme wa Tiro",
      "am": "ስለ ጢሮስ ንጉሥ የሚደረግ ሙሾ"
    },
    "EZK.28.20.s1": {
      "en": "Against Sidon",
      "sw": "Dhidi ya Sidoni",
      "am": "በሲዶና ላይ"
    },
    "EZK.28.25.s1": {
      "en": "Israel gathered and safe",
      "sw": "Israeli anakusanywa na kukaa salama",
      "am": "እስራኤል ተሰብስቦ በሰላም ተቀመጠ"
    },
    "EZK.29.1.s1": {
      "en": "Pharaoh, the great monster of the Nile",
      "sw": "Farao, joka kubwa la Nile",
      "am": "ፈርዖን፣ የዓባይ ታላቅ ዘንዶ"
    },
    "EZK.29.8.s1": {
      "en": "Egypt laid waste",
      "sw": "Misri inafanywa ukiwa",
      "am": "ግብፅ ባድማ ሆነች"
    },
    "EZK.29.13.s1": {
      "en": "A lowly kingdom",
      "sw": "Ufalme duni",
      "am": "የተዋረደ መንግሥት"
    },
    "EZK.29.17.s1": {
      "en": "Egypt as Nebuchadrezzar's wages",
      "sw": "Misri kama ujira wa Nebukadreza",
      "am": "ግብፅ ለናቡከደነፆር ደመወዝ"
    },
    "EZK.29.19.s1": {
      "en": "Pay for his army",
      "sw": "Malipo kwa jeshi lake",
      "am": "ለሠራዊቱ የሚከፈል ዋጋ"
    },
    "EZK.29.21.s1": {
      "en": "A horn for Israel",
      "sw": "Pembe kwa ajili ya Israeli",
      "am": "ለእስራኤል የሚበቅል ቀንድ"
    },
    "EZK.30.1.s1": {
      "en": "The day of {{divine_name:the LORD|Yahweh}} on Egypt",
      "sw": "Siku ya {{divine_name:BWANA|Yahwe}} juu ya Misri",
      "am": "በግብፅ ላይ {{divine_name:የእግዚአብሔር|የያህዌ}} ቀን"
    },
    "EZK.30.6.s1": {
      "en": "Egypt's helpers fall",
      "sw": "Wasaidizi wa Misri wanaanguka",
      "am": "የግብፅ ረዳቶች ወደቁ"
    },
    "EZK.30.10.s1": {
      "en": "By the hand of Babylon",
      "sw": "Kwa mkono wa Babeli",
      "am": "በባቢሎን እጅ"
    },
    "EZK.30.13.s1": {
      "en": "Judgment on Egypt's cities",
      "sw": "Hukumu juu ya miji ya Misri",
      "am": "በግብፅ ከተሞች ላይ የሚመጣ ፍርድ"
    },
    "EZK.30.20.s1": {
      "en": "Pharaoh's broken arm",
      "sw": "Mkono uliovunjika wa Farao",
      "am": "የፈርዖን የተሰበረ ክንድ"
    },
    "EZK.30.22.s1": {
      "en": "Both arms broken",
      "sw": "Mikono yote miwili imevunjika",
      "am": "ሁለቱም ክንዶች ተሰበሩ"
    },
    "EZK.31.1.s1": {
      "en": "A cedar in Lebanon",
      "sw": "Mwerezi katika Lebanoni",
      "am": "በሊባኖስ ያለ ዝግባ"
    },
    "EZK.31.10.s1": {
      "en": "The great tree cut down",
      "sw": "Mti mkubwa unakatwa",
      "am": "ታላቁ ዛፍ ተቈረጠ"
    },
    "EZK.31.15.s1": {
      "en": "Down to Sheol",
      "sw": "Kushuka Kuzimu",
      "am": "ወደ ሙታን ዓለም መውረድ"
    },
    "EZK.32.1.s1": {
      "en": "A lament for Pharaoh",
      "sw": "Maombolezo kwa ajili ya Farao",
      "am": "ስለ ፈርዖን የሚደረግ ሙሾ"
    },
    "EZK.32.11.s1": {
      "en": "The sword of Babylon",
      "sw": "Upanga wa Babeli",
      "am": "የባቢሎን ሰይፍ"
    },
    "EZK.32.17.s1": {
      "en": "Egypt among the fallen",
      "sw": "Misri kati ya walioanguka",
      "am": "ግብፅ ከወደቁት መካከል"
    },
    "EZK.33.1.s1": {
      "en": "The watchman's duty",
      "sw": "Wajibu wa mlinzi",
      "am": "የጠባቂው ኃላፊነት"
    },
    "EZK.33.7.s1": {
      "en": "Ezekiel is appointed watchman again",
      "sw": "Ezekieli anawekwa tena kuwa mlinzi",
      "am": "ሕዝቅኤል እንደ ገና ጠባቂ ሆኖ ተሾመ"
    },
    "EZK.33.10.s1": {
      "en": "Turn back and live",
      "sw": "Rudini mkaishi",
      "am": "ተመለሱ፤ በሕይወትም ኑሩ"
    },
    "EZK.33.12.s1": {
      "en": "Each person judged by their own ways",
      "sw": "Kila mtu anahukumiwa kwa njia zake",
      "am": "እያንዳንዱ እንደ መንገዱ ይፈረድበታል"
    },
    "EZK.33.23.s1": {
      "en": "The claim of those left in the ruins",
      "sw": "Madai ya wale walioachwa magofuni",
      "am": "በፍርስራሹ የቀሩት ሰዎች የይገባናል ጥያቄ"
    },
    "EZK.33.30.s1": {
      "en": "Hearers who do not act",
      "sw": "Wasikilizaji wasiotenda",
      "am": "የማይፈጽሙ ሰሚዎች"
    },
    "EZK.34.1.s1": {
      "en": "The shepherds who fed themselves",
      "sw": "Wachungaji waliojilisha wenyewe",
      "am": "ራሳቸውን የመገቡ እረኞች"
    },
    "EZK.34.11.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} will shepherd {{deity_pronoun:his|His}} flock",
      "sw": "{{divine_name:BWANA|Yahwe}} atalichunga kundi {{deity_pronoun:lake|Lake}}",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} መንጋውን ይጠብቃል"
    },
    "EZK.34.20.s1": {
      "en": "Judgment between sheep and sheep",
      "sw": "Hukumu kati ya kondoo na kondoo",
      "am": "በበግና በበግ መካከል የሚደረግ ፍርድ"
    },
    "EZK.35.1.s1": {
      "en": "A message against Mount Seir",
      "sw": "Ujumbe dhidi ya Mlima Seiri",
      "am": "በሴይር ተራራ ላይ የተነገረ መልእክት"
    },
    "EZK.36.1.s1": {
      "en": "Hope for the mountains of Israel",
      "sw": "Tumaini kwa milima ya Israeli",
      "am": "ለእስራኤል ተራሮች ተስፋ"
    },
    "EZK.36.16.s1": {
      "en": "For the sake of {{deity_pronoun:his|His}} holy name",
      "sw": "Kwa ajili ya jina {{deity_pronoun:lake|Lake}} takatifu",
      "am": "ስለ ቅዱስ ስሙ"
    },
    "EZK.36.22.s1": {
      "en": "A new heart and a new spirit",
      "sw": "Moyo mpya na roho mpya",
      "am": "አዲስ ልብና አዲስ መንፈስ"
    },
    "EZK.36.33.s1": {
      "en": "Like the garden of Eden",
      "sw": "Kama bustani ya Edeni",
      "am": "እንደ ኤደን የአትክልት ቦታ"
    },
    "EZK.37.1.s1": {
      "en": "The valley of dry bones",
      "sw": "Bonde la mifupa mikavu",
      "am": "የደረቁ አጥንቶች ሸለቆ"
    },
    "EZK.37.15.s1": {
      "en": "Two sticks become one",
      "sw": "Vijiti viwili vinakuwa kimoja",
      "am": "ሁለቱ እንጨቶች አንድ ሆኑ"
    },
    "EZK.38.1.s1": {
      "en": "Gog comes from the north",
      "sw": "Gogu anakuja kutoka kaskazini",
      "am": "ጎግ ከሰሜን መጣ"
    },
    "EZK.38.10.s1": {
      "en": "Gog's evil plan",
      "sw": "Mpango mbaya wa Gogu",
      "am": "የጎግ ክፉ ዕቅድ"
    },
    "EZK.38.17.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} shows {{deity_pronoun:his|His}} greatness",
      "sw": "{{divine_name:BWANA|Yahwe}} anaonyesha ukuu {{deity_pronoun:wake|Wake}}",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} ታላቅነቱን አሳየ"
    },
    "EZK.39.1.s1": {
      "en": "Gog's defeat",
      "sw": "Kushindwa kwa Gogu",
      "am": "የጎግ መሸነፍ"
    },
    "EZK.39.11.s1": {
      "en": "The burial of Gog's army",
      "sw": "Kuzikwa kwa jeshi la Gogu",
      "am": "የጎግ ሠራዊት መቀበር"
    },
    "EZK.39.17.s1": {
      "en": "The feast for the birds and beasts",
      "sw": "Karamu kwa ndege na wanyama",
      "am": "ለወፎችና ለአራዊት የተዘጋጀ ግብዣ"
    },
    "EZK.39.25.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} will restore Israel",
      "sw": "{{divine_name:BWANA|Yahwe}} atamrejesha Israeli",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} እስራኤልን ይመልሳል"
    },
    "EZK.40.1.s1": {
      "en": "The vision of the new temple",
      "sw": "Maono ya hekalu jipya",
      "am": "የአዲሱ ቤተ መቅደስ ራእይ"
    },
    "EZK.41.1.s1": {
      "en": "The temple building",
      "sw": "Jengo la hekalu",
      "am": "የቤተ መቅደሱ ሕንፃ"
    },
    "EZK.42.1.s1": {
      "en": "The priests' holy rooms",
      "sw": "Vyumba vitakatifu vya makuhani",
      "am": "የካህናቱ ቅዱሳን ክፍሎች"
    },
    "EZK.43.1.s1": {
      "en": "The glory returns to the temple",
      "sw": "Utukufu unarudi hekaluni",
      "am": "ክብሩ ወደ ቤተ መቅደሱ ተመለሰ"
    },
    "EZK.43.10.s1": {
      "en": "The design of the temple and the altar",
      "sw": "Mpango wa hekalu na madhabahu",
      "am": "የቤተ መቅደሱና የመሠዊያው ንድፍ"
    },
    "EZK.44.1.s1": {
      "en": "The shut east gate",
      "sw": "Lango la mashariki lililofungwa",
      "am": "የተዘጋው የምሥራቅ በር"
    },
    "EZK.44.15.s1": {
      "en": "The priests descended from Zadok",
      "sw": "Makuhani wa uzao wa Sadoki",
      "am": "ከሳዶቅ ዘር የሆኑ ካህናት"
    },
    "EZK.45.1.s1": {
      "en": "The holy portion of the land",
      "sw": "Fungu takatifu la nchi",
      "am": "የምድሪቱ ቅዱስ ድርሻ"
    },
    "EZK.45.9.s1": {
      "en": "Honest rulers and honest measures",
      "sw": "Watawala waaminifu na vipimo vya haki",
      "am": "ታማኝ ገዦችና ትክክለኛ መስፈሪያዎች"
    },
    "EZK.45.18.s1": {
      "en": "The yearly festivals",
      "sw": "Sikukuu za kila mwaka",
      "am": "የየዓመቱ በዓላት"
    },
    "EZK.46.1.s1": {
      "en": "Offerings for Sabbaths and new moons",
      "sw": "Sadaka za Sabato na mwezi mpya",
      "am": "የሰንበትና የወር መባቻ መሥዋዕቶች"
    },
    "EZK.46.12.s1": {
      "en": "Freewill offerings and the daily offering",
      "sw": "Sadaka za hiari na sadaka ya kila siku",
      "am": "የፈቃድ መሥዋዕትና የዕለት መሥዋዕት"
    },
    "EZK.46.16.s1": {
      "en": "The prince's land",
      "sw": "Nchi ya mkuu",
      "am": "የገዥው ምድር"
    },
    "EZK.46.20.s1": {
      "en": "The temple kitchens",
      "sw": "Majiko ya hekalu",
      "am": "የቤተ መቅደሱ ማብሰያዎች"
    },
    "EZK.47.1.s1": {
      "en": "The river flowing from the temple",
      "sw": "Mto unaotiririka kutoka hekaluni",
      "am": "ከቤተ መቅደሱ የሚፈስ ወንዝ"
    },
    "EZK.47.13.s1": {
      "en": "The borders of the land",
      "sw": "Mipaka ya nchi",
      "am": "የምድሪቱ ድንበሮች"
    },
    "EZK.48.1.s1": {
      "en": "The portions of the tribes",
      "sw": "Mafungu ya makabila",
      "am": "የነገዶቹ ድርሻዎች"
    },
    "EZK.48.12.s1": {
      "en": "The Levites, the city and the prince",
      "sw": "Walawi, mji na mkuu",
      "am": "ሌዋውያን፣ ከተማዋና ገዥው"
    },
    "EZK.48.30.s1": {
      "en": "The gates of the city",
      "sw": "Malango ya mji",
      "am": "የከተማዋ በሮች"
    }
  }
}
