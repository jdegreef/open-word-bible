      "ko": "이스라엘의 군주들을 위한 애가"
    },
    "EZK.19.10.s1": {
      "en": "The vine uprooted",
      "sw": "Mzabibu ulioong'olewa",
      "am": "የተነቀለው የወይን ግንድ",
      "vi": "Cây nho bị nhổ",
      "ko": "뽑힌 포도나무"
    },
    "EZK.20.1.s1": {
      "en": "Elders come to consult {{divine_name:the LORD|Yahweh}}",
      "sw": "Wazee wanakuja kumwuliza {{divine_name:BWANA|Yahwe}}",
      "am": "ሽማግሌዎች {{divine_name:እግዚአብሔርን|ያህዌን}} ሊጠይቁ መጡ",
      "vi": "Các trưởng lão đến cầu hỏi {{divine_name:CHÚA|Gia-vê}}",
      "ko": "장로들이 {{divine_name:주|야훼}}께 물으러 오다"
    },
    "EZK.20.27.s1": {
      "en": "Offerings on every high hill",
      "sw": "Sadaka juu ya kila kilima kirefu",
      "am": "በረጅሙ ኮረብታ ሁሉ ላይ የሚቀርብ መሥዋዕት",
      "vi": "Tế lễ trên mọi đồi cao",
      "ko": "높은 언덕마다 바친 제물"
    },
    "EZK.21.1.s1": {
      "en": "Fire in the forest of the south",
      "sw": "Moto katika msitu wa kusini",
      "am": "በደቡብ ጫካ ያለ እሳት",
      "vi": "Lửa trong rừng phương nam",
      "ko": "남쪽 숲의 불"
