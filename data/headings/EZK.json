    "EZK.18.1.s1": {
      "en": "The proverb of the sour grapes",
      "sw": "Methali ya zabibu chachu",
      "am": "የጎምዛዛው ወይን ምሳሌ",
      "vi": "Câu tục ngữ về trái nho chua",
      "ko": "신 포도 속담"
