      "am": "ፍጻሜው መጣ",
      "vi": "Sự cuối cùng đã đến",
      "ko": "끝이 왔다"
    },
    "EZK.7.23.s1": {
      "en": "Make a chain",
      "sw": "Tengeneza mnyororo",
      "am": "ሰንሰለት ሥራ",
