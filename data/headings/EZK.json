    "EZK.18.24.s1": {
      "en": "When the righteous turn away",
      "sw": "Wenye haki wanapogeuka",
      "am": "ጻድቃን ሲመለሱ",
      "vi": "Khi người công chính quay lưng",
      "ko": "의인이 등을 돌릴 때"
    },
    "EZK.18.27.s1": {
      "en": "Turn and live",
      "sw": "Geukeni mkaishi",
      "am": "ተመለሱ፤ በሕይወትም ኑሩ",
      "vi": "Hãy quay về và sống",
      "ko": "돌이켜 살아라"
    },
    "EZK.19.1.s1": {
      "en": "A lament for the princes of Israel",
      "sw": "Maombolezo kwa ajili ya wakuu wa Israeli",
      "am": "ለእስራኤል መሳፍንት የሚደረግ ሙሾ",
