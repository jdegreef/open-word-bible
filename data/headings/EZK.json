    "EZK.18.5.s1": {
      "en": "A righteous man, his son and his grandson",
      "sw": "Mtu mwenye haki, mwanawe na mjukuu wake",
      "am": "ጻድቅ ሰው፣ ልጁና የልጅ ልጁ",
