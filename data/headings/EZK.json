      "am": "የእንቆቅልሹ ትርጉም",
      "vi": "Câu đố được giải thích",
      "ko": "수수께끼의 풀이"
    },
    "EZK.17.19.s1": {
      "en": "Punishment for the broken oath",
      "sw": "Adhabu kwa kiapo kilichovunjwa",
      "am": "ስለ ተሻረው መሐላ የሚመጣ ቅጣት",
