      "am": "ለፀሐይ መስገድ",
      "vi": "Cúi lạy mặt trời",
      "ko": "해에게 절하다"
    },
    "EZK.9.1.s1": {
      "en": "Six men with weapons",
      "sw": "Watu sita wenye silaha",
      "am": "የጦር መሣሪያ የያዙ ስድስት ሰዎች",
      "vi": "Sáu người cầm vũ khí",
      "ko": "무기를 든 여섯 사람"
