      "en": "Moab's ruin",
      "sw": "Maangamizi ya Moabu",
      "am": "የሞዓብ ጥፋት"
    },
    "JER.48.40.s1": {
      "en": "An eagle over Moab",
      "sw": "Tai juu ya Moabu",
      "am": "በሞዓብ ላይ የሚበር ንስር"
