    "JER.14.19.s1": {
      "en": "Have you rejected Judah?",
      "sw": "Je, umemkataa Yuda?",
      "am": "ይሁዳን ጣልከውን?"
    },
    "JER.15.1.s1": {
      "en": "Not even Moses and Samuel",
      "sw": "Hata Musa na Samweli hawangefaa",
      "am": "ሙሴና ሳሙኤል እንኳ ቢቆሙ"
    },
    "JER.15.10.s1": {
      "en": "Woe is me, my mother",
      "sw": "Ole wangu, mama yangu",
      "am": "እናቴ ሆይ፣ ወዮልኝ"
    },
    "JER.15.19.s1": {
      "en": "If you return",
      "sw": "Ukirudi",
      "am": "ብትመለስ"
    },
    "JER.16.1.s1": {
      "en": "Jeremiah is not to marry",
      "sw": "Yeremia hapaswi kuoa",
      "am": "ኤርምያስ እንዳያገባ ታዘዘ"
    },
    "JER.16.14.s1": {
      "en": "Brought back from the north",
      "sw": "Kurudishwa kutoka kaskazini",
      "am": "ከሰሜን መመለስ"
