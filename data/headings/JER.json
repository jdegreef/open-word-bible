      "vi": "Giê-rê-mi đập vỡ cái bình",
      "ko": "예레미야가 병을 깨뜨리다"
    },
    "JER.20.1.s1": {
      "en": "Pashhur puts Jeremiah in the stocks",
      "sw": "Pashuri anamtia Yeremia katika mkatale",
      "am": "ፋስኮር ኤርምያስን በግንድ አጣበቀው",
      "vi": "Pha-su-rơ cùm Giê-rê-mi",
      "ko": "바스훌이 예레미야를 차꼬에 채우다"
    },
    "JER.20.7.s1": {
      "en": "Like a fire in my bones",
      "sw": "Kama moto ndani ya mifupa yangu",
      "am": "በአጥንቶቼ ውስጥ እንዳለ እሳት",
      "vi": "Như lửa trong xương cốt tôi",
      "ko": "내 뼛속의 불처럼"
    },
    "JER.20.14.s1": {
      "en": "Why was I born?",
      "sw": "Kwa nini nilizaliwa?",
      "am": "ለምን ተወለድኩ?",
      "vi": "Sao tôi lại được sinh ra?",
      "ko": "어찌하여 내가 태어났던가?"
    },
    "JER.21.1.s1": {
      "en": "Zedekiah sends to Jeremiah",
      "sw": "Sedekia anatuma watu kwa Yeremia",
      "am": "ሴዴቅያስ ወደ ኤርምያስ ሰዎችን ላከ",
      "vi": "Sê-đê-kia sai người đến gặp Giê-rê-mi",
      "ko": "시드기야가 예레미야에게 사람을 보내다"
    },
    "JER.21.11.s1": {
      "en": "To the royal house of Judah",
      "sw": "Kwa nyumba ya kifalme ya Yuda",
      "am": "ለይሁዳ ንጉሣዊ ቤት",
      "vi": "Gửi hoàng tộc Giu-đa",
      "ko": "유다 왕실에게"
    },
    "JER.22.1.s1": {
      "en": "A word for the palace of Judah",
      "sw": "Neno kwa ikulu ya Yuda",
      "am": "ለይሁዳ ቤተ መንግሥት የተነገረ ቃል",
      "vi": "Lời cho cung điện Giu-đa",
      "ko": "유다 왕궁에 주신 말씀"
    },
    "JER.22.10.s1": {
      "en": "Shallum will not return",
      "sw": "Shalumu hatarudi",
      "am": "ሰሎም አይመለስም",
      "vi": "Sa-lum sẽ không trở về",
      "ko": "살룸은 돌아오지 못할 것이다"
    },
    "JER.22.13.s1": {
      "en": "A palace built by injustice",
      "sw": "Ikulu iliyojengwa kwa udhalimu",
      "am": "በግፍ የተሠራ ቤተ መንግሥት",
      "vi": "Cung điện xây bằng sự bất công",
      "ko": "불의로 지은 왕궁"
    },
    "JER.23.1.s1": {
      "en": "Shepherds who scatter the flock",
      "sw": "Wachungaji wanaotawanya kundi",
      "am": "መንጋውን የሚበትኑ እረኞች",
      "vi": "Những người chăn làm tan tác bầy chiên",
      "ko": "양 떼를 흩어 버리는 목자들"
    },
    "JER.23.5.s1": {
      "en": "A Branch for David",
      "sw": "Chipukizi kwa ajili ya Daudi",
      "am": "ለዳዊት የሚበቅል ቅርንጫፍ",
      "vi": "Một Chồi cho Đa-vít",
      "ko": "다윗에게서 돋을 싹"
    },
    "JER.23.9.s1": {
      "en": "Concerning the prophets",
      "sw": "Kuhusu manabii",
      "am": "ስለ ነቢያት",
      "vi": "Về các tiên tri",
      "ko": "예언자들에 관하여"
    },
    "JER.24.1.s1": {
      "en": "Two baskets set before the temple",
      "sw": "Vikapu viwili vilivyowekwa mbele ya hekalu",
      "am": "በቤተ መቅደሱ ፊት የተቀመጡ ሁለት ቅርጫቶች",
      "vi": "Hai giỏ đặt trước đền thờ",
      "ko": "성전 앞에 놓인 두 바구니"
    },
    "JER.25.1.s1": {
      "en": "Twenty-three years of warnings",
      "sw": "Miaka ishirini na mitatu ya maonyo",
      "am": "የሃያ ሦስት ዓመት ማስጠንቀቂያ",
      "vi": "Hai mươi ba năm cảnh cáo",
      "ko": "이십삼 년 동안의 경고"
    },
    "JER.25.15.s1": {
      "en": "The cup of wine",
      "sw": "Kikombe cha divai",
      "am": "የወይን ጠጅ ጽዋ",
      "vi": "Chén rượu",
      "ko": "포도주 잔"
    },
    "JER.25.32.s1": {
      "en": "Disaster spreads to the nations",
      "sw": "Maafa yanaenea kwa mataifa",
      "am": "ጥፋት ወደ አሕዛብ ይዛመታል",
      "vi": "Tai họa lan đến các dân tộc",
      "ko": "재앙이 민족들에게 퍼지다"
    },
    "JER.26.1.s1": {
      "en": "Jeremiah's sermon in the temple",
      "sw": "Hotuba ya Yeremia hekaluni",
      "am": "ኤርምያስ በቤተ መቅደስ ያደረገው ንግግር",
      "vi": "Bài giảng của Giê-rê-mi trong đền thờ",
      "ko": "성전에서 전한 예레미야의 설교"
    },
    "JER.26.7.s1": {
      "en": "Jeremiah on trial for his life",
      "sw": "Yeremia anashtakiwa kwa ajili ya uhai wake",
      "am": "ኤርምያስ በሞት ፍርድ ተከሰሰ",
      "vi": "Giê-rê-mi bị xét xử tội chết",
      "ko": "예레미야가 목숨을 건 재판을 받다"
    },
    "JER.26.16.s1": {
      "en": "The officials refuse to condemn Jeremiah",
      "sw": "Maafisa wanakataa kumhukumu Yeremia",
      "am": "ሹማምንቱ ኤርምያስን ለመኰነን እንቢ አሉ",
      "vi": "Các quan chức từ chối kết án Giê-rê-mi",
      "ko": "관리들이 예레미야를 정죄하기를 거부하다"
    },
    "JER.27.1.s1": {
      "en": "Bend your necks under Babylon's yoke",
      "sw": "Inamisheni shingo zenu chini ya nira ya Babeli",
      "am": "አንገታችሁን ከባቢሎን ቀንበር በታች ዝቅ አድርጉ",
      "vi": "Hãy cúi cổ dưới ách Ba-by-lôn",
      "ko": "바빌론의 멍에 아래 목을 숙여라"
    },
    "JER.28.1.s1": {
      "en": "Hananiah breaks the yoke",
      "sw": "Hanania anavunja nira",
      "am": "ሐናንያ ቀንበሩን ሰበረ",
      "vi": "Ha-na-nia bẻ gãy cái ách",
      "ko": "하나냐가 멍에를 꺾다"
    },
    "JER.28.12.s1": {
      "en": "A yoke of iron",
      "sw": "Nira ya chuma",
      "am": "የብረት ቀንበር",
      "vi": "Ách bằng sắt",
      "ko": "쇠 멍에"
    },
    "JER.29.1.s1": {
      "en": "A letter to the people in exile",
      "sw": "Barua kwa watu walio uhamishoni",
      "am": "በምርኮ ላሉት የተላከ ደብዳቤ",
      "vi": "Thư gửi những người bị lưu đày",
      "ko": "포로로 잡혀간 사람들에게 보낸 편지"
    },
    "JER.29.24.s1": {
      "en": "A message for Shemaiah",
      "sw": "Ujumbe kwa Shemaya",
      "am": "ለሸማያ የተላከ መልእክት",
      "vi": "Sứ điệp cho Sê-ma-gia",
      "ko": "스마야에게 전하는 말씀"
    },
    "JER.30.1.s1": {
      "en": "The exiles will come home",
      "sw": "Waliohamishwa watarudi nyumbani",
      "am": "ምርኮኞቹ ወደ ቤታቸው ይመለሳሉ",
      "vi": "Những người lưu đày sẽ trở về quê hương",
      "ko": "포로들이 고향으로 돌아올 것이다"
    },
    "JER.30.12.s1": {
      "en": "Healing for an incurable wound",
      "sw": "Uponyaji kwa jeraha lisilotibika",
      "am": "ለማይፈወስ ቁስል ፈውስ",
      "vi": "Chữa lành vết thương không thể chữa",
      "ko": "고칠 수 없는 상처의 치유"
    },
    "JER.31.2.s1": {
      "en": "Loved with an everlasting love",
      "sw": "Kupendwa kwa upendo wa milele",
      "am": "በዘላለም ፍቅር መወደድ",
      "vi": "Được yêu bằng tình yêu đời đời",
      "ko": "영원한 사랑으로 사랑받다"
    },
    "JER.31.15.s1": {
      "en": "Rachel weeping for her children",
      "sw": "Raheli anawalilia watoto wake",
      "am": "ራሔል ለልጆቿ አለቀሰች",
      "vi": "Ra-chên khóc thương con cái mình",
      "ko": "자식들 때문에 우는 라헬"
    },
    "JER.31.31.s1": {
      "en": "A new covenant",
      "sw": "Agano jipya",
      "am": "አዲስ ቃል ኪዳን",
      "vi": "Một giao ước mới",
      "ko": "새 언약"
    },
    "JER.32.1.s1": {
      "en": "Jeremiah buys his cousin's field",
      "sw": "Yeremia ananunua shamba la binamu yake",
      "am": "ኤርምያስ የአጎቱን ልጅ እርሻ ገዛ",
      "vi": "Giê-rê-mi mua cánh đồng của người anh em họ",
      "ko": "예레미야가 사촌의 밭을 사다"
    },
    "JER.32.16.s1": {
      "en": "Jeremiah prays",
      "sw": "Yeremia anaomba",
      "am": "ኤርምያስ ጸለየ",
      "vi": "Giê-rê-mi cầu nguyện",
      "ko": "예레미야가 기도하다"
    },
    "JER.32.36.s1": {
      "en": "An everlasting covenant",
      "sw": "Agano la milele",
      "am": "የዘላለም ቃል ኪዳን",
      "vi": "Một giao ước đời đời",
      "ko": "영원한 언약"
    },
    "JER.33.1.s1": {
      "en": "Healing for the city",
      "sw": "Uponyaji kwa mji",
      "am": "ለከተማዋ ፈውስ",
      "vi": "Chữa lành cho thành",
      "ko": "성읍의 치유"
    },
    "JER.33.14.s1": {
      "en": "The righteous Branch",
      "sw": "Chipukizi la haki",
      "am": "ጻድቁ ቅርንጫፍ",
      "vi": "Chồi công chính",
      "ko": "의로운 싹"
    },
    "JER.33.19.s1": {
      "en": "The covenant with day and night",
      "sw": "Agano na mchana na usiku",
      "am": "ከቀንና ከሌሊት ጋር የተደረገ ቃል ኪዳን",
      "vi": "Giao ước với ngày và đêm",
      "ko": "낮과 밤에 관한 언약"
    },
    "JER.34.1.s1": {
      "en": "A message for King Zedekiah",
      "sw": "Ujumbe kwa Mfalme Sedekia",
      "am": "ለንጉሥ ሴዴቅያስ የተነገረ መልእክት",
      "vi": "Sứ điệp cho vua Sê-đê-kia",
      "ko": "시드기야 왕에게 전하는 말씀"
    },
    "JER.34.8.s1": {
      "en": "Freed slaves taken back",
      "sw": "Watumwa walioachiliwa wanachukuliwa tena",
      "am": "ነጻ የወጡ ባሪያዎች ተመልሰው ተያዙ",
      "vi": "Nô lệ đã được trả tự do bị bắt lại",
      "ko": "풀어 준 종들을 다시 붙잡다"
    },
    "JER.35.1.s1": {
      "en": "The Rechabites keep their ancestor's command",
      "sw": "Warekabu wanashika amri ya baba yao wa zamani",
      "am": "ሬካባውያን የአባታቸውን ትእዛዝ ጠበቁ",
      "vi": "Gia tộc Rê-cáp giữ lời dặn của tổ phụ",
      "ko": "레갑 집안이 조상의 명령을 지키다"
    },
    "JER.36.1.s1": {
      "en": "Baruch writes and reads the scroll",
      "sw": "Baruku anaandika na kusoma gombo",
      "am": "ባሮክ ጥቅልሉን ጽፎ አነበበ",
      "vi": "Ba-rúc viết và đọc cuộn sách",
      "ko": "바룩이 두루마리를 쓰고 읽다"
    },
    "JER.36.19.s1": {
      "en": "The king burns the scroll",
      "sw": "Mfalme anachoma gombo",
      "am": "ንጉሡ ጥቅልሉን አቃጠለ",
      "vi": "Vua đốt cuộn sách",
      "ko": "왕이 두루마리를 태우다"
    },
    "JER.36.27.s1": {
      "en": "The scroll is written again",
      "sw": "Gombo linaandikwa tena",
      "am": "ጥቅልሉ እንደ ገና ተጻፈ",
      "vi": "Cuộn sách được viết lại",
      "ko": "두루마리를 다시 쓰다"
    },
    "JER.37.1.s1": {
      "en": "Zedekiah asks Jeremiah to pray",
      "sw": "Sedekia anamwomba Yeremia aombe",
      "am": "ሴዴቅያስ ኤርምያስን እንዲጸልይ ለመነው",
      "vi": "Sê-đê-kia xin Giê-rê-mi cầu nguyện",
      "ko": "시드기야가 예레미야에게 기도를 부탁하다"
    },
    "JER.37.12.s1": {
      "en": "Jeremiah is arrested",
      "sw": "Yeremia anakamatwa",
      "am": "ኤርምያስ ተያዘ",
      "vi": "Giê-rê-mi bị bắt",
      "ko": "예레미야가 체포되다"
    },
    "JER.37.17.s1": {
      "en": "Zedekiah questions Jeremiah in secret",
      "sw": "Sedekia anamhoji Yeremia kwa siri",
      "am": "ሴዴቅያስ ኤርምያስን በስውር ጠየቀው",
      "vi": "Sê-đê-kia bí mật hỏi Giê-rê-mi",
      "ko": "시드기야가 예레미야에게 몰래 묻다"
    },
    "JER.38.1.s1": {
      "en": "Jeremiah is lowered into a cistern",
      "sw": "Yeremia anashushwa ndani ya birika",
      "am": "ኤርምያስ ወደ ጉድጓድ ተጣለ",
      "vi": "Giê-rê-mi bị thả xuống hầm chứa nước",
      "ko": "예레미야가 웅덩이에 내려지다"
    },
    "JER.38.14.s1": {
      "en": "Zedekiah questions Jeremiah again",
      "sw": "Sedekia anamhoji Yeremia tena",
      "am": "ሴዴቅያስ ኤርምያስን ደግሞ ጠየቀው",
      "vi": "Sê-đê-kia lại hỏi Giê-rê-mi",
      "ko": "시드기야가 다시 예레미야에게 묻다"
    },
    "JER.39.1.s1": {
      "en": "Babylon captures Jerusalem",
      "sw": "Babeli inauteka Yerusalemu",
      "am": "ባቢሎን ኢየሩሳሌምን ያዘች",
      "vi": "Ba-by-lôn chiếm Giê-ru-sa-lem",
      "ko": "바빌론이 예루살렘을 함락하다"
    },
    "JER.39.15.s1": {
      "en": "A promise for Ebed-melech",
      "sw": "Ahadi kwa Ebed-meleki",
      "am": "ለአቤሜሌክ የተሰጠ ተስፋ",
      "vi": "Lời hứa cho Ê-bết-Mê-léc",
      "ko": "에벳멜렉에게 주신 약속"
    },
    "JER.40.1.s1": {
      "en": "Jeremiah freed at Ramah",
      "sw": "Yeremia anaachiliwa huru huko Rama",
      "am": "ኤርምያስ በራማ ነጻ ተለቀቀ",
      "vi": "Giê-rê-mi được thả tại Ra-ma",
      "ko": "예레미야가 라마에서 풀려나다"
    },
    "JER.40.7.s1": {
      "en": "Gedaliah at Mizpah",
      "sw": "Gedalia huko Mizpa",
      "am": "ጎዶልያስ በምጽጳ",
      "vi": "Ghê-đa-lia tại Mích-pa",
      "ko": "미스바의 그다랴"
    },
    "JER.41.1.s1": {
      "en": "Ishmael kills Gedaliah",
      "sw": "Ishmaeli anamwua Gedalia",
      "am": "እስማኤል ጎዶልያስን ገደለ",
      "vi": "Ích-ma-ên giết Ghê-đa-lia",
      "ko": "이스마엘이 그다랴를 죽이다"
    },
    "JER.41.11.s1": {
      "en": "Johanan brings the captives back",
      "sw": "Yohana anawarudisha mateka",
      "am": "ዮሐናን ምርኮኞቹን መለሰ",
      "vi": "Giô-ha-nan đem những người bị bắt về",
      "ko": "요하난이 포로들을 되찾아 오다"
    },
    "JER.42.1.s1": {
      "en": "The leaders ask for a word",
      "sw": "Viongozi wanaomba neno",
      "am": "መሪዎቹ ቃል እንዲሰጣቸው ለመኑ",
      "vi": "Các thủ lãnh xin một lời",
      "ko": "지도자들이 말씀을 구하다"
    },
    "JER.42.7.s1": {
      "en": "Stay in the land; do not go to Egypt",
      "sw": "Kaeni katika nchi; msiende Misri",
      "am": "በምድሪቱ ተቀመጡ፤ ወደ ግብፅ አትሂዱ",
      "vi": "Hãy ở lại trong xứ; đừng đi Ai Cập",
      "ko": "이 땅에 머물고 이집트로 가지 마라"
    },
    "JER.43.1.s1": {
      "en": "Into Egypt against the warning",
      "sw": "Kwenda Misri kinyume cha onyo",
      "am": "ማስጠንቀቂያውን ጥሰው ወደ ግብፅ ሄዱ",
      "vi": "Đi Ai Cập bất chấp lời cảnh cáo",
      "ko": "경고를 무시하고 이집트로 가다"
    },
    "JER.43.8.s1": {
      "en": "Stones hidden at Tahpanhes",
      "sw": "Mawe yaliyofichwa huko Tahpanhesi",
      "am": "በጣፍኔስ የተቀበሩ ድንጋዮች",
      "vi": "Những hòn đá giấu tại Tác-pha-nết",
      "ko": "다바네스에 숨긴 돌들"
    },
    "JER.44.1.s1": {
      "en": "Judeans in Egypt warned",
      "sw": "Wayahudi walio Misri wanaonywa",
      "am": "በግብፅ ያሉ አይሁድ ተጠነቀቁ",
      "vi": "Lời cảnh cáo người Giu-đa ở Ai Cập",
      "ko": "이집트에 사는 유다 사람들에게 주는 경고"
    },
    "JER.44.15.s1": {
      "en": "Incense for the queen of heaven",
      "sw": "Uvumba kwa malkia wa mbinguni",
      "am": "ለሰማይ ንግሥት የሚጤስ ዕጣን",
      "vi": "Dâng hương cho Nữ Vương trên trời",
      "ko": "하늘의 여왕에게 바치는 분향"
    },
    "JER.45.1.s1": {
      "en": "A promise to Baruch",
      "sw": "Ahadi kwa Baruku",
      "am": "ለባሮክ የተሰጠ ተስፋ",
      "vi": "Lời hứa cho Ba-rúc",
      "ko": "바룩에게 주신 약속"
    },
    "JER.46.1.s1": {
      "en": "Egypt's army at Carchemish",
      "sw": "Jeshi la Misri huko Karkemishi",
      "am": "የግብፅ ሠራዊት በከርከሚሽ",
      "vi": "Quân đội Ai Cập tại Cạt-kê-mít",
      "ko": "갈그미스의 이집트 군대"
    },
    "JER.46.13.s1": {
      "en": "Egypt will be struck",
      "sw": "Misri itapigwa",
      "am": "ግብፅ ትመታለች",
      "vi": "Ai Cập sẽ bị đánh",
      "ko": "이집트가 공격을 받을 것이다"
    },
    "JER.46.27.s1": {
      "en": "Comfort for Jacob",
      "sw": "Faraja kwa Yakobo",
      "am": "ለያዕቆብ መጽናናት",
      "vi": "An ủi cho Gia-cốp",
      "ko": "야곱을 향한 위로"
    },
    "JER.47.1.s1": {
      "en": "The Philistines",
      "sw": "Wafilisti",
      "am": "ፍልስጥኤማውያን",
      "vi": "Người Phi-li-tin",
      "ko": "블레셋 사람들"
    },
    "JER.48.1.s1": {
      "en": "Moab's ruin",
      "sw": "Maangamizi ya Moabu",
      "am": "የሞዓብ ጥፋት",
      "vi": "Sự sụp đổ của Mô-áp",
      "ko": "모압의 멸망"
    },
    "JER.48.40.s1": {
      "en": "An eagle over Moab",
      "sw": "Tai juu ya Moabu",
      "am": "በሞዓብ ላይ የሚበር ንስር",
      "vi": "Chim đại bàng trên Mô-áp",
      "ko": "모압 위의 독수리"
    },
    "JER.49.1.s1": {
      "en": "Ammon",
      "sw": "Waamoni",
      "am": "አሞናውያን",
      "vi": "Am-môn",
      "ko": "암몬"
    },
    "JER.49.7.s1": {
      "en": "Edom",
      "sw": "Edomu",
      "am": "ኤዶም",
      "vi": "Ê-đôm",
      "ko": "에돔"
    },
    "JER.49.23.s1": {
      "en": "Damascus, Kedar and Elam",
      "sw": "Dameski, Kedari na Elamu",
      "am": "ደማስቆ፣ ቄዳርና ኤላም",
      "vi": "Đa-mách, Kê-đa và Ê-lam",
      "ko": "다메섹과 게달과 엘람"
    },
    "JER.50.1.s1": {
      "en": "Babylon's fall",
      "sw": "Kuanguka kwa Babeli",
      "am": "የባቢሎን መውደቅ",
      "vi": "Sự sụp đổ của Ba-by-lôn",
      "ko": "바빌론의 몰락"
    },
    "JER.50.17.s1": {
      "en": "Israel brought home",
      "sw": "Israeli anarudishwa nyumbani",
      "am": "እስራኤል ወደ ቤቱ ተመለሰ",
      "vi": "Y-sơ-ra-ên được đem về quê hương",
      "ko": "고향으로 돌아오는 이스라엘"
    },
    "JER.50.33.s1": {
      "en": "The strong Redeemer",
      "sw": "Mkombozi mwenye nguvu",
      "am": "ብርቱው ቤዢ",
      "vi": "Đấng Cứu Chuộc mạnh mẽ",
      "ko": "강하신 구속자"
    },
    "JER.51.1.s1": {
      "en": "A destroying wind",
      "sw": "Upepo unaoangamiza",
      "am": "የሚያጠፋ ነፋስ",
      "vi": "Ngọn gió hủy diệt",
      "ko": "멸망시키는 바람"
    },
    "JER.51.59.s1": {
      "en": "Seraiah's scroll in the Euphrates",
      "sw": "Gombo la Seraya katika Frati",
      "am": "የሠራያ ጥቅልል በኤፍራጥስ ውስጥ",
      "vi": "Cuộn sách của Sê-ra-gia dưới sông Ơ-phơ-rát",
      "ko": "유프라테스 강에 던진 스라야의 두루마리"
    },
    "JER.52.1.s1": {
      "en": "Jerusalem falls to Babylon",
      "sw": "Yerusalemu inaangukia Babeli",
      "am": "ኢየሩሳሌም በባቢሎን እጅ ወደቀች",
      "vi": "Giê-ru-sa-lem rơi vào tay Ba-by-lôn",
      "ko": "예루살렘이 바빌론에 함락되다"
    },
    "JER.52.31.s1": {
      "en": "Kindness to Jehoiachin",
      "sw": "Fadhili kwa Yehoyakini",
      "am": "ለዮአኪን የተደረገ ሞገስ",
      "vi": "Ân huệ dành cho Giê-hô-gia-kin",
      "ko": "여호야긴이 받은 호의"
    }
  }
}
