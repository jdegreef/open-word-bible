      "sw": "Je, mke aliyepewa talaka anaweza kurudi?",
      "am": "የተፈታች ሚስት ልትመለስ ትችላለችን?"
    },
    "JER.3.6.s1": {
      "en": "Faithless Israel and treacherous Judah",
      "sw": "Israeli asiye mwaminifu na Yuda msaliti",
      "am": "ከዳተኛዪቱ እስራኤልና አታላዪቱ ይሁዳ"
    },
    "JER.3.11.s1": {
      "en": "Return, faithless people",
      "sw": "Rudini, enyi watu msio waaminifu",
      "am": "እናንተ ከዳተኞች፣ ተመለሱ"
    },
    "JER.4.1.s1": {
      "en": "If you return, Israel",
      "sw": "Ukirudi, Israeli",
      "am": "እስራኤል ሆይ፣ ብትመለስ"
    },
    "JER.4.3.s1": {
      "en": "Plow up your unplowed ground",
      "sw": "Limeni mashamba yenu yasiyolimwa",
      "am": "ያልታረሰውን መሬታችሁን አርሱ"
    },
    "JER.4.19.s1": {
      "en": "Anguish at the sound of war",
      "sw": "Uchungu kwa sauti ya vita",
      "am": "በጦርነት ድምፅ የተነሣ ጭንቀት"
    },
    "JER.5.1.s1": {
      "en": "Search for one who acts justly",
      "sw": "Mtafuteni mtu mmoja atendaye haki",
      "am": "ፍትሕን የሚያደርግ አንድ ሰው ፈልጉ"
    },
    "JER.5.14.s1": {
      "en": "A nation from far away",
      "sw": "Taifa kutoka mbali",
      "am": "ከሩቅ የሚመጣ ሕዝብ"
    },
    "JER.5.20.s1": {
      "en": "A stubborn and rebellious people",
      "sw": "Watu wakaidi na waasi",
      "am": "እልከኛና ዓመፀኛ ሕዝብ"
    },
    "JER.6.1.s1": {
      "en": "Flee from Jerusalem",
      "sw": "Kimbieni kutoka Yerusalemu",
      "am": "ከኢየሩሳሌም ሽሹ"
    },
    "JER.6.16.s1": {
      "en": "The age-old paths",
      "sw": "Mapito ya zamani",
      "am": "የጥንቱ መንገዶች"
    },
    "JER.6.22.s1": {
      "en": "An army from the land of the north",
      "sw": "Jeshi kutoka nchi ya kaskazini",
      "am": "ከሰሜን ምድር የሚመጣ ሠራዊት"
    },
    "JER.7.1.s1": {
      "en": "The message at the temple gate",
      "sw": "Ujumbe kwenye lango la hekalu",
      "am": "በቤተ መቅደሱ በር የተነገረ መልእክት"
    },
    "JER.7.21.s1": {
      "en": "Obey my voice",
      "sw": "Itiini sauti {{deity_pronoun:yangu|Yangu}}",
      "am": "ድምፄን ስሙ"
    },
    "JER.7.29.s1": {
      "en": "The Valley of Slaughter",
      "sw": "Bonde la Machinjo",
      "am": "የዕርድ ሸለቆ"
    },
    "JER.8.4.s1": {
      "en": "A people who will not turn back",
      "sw": "Watu wasiotaka kurudi",
      "am": "ለመመለስ እንቢ ያለ ሕዝብ"
    },
    "JER.8.18.s1": {
      "en": "Is there no balm in Gilead?",
      "sw": "Je, hakuna zeri huko Gileadi?",
      "am": "በገለዓድ በለሳን የለምን?"
    },
    "JER.9.3.s1": {
      "en": "Do not trust any neighbor",
      "sw": "Msimwamini jirani yeyote",
      "am": "ማንኛውንም ባልንጀራ አትመኑ"
    },
    "JER.9.16.s1": {
      "en": "Call for the mourning women",
      "sw": "Waiteni wanawake waombolezaji",
      "am": "አልቃሾቹን ሴቶች አስጠሩ"
    },
    "JER.9.22.s1": {
      "en": "Let the one who boasts boast in this",
      "sw": "Anayejisifu na ajisifu kwa hili",
      "am": "የሚመካ በዚህ ይመካ"
    },
    "JER.10.1.s1": {
      "en": "The idols and the living God",
      "sw": "Sanamu na Mungu aliye hai",
      "am": "ጣዖታትና ሕያው አምላክ"
    },
    "JER.10.17.s1": {
      "en": "Pack your bundle for exile",
      "sw": "Fungeni mizigo yenu kwa ajili ya uhamisho",
      "am": "ለምርኮ ጓዛችሁን አሰናዱ"
    },
    "JER.10.23.s1": {
      "en": "A prayer for just correction",
      "sw": "Sala ya kuadhibiwa kwa haki",
      "am": "በፍትሕ እንዲቀጣ የቀረበ ጸሎት"
    },
    "JER.11.1.s1": {
      "en": "The words of this covenant",
      "sw": "Maneno ya agano hili",
      "am": "የዚህ ቃል ኪዳን ቃሎች"
    },
    "JER.11.18.s1": {
      "en": "The men of Anathoth seek Jeremiah's life",
      "sw": "Watu wa Anathothi wanatafuta uhai wa Yeremia",
      "am": "የዓናቶት ሰዎች የኤርምያስን ሕይወት ፈለጉ"
    },
    "JER.12.1.s1": {
      "en": "Why does the way of the wicked succeed?",
      "sw": "Kwa nini njia ya waovu inafanikiwa?",
      "am": "የክፉዎች መንገድ ለምን ይቃናል?"
    },
    "JER.12.7.s1": {
      "en": "I have left my house",
      "sw": "Nimeiacha nyumba {{deity_pronoun:yangu|Yangu}}",
      "am": "ቤቴን ትቻለሁ"
    },
    "JER.12.14.s1": {
      "en": "Uprooted and brought back",
      "sw": "Kung'olewa na kurudishwa",
      "am": "መነቀልና መመለስ"
    },
    "JER.13.1.s1": {
      "en": "The ruined loincloth",
      "sw": "Kitambaa cha kiunoni kilichoharibika",
      "am": "የተበላሸው መታጠቂያ"
    },
    "JER.13.15.s1": {
      "en": "Do not be proud",
      "sw": "Msiwe na kiburi",
      "am": "አትታበዩ"
    },
    "JER.13.18.s1": {
      "en": "To the king and the queen mother",
      "sw": "Kwa mfalme na mama wa mfalme",
      "am": "ለንጉሡና ለንግሥት እናቱ"
    },
    "JER.14.1.s1": {
      "en": "The drought",
      "sw": "Ukame",
      "am": "ድርቁ"
    },
    "JER.14.11.s1": {
      "en": "Prophets who promise peace",
      "sw": "Manabii wanaoahidi amani",
      "am": "ሰላምን ተስፋ የሚሰጡ ነቢያት"
