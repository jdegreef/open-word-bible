    },
    "JER.32.16.s1": {
      "en": "Jeremiah prays",
      "sw": "Yeremia anaomba",
      "am": "ኤርምያስ ጸለየ"
    },
    "JER.32.36.s1": {
      "en": "An everlasting covenant",
      "sw": "Agano la milele",
      "am": "የዘላለም ቃል ኪዳን"
