    "JER.16.19.s1": {
      "en": "The nations will come",
      "sw": "Mataifa yatakuja",
      "am": "አሕዛብ ይመጣሉ"
    },
    "JER.17.1.s1": {
      "en": "Sin engraved with iron",
      "sw": "Dhambi iliyochorwa kwa chuma",
      "am": "በብረት የተቀረጸ ኃጢአት"
    },
    "JER.17.5.s1": {
      "en": "Cursed and blessed",
      "sw": "Amelaaniwa na amebarikiwa",
      "am": "ርጉምና ቡሩክ"
    },
    "JER.17.19.s1": {
      "en": "Carrying loads on the Sabbath",
      "sw": "Kubeba mizigo siku ya Sabato",
      "am": "በሰንበት ሸክም መሸከም"
    },
    "JER.18.1.s1": {
      "en": "Clay in the potter's hand",
      "sw": "Udongo mkononi mwa mfinyanzi",
      "am": "በሸክላ ሠሪው እጅ ያለ ጭቃ"
    },
    "JER.18.18.s1": {
      "en": "A plot against Jeremiah",
      "sw": "Njama dhidi ya Yeremia",
      "am": "በኤርምያስ ላይ የተደረገ ሤራ"
    },
    "JER.19.1.s1": {
      "en": "Jeremiah breaks a flask",
      "sw": "Yeremia anavunja gudulia",
      "am": "ኤርምያስ የሸክላ ገንቦ ሰበረ"
    },
    "JER.20.1.s1": {
      "en": "Pashhur puts Jeremiah in the stocks",
      "sw": "Pashuri anamtia Yeremia katika mkatale",
