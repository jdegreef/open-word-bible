      "en": "Ammon",
      "sw": "Waamoni",
      "am": "አሞናውያን"
    },
    "JER.49.7.s1": {
      "en": "Edom",
      "sw": "Edomu",
      "am": "ኤዶም"
    },
    "JER.49.23.s1": {
      "en": "Damascus, Kedar and Elam",
      "sw": "Dameski, Kedari na Elamu",
      "am": "ደማስቆ፣ ቄዳርና ኤላም"
