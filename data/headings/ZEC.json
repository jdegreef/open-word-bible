  "status": "ai_draft",
  "headings": {
    "ZEC.1.1.s1": {
      "en": "A call to return to {{divine_name:the LORD|Yahweh}}",
      "sw": "Mwito wa kumrudia {{divine_name:BWANA|Yahwe}}",
      "am": "ወደ {{divine_name:እግዚአብሔር|ያህዌ}} የመመለስ ጥሪ"
    },
    "ZEC.1.7.s1": {
      "en": "The man among the myrtle trees",
      "sw": "Mtu kati ya mihadasi",
      "am": "በባርሰነት ዛፎች መካከል ያለው ሰው"
    },
    "ZEC.2.1.s1": {
      "en": "Four horns and four craftsmen",
      "sw": "Pembe nne na mafundi wanne",
      "am": "አራት ቀንዶችና አራት ጠራቢዎች"
    },
    "ZEC.2.5.s1": {
      "en": "A man with a measuring line",
      "sw": "Mtu mwenye kamba ya kupimia",
      "am": "የመለኪያ ገመድ የያዘ ሰው"
    },
    "ZEC.2.10.s1": {
      "en": "Come home from the land of the north",
      "sw": "Rudini nyumbani kutoka nchi ya kaskazini",
      "am": "ከሰሜን ምድር ወደ ቤታችሁ ተመለሱ"
    },
    "ZEC.2.14.s1": {
      "en": "Sing and rejoice, Daughter Zion",
      "sw": "Imba na ufurahi, Binti Sayuni",
      "am": "የጽዮን ልጅ ሆይ፣ ዘምሪ፤ ደስም ይበልሽ"
    },
    "ZEC.3.1.s1": {
      "en": "Clean clothes for Joshua the high priest",
      "sw": "Mavazi safi kwa Yoshua kuhani mkuu",
      "am": "ለሊቀ ካህናቱ ለኢያሱ ንጹሕ ልብስ"
    },
    "ZEC.4.1.s1": {
      "en": "The gold lampstand and the two olive trees",
      "sw": "Kinara cha taa cha dhahabu na mizeituni miwili",
      "am": "የወርቁ መቅረዝና ሁለቱ የወይራ ዛፎች"
    },
    "ZEC.4.8.s1": {
      "en": "Zerubbabel will finish the house",
      "sw": "Zerubabeli ataimaliza nyumba",
      "am": "ዘሩባቤል ቤቱን ይፈጽማል"
    },
    "ZEC.5.1.s1": {
      "en": "The flying scroll and the woman in the basket",
      "sw": "Gombo linaloruka na mwanamke ndani ya kikapu",
      "am": "የሚበርረው ጥቅልልና በቅርጫቱ ውስጥ ያለችው ሴት"
    },
    "ZEC.6.1.s1": {
      "en": "Four chariots",
      "sw": "Magari manne ya vita",
      "am": "አራቱ ሰረገሎች"
    },
    "ZEC.6.9.s1": {
      "en": "A crown and the Branch",
      "sw": "Taji na Chipukizi",
      "am": "አክሊሉና ቅርንጫፉ"
    },
    "ZEC.7.1.s1": {
      "en": "A question about fasting",
      "sw": "Swali kuhusu kufunga",
      "am": "ስለ ጾም የቀረበ ጥያቄ"
    },
    "ZEC.7.8.s1": {
      "en": "Judge with true justice",
      "sw": "Hukumuni kwa haki ya kweli",
      "am": "በእውነተኛ ፍትሕ ፍረዱ"
    },
    "ZEC.8.1.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} returns to Zion",
      "sw": "{{divine_name:BWANA|Yahwe}} anarudi Sayuni",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} ወደ ጽዮን ይመለሳል"
    },
    "ZEC.8.9.s1": {
      "en": "Let your hands be strong",
      "sw": "Mikono yenu na iwe hodari",
      "am": "እጆቻችሁ ይበርቱ"
    },
    "ZEC.8.18.s1": {
      "en": "Fasts will become festivals",
      "sw": "Mifungo itakuwa sikukuu",
      "am": "ጾሞች በዓላት ይሆናሉ"
    },
    "ZEC.8.20.s1": {
      "en": "The nations will seek {{divine_name:the LORD|Yahweh}}",
      "sw": "Mataifa yatamtafuta {{divine_name:BWANA|Yahwe}}",
      "am": "አሕዛብ {{divine_name:እግዚአብሔርን|ያህዌን}} ይፈልጋሉ"
    },
    "ZEC.9.1.s1": {
      "en": "An oracle against Hadrach, Tyre and the Philistines",
      "sw": "Unabii dhidi ya Hadraki, Tiro na Wafilisti",
      "am": "በሐድራክ፣ በጢሮስና በፍልስጥኤማውያን ላይ የተነገረ የትንቢት ቃል"
    },
    "ZEC.9.9.s1": {
      "en": "Your king is coming",
      "sw": "Mfalme wako anakuja",
      "am": "ንጉሥሽ ይመጣል"
    },
    "ZEC.10.1.s1": {
      "en": "Ask {{divine_name:the LORD|Yahweh}} for rain",
      "sw": "Mwombeni {{divine_name:BWANA|Yahwe}} mvua",
      "am": "{{divine_name:እግዚአብሔርን|ያህዌን}} ዝናብ ለምኑት"
    },
    "ZEC.10.3.s1": {
      "en": "{{divine_name:The LORD|Yahweh}} cares for {{deity_pronoun:his|His}} flock",
      "sw": "{{divine_name:BWANA|Yahwe}} analitunza kundi {{deity_pronoun:lake|Lake}}",
      "am": "{{divine_name:እግዚአብሔር|ያህዌ}} መንጋውን ይንከባከባል"
    },
    "ZEC.11.1.s1": {
      "en": "Open your gates, Lebanon",
      "sw": "Fungua malango yako, Lebanoni",
      "am": "ሊባኖስ ሆይ፣ በሮችህን ክፈት"
    },
    "ZEC.11.4.s1": {
      "en": "The flock marked for slaughter",
      "sw": "Kundi lililowekwa kwa ajili ya kuchinjwa",
      "am": "ለዕርድ የተለየው መንጋ"
    },
    "ZEC.11.15.s1": {
      "en": "The equipment of a foolish shepherd",
      "sw": "Vifaa vya mchungaji mpumbavu",
      "am": "የሞኝ እረኛ መሣሪያዎች"
    },
    "ZEC.11.17.s1": {
      "en": "Woe to the worthless shepherd",
      "sw": "Ole wake mchungaji asiyefaa kitu",
      "am": "ለማይረባው እረኛ ወዮለት"
    },
    "ZEC.12.1.s1": {
      "en": "The word of {{divine_name:the LORD|Yahweh}} concerning Israel",
      "sw": "Neno la {{divine_name:BWANA|Yahwe}} kuhusu Israeli",
      "am": "ስለ እስራኤል የተነገረ {{divine_name:የእግዚአብሔር|የያህዌ}} ቃል"
    },
    "ZEC.12.2.s1": {
      "en": "Jerusalem, a cup that sends the peoples reeling",
      "sw": "Yerusalemu, kikombe kinachowafanya mataifa kupepesuka",
      "am": "ሕዝቦችን የምታንገዳግድ ጽዋ የሆነችው ኢየሩሳሌም"
    },
    "ZEC.12.7.s1": {
      "en": "Judah rescued, and Jerusalem in mourning",
      "sw": "Yuda anaokolewa, na Yerusalemu inaomboleza",
      "am": "ይሁዳ ዳነ፤ ኢየሩሳሌምም አለቀሰች"
    },
    "ZEC.13.1.s1": {
      "en": "A fountain to wash away sin",
      "sw": "Chemchemi ya kuosha dhambi",
      "am": "ኃጢአትን የሚያነጻ ምንጭ"
    },
    "ZEC.13.7.s1": {
      "en": "Strike the shepherd",
      "sw": "Mpige mchungaji",
      "am": "እረኛውን ምታ"
    },
    "ZEC.14.1.s1": {
      "en": "A day of {{divine_name:the LORD|Yahweh}} is coming",
      "sw": "Siku ya {{divine_name:BWANA|Yahwe}} inakuja",
      "am": "{{divine_name:የእግዚአብሔር|የያህዌ}} ቀን ይመጣል"
    }
  }
}
