    "HAB.1.1.s1": {
      "en": "Habakkuk complains, and {{divine_name:the LORD|Yahweh}} answers",
      "sw": "Habakuki analalamika, na {{divine_name:BWANA|Yahwe}} anajibu",
      "am": "ዕንባቆም አጉረመረመ፤ {{divine_name:እግዚአብሔር|ያህዌ}}ም መለሰለት"
    },
    "HAB.2.1.s1": {
      "en": "Write the vision",
      "sw": "Yaandike maono",
      "am": "ራእዩን ጻፈው"
    },
    "HAB.2.9.s1": {
      "en": "Evil gain for his house",
      "sw": "Faida ya uovu kwa nyumba yake",
      "am": "ለቤቱ የሚሰበሰብ የክፋት ትርፍ"
    },
    "HAB.2.12.s1": {
      "en": "A city built with bloodshed",
      "sw": "Mji uliojengwa kwa umwagaji damu",
      "am": "በደም መፍሰስ የተሠራች ከተማ"
    },
    "HAB.2.15.s1": {
      "en": "The cup of shame",
      "sw": "Kikombe cha aibu",
      "am": "የውርደት ጽዋ"
    },
    "HAB.2.18.s1": {
      "en": "Idols that cannot speak",
      "sw": "Sanamu zisizoweza kusema",
      "am": "መናገር የማይችሉ ጣዖታት"
    },
    "HAB.3.1.s1": {
      "en": "Habakkuk's prayer",
      "sw": "Sala ya Habakuki",
      "am": "የዕንባቆም ጸሎት"
    },
    "HAB.3.8.s1": {
      "en": "God rides out to save",
      "sw": "Mungu anatoka akiendesha gari ili kuokoa",
      "am": "እግዚአብሔር ለማዳን ወጣ"
    },
    "HAB.3.14.s1": {
      "en": "Waiting quietly and rejoicing",
      "sw": "Kungoja kwa utulivu na kushangilia",
      "am": "በጸጥታ መጠበቅና ሐሤት ማድረግ"
    }
  }
