    "2KI.19.20.s1": {
      "en": "Isaiah's answer",
      "sw": "Jibu la Isaya",
      "am": "የኢሳይያስ መልስ",
      "vi": "Lời đáp của Ê-sai",
      "ko": "이사야의 대답"
    },
    "2KI.19.32.s1": {
      "en": "The Assyrian army is struck down",
      "sw": "Jeshi la Ashuru linapigwa",
