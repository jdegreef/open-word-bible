    "2KI.25.23.s1": {
      "en": "Gedaliah at Mizpah",
      "sw": "Gedalia huko Mizpa",
      "am": "ጎዶልያስ በምጽጳ",
      "vi": "Ghê-đa-lia tại Mích-pa",
      "ko": "미스바의 그다랴"
    },
    "2KI.25.27.s1": {
      "en": "Jehoiachin is released",
      "sw": "Yehoyakini anaachiliwa",
      "am": "ዮአኪን ተፈታ",
      "vi": "Giê-hô-gia-kin được phóng thích",
      "ko": "풀려난 여호야긴"
    }
