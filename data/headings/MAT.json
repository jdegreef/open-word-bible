    "MAT.16.24.s1": {
      "en": "Taking up the cross",
      "sw": "Kubeba msalaba",
      "am": "መስቀልን መሸከም"
    },
    "MAT.17.1.s1": {
      "en": "Jesus transfigured on the mountain",
      "sw": "Yesu anabadilika sura mlimani",
      "am": "ኢየሱስ በተራራ ላይ ተለወጠ"
    },
    "MAT.17.9.s1": {
      "en": "Elijah has already come",
      "sw": "Eliya amekwisha kuja",
      "am": "ኤልያስ አስቀድሞ መጥቷል"
    },
    "MAT.17.14.s1": {
      "en": "A boy with seizures is healed",
      "sw": "Mvulana mwenye kifafa anaponywa",
      "am": "የሚጥል በሽታ የያዘው ልጅ ተፈወሰ"
    },
    "MAT.17.22.s1": {
      "en": "Jesus speaks again of his death and raising",
      "sw": "Yesu anazungumza tena kuhusu kifo {{deity_pronoun:chake|Chake}} na kufufuliwa {{deity_pronoun:kwake|Kwake}}",
      "am": "ኢየሱስ ስለ ሞቱና ስለ መነሣቱ እንደ ገና ተናገረ"
    },
    "MAT.17.24.s1": {
      "en": "The tax for God's house",
      "sw": "Kodi ya nyumba ya Mungu",
      "am": "የእግዚአብሔር ቤት ግብር"
    },
    "MAT.18.1.s1": {
      "en": "Who is greatest in the kingdom",
      "sw": "Aliye mkuu zaidi katika ufalme",
      "am": "በመንግሥቱ ውስጥ ታላቅ የሆነው ማን ነው"
    },
    "MAT.18.6.s1": {
      "en": "Woe to those who trip up the little ones",
      "sw": "Ole wao wanaowakwaza wadogo hawa",
      "am": "እነዚህን ታናናሾች ለሚያሰናክሉ ወዮላቸው"
    },
    "MAT.18.10.s1": {
      "en": "The Father seeks the sheep that strays",
      "sw": "Baba anamtafuta kondoo aliyepotea",
      "am": "አብ የባዘነውን በግ ይፈልጋል"
    },
    "MAT.18.15.s1": {
      "en": "When a fellow believer sins against you",
      "sw": "Mwamini mwenzako akikukosea",
      "am": "አብሮህ ያለ አማኝ ቢበድልህ"
    },
    "MAT.18.21.s1": {
      "en": "How many times to forgive",
      "sw": "Mara ngapi tusamehe",
      "am": "ስንት ጊዜ ይቅር እንበል"
    },
    "MAT.18.23.s1": {
      "en": "The servant who would not forgive",
      "sw": "Mtumishi asiyetaka kusamehe",
      "am": "ይቅር ለማለት እምቢ ያለው ባሪያ"
    },
    "MAT.19.1.s1": {
      "en": "Jesus leaves Galilee for Judea",
      "sw": "Yesu anaondoka Galilaya kwenda Uyahudi",
      "am": "ኢየሱስ ገሊላን ትቶ ወደ ይሁዳ ሄደ"
    },
    "MAT.19.3.s1": {
      "en": "A question about divorce",
      "sw": "Swali kuhusu talaka",
      "am": "ስለ ፍቺ የቀረበ ጥያቄ"
    },
    "MAT.19.10.s1": {
      "en": "Those who do not marry",
      "sw": "Wale wasiooa",
      "am": "የማያገቡ ሰዎች"
    },
    "MAT.19.13.s1": {
      "en": "Jesus blesses the children",
      "sw": "Yesu anawabariki watoto",
      "am": "ኢየሱስ ሕፃናትን ባረከ"
    },
    "MAT.19.16.s1": {
      "en": "A young man asks about eternal life",
      "sw": "Kijana anauliza kuhusu uzima wa milele",
      "am": "አንድ ወጣት ስለ ዘላለም ሕይወት ጠየቀ"
    },
    "MAT.19.23.s1": {
      "en": "Hard for the rich",
      "sw": "Ni vigumu kwa matajiri",
      "am": "ለሀብታሞች አስቸጋሪ ነው"
    },
    "MAT.19.27.s1": {
      "en": "What the Twelve will receive",
      "sw": "Watakachopokea wale Kumi na Wawili",
      "am": "አሥራ ሁለቱ የሚቀበሉት"
    },
    "MAT.20.1.s1": {
      "en": "Workers hired at every hour",
      "sw": "Wafanyakazi walioajiriwa kila saa",
      "am": "በየሰዓቱ የተቀጠሩ ሠራተኞች"
    },
    "MAT.20.17.s1": {
      "en": "A third warning of death and rising",
      "sw": "Onyo la tatu la kifo na kufufuka",
      "am": "ስለ ሞትና ስለ መነሣት የተሰጠ ሦስተኛ ማስጠንቀቂያ"
    },
    "MAT.20.20.s1": {
      "en": "A mother's request for her sons",
      "sw": "Ombi la mama kwa ajili ya wanawe",
      "am": "አንዲት እናት ለልጆቿ ያቀረበችው ልመና"
    },
    "MAT.20.24.s1": {
      "en": "Great ones and servants",
      "sw": "Wakuu na watumishi",
      "am": "ታላላቆችና አገልጋዮች"
    },
    "MAT.20.29.s1": {
      "en": "Two blind men by the Jericho road",
      "sw": "Vipofu wawili kando ya njia ya Yeriko",
      "am": "በኢያሪኮ መንገድ ዳር የነበሩ ሁለት ዕውሮች"
    },
    "MAT.21.1.s1": {
      "en": "The king comes to Jerusalem on a donkey",
      "sw": "Mfalme anakuja Yerusalemu juu ya punda",
      "am": "ንጉሡ በአህያ ላይ ሆኖ ወደ ኢየሩሳሌም መጣ"
    },
    "MAT.21.12.s1": {
      "en": "Jesus clears the temple",
      "sw": "Yesu anasafisha hekalu",
      "am": "ኢየሱስ ቤተ መቅደሱን አጸዳ"
    },
    "MAT.21.18.s1": {
      "en": "The fig tree with nothing but leaves",
      "sw": "Mtini usio na kitu ila majani",
      "am": "ከቅጠል በቀር ምንም የሌላት በለስ"
    },
    "MAT.21.23.s1": {
      "en": "Who gave Jesus this authority?",
      "sw": "Ni nani aliyempa Yesu mamlaka haya?",
      "am": "ለኢየሱስ ይህን ሥልጣን የሰጠው ማን ነው?"
    },
    "MAT.21.28.s1": {
      "en": "Two sons and their father's will",
      "sw": "Wana wawili na mapenzi ya baba yao",
      "am": "ሁለቱ ልጆችና የአባታቸው ፈቃድ"
    },
    "MAT.21.33.s1": {
      "en": "The tenants who killed the owner's son",
      "sw": "Wakulima waliomuua mwana wa mwenye shamba",
      "am": "የባለቤቱን ልጅ የገደሉት ተከራዮች"
    },
    "MAT.22.1.s1": {
      "en": "The king's wedding banquet",
      "sw": "Karamu ya harusi ya mfalme",
      "am": "የንጉሡ የሰርግ ግብዣ"
    },
    "MAT.22.15.s1": {
      "en": "A question about paying Caesar",
      "sw": "Swali kuhusu kumlipa Kaisari kodi",
      "am": "ለቄሳር ግብር ስለ መክፈል የቀረበ ጥያቄ"
    },
    "MAT.22.23.s1": {
      "en": "Marriage and the resurrection",
      "sw": "Ndoa na ufufuo",
      "am": "ጋብቻና ትንሣኤ"
    },
    "MAT.22.34.s1": {
      "en": "The command that ranks highest",
      "sw": "Amri iliyo kuu kuliko zote",
      "am": "ከሁሉ የምትበልጠው ትእዛዝ"
    },
    "MAT.22.41.s1": {
      "en": "Whose son is the {{christos:Christ|Messiah}}?",
      "sw": "{{christos:Kristo|Masihi}} ni mwana wa nani?",
      "am": "{{christos:ክርስቶስ|መሲሑ}} የማን ልጅ ነው?"
    },
    "MAT.23.1.s1": {
      "en": "The teachers who sit in Moses' seat",
      "sw": "Walimu wanaoketi kwenye kiti cha Musa",
      "am": "በሙሴ ወንበር የተቀመጡ መምህራን"
    },
    "MAT.23.13.s1": {
      "en": "Woe to you, hypocrites",
      "sw": "Ole wenu, wanafiki",
      "am": "እናንተ ግብዞች፣ ወዮላችሁ"
    },
    "MAT.23.29.s1": {
      "en": "The blood of the prophets",
      "sw": "Damu ya manabii",
      "am": "የነቢያት ደም"
    },
    "MAT.24.1.s1": {
      "en": "Not one stone on another",
      "sw": "Hakuna jiwe litakalobaki juu ya jiwe",
      "am": "ድንጋይ በድንጋይ ላይ አይቀርም"
    },
    "MAT.24.3.s1": {
      "en": "The first birth pains",
      "sw": "Mwanzo wa utungu wa kuzaa",
      "am": "የምጡ መጀመሪያ"
    },
    "MAT.24.15.s1": {
      "en": "Flee to the mountains",
      "sw": "Kimbilieni milimani",
      "am": "ወደ ተራሮች ሽሹ"
    },
    "MAT.24.29.s1": {
      "en": "The Son of Man on the clouds of heaven",
      "sw": "Mwana wa Adamu juu ya mawingu ya mbinguni",
      "am": "የሰው ልጅ በሰማይ ደመና ላይ"
    },
    "MAT.24.32.s1": {
      "en": "Summer is near",
      "sw": "Kiangazi kiko karibu",
      "am": "በጋ ቀርቧል"
    },
    "MAT.24.36.s1": {
      "en": "Keep watch, for the day is unknown",
      "sw": "Kesheni, kwa maana siku haijulikani",
      "am": "ቀኑ የማይታወቅ ስለ ሆነ ንቁ"
    },
    "MAT.24.45.s1": {
      "en": "The servant the master finds at work",
      "sw": "Mtumishi ambaye bwana wake anamkuta kazini",
      "am": "ጌታው በሥራ ላይ የሚያገኘው ባሪያ"
    },
    "MAT.25.1.s1": {
      "en": "Ten bridesmaids wait for the bridegroom",
      "sw": "Wapambe kumi wanamngoja bwana harusi",
      "am": "ዐሥር ሚዜዎች ሙሽራውን ጠበቁ"
    },
    "MAT.25.14.s1": {
      "en": "Servants entrusted with their master's money",
      "sw": "Watumishi waliokabidhiwa fedha za bwana wao",
      "am": "የጌታቸው ገንዘብ በዐደራ የተሰጣቸው ባሪያዎች"
    },
    "MAT.25.31.s1": {
      "en": "The Son of Man judges the nations",
      "sw": "Mwana wa Adamu anayahukumu mataifa",
      "am": "የሰው ልጅ በአሕዛብ ላይ ፈረደ"
    },
    "MAT.26.1.s1": {
      "en": "The plot against Jesus",
      "sw": "Njama dhidi ya Yesu",
      "am": "በኢየሱስ ላይ የተደረገ ሤራ"
    },
    "MAT.26.6.s1": {
      "en": "A woman anoints Jesus at Bethany",
      "sw": "Mwanamke anampaka Yesu manukato huko Bethania",
      "am": "አንዲት ሴት በቢታንያ ኢየሱስን ሽቱ ቀባች"
    },
    "MAT.26.17.s1": {
      "en": "The Passover with the Twelve",
      "sw": "Pasaka pamoja na wale Kumi na Wawili",
      "am": "ከአሥራ ሁለቱ ጋር የተበላው ፋሲካ"
    },
    "MAT.26.36.s1": {
      "en": "Jesus prays in Gethsemane",
      "sw": "Yesu anaomba huko Gethsemane",
      "am": "ኢየሱስ በጌቴሴማኒ ጸለየ"
    },
    "MAT.26.47.s1": {
      "en": "Judas's kiss and the arrest",
      "sw": "Busu la Yuda na kukamatwa",
      "am": "የይሁዳ መሳምና የኢየሱስ መያዝ"
    },
    "MAT.26.57.s1": {
      "en": "Jesus before the council",
      "sw": "Yesu mbele ya Baraza",
      "am": "ኢየሱስ በሸንጎው ፊት"
    },
    "MAT.27.1.s1": {
      "en": "Jesus handed over to Pilate",
      "sw": "Yesu anakabidhiwa kwa Pilato",
      "am": "ኢየሱስ ለጲላጦስ ተላልፎ ተሰጠ"
    },
    "MAT.27.3.s1": {
      "en": "Judas and the thirty pieces of silver",
      "sw": "Yuda na vipande thelathini vya fedha",
      "am": "ይሁዳና ሠላሳው ብር"
    },
    "MAT.27.11.s1": {
      "en": "Jesus before the governor",
      "sw": "Yesu mbele ya mkuu wa mkoa",
      "am": "ኢየሱስ በአገረ ገዡ ፊት"
    },
    "MAT.27.27.s1": {
      "en": "The soldiers mock the King of the Jews",
      "sw": "Askari wanamdhihaki Mfalme wa Wayahudi",
      "am": "ወታደሮቹ በአይሁድ ንጉሥ ላይ አፌዙ"
    },
    "MAT.27.32.s1": {
      "en": "Jesus is crucified",
      "sw": "Yesu anasulubiwa",
      "am": "ኢየሱስ ተሰቀለ"
    },
    "MAT.27.45.s1": {
      "en": "The death of Jesus",
      "sw": "Kifo cha Yesu",
      "am": "የኢየሱስ ሞት"
    },
    "MAT.27.57.s1": {
      "en": "The burial and the guard at the tomb",
      "sw": "Kuzikwa na walinzi kaburini",
      "am": "መቀበሩና በመቃብሩ ላይ የቆሙት ጠባቂዎች"
    },
    "MAT.28.1.s1": {
      "en": "The tomb is empty",
      "sw": "Kaburi ni tupu",
      "am": "መቃብሩ ባዶ ነው"
    },
    "MAT.28.11.s1": {
      "en": "The guards' story",
      "sw": "Habari ya walinzi",
      "am": "የጠባቂዎቹ ወሬ"
    },
    "MAT.28.16.s1": {
      "en": "Sent to all the nations",
      "sw": "Wanatumwa kwa mataifa yote",
      "am": "ወደ አሕዛብ ሁሉ ተላኩ"
    }
  }
}
