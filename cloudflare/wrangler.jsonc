// openwordbible.org on Cloudflare Workers static assets: the site CI builds
// (scripts/build_site.py -> site/) served as it is, and a Worker
// (cloudflare/worker.js) for the pages no file holds: every verse's page in
// every language, and each chapter at its Literal and Readable levels
// (build_site.py WORKER_PAGES).
// CI deploys it from main (.github/workflows/ci.yml, "Deploy to
// Cloudflare"); docs/cloudflare.md has the setup and the switch from Render.
//
// A Workers Paid plan is needed: the site has over 50,000 files, and the
// free plan allows 20,000 per version (paid: 100,000; 25 MiB a file).
// Requests for static assets are not billed, on either plan; requests the
// Worker answers are (10 million a month are in the paid plan).
{
  "name": "open-word-bible",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  // A page the site has no file for goes to the Worker, which draws it or
  // hands it on to the 404 page. Without this flag a browser's visit to one
  // would get the 404 page without asking the Worker.
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    // /jhn/3 and /jhn/3/ both serve jhn/3/index.html, as on Render.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Until the domains move (docs/cloudflare.md), the site answers at
  // open-word-bible.<account>.workers.dev only.
  "workers_dev": true
}
