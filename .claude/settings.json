{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m owb.validate:*)",
      "Bash(python3 scripts/fetch_sources.py:*)",
      "Bash(python3 scripts/extract_tokens.py --check:*)",
      "Bash(python3 scripts/build_site.py:*)",
      "Bash(python3 scripts/check_budgets.py:*)",
      "Bash(python3 scripts/poetry_lines.py:*)",
      "Bash(python3 scripts/ngram_overlap.py:*)",
      "Bash(python backend/manage.py test:*)",
      "Bash(python backend/manage.py makemigrations --check:*)",
      "Bash(uvx ruff@0.16.9 check:*)",
      "Bash(node --test:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_edits.py"
          }
        ]
      }
    ]
  }
}
