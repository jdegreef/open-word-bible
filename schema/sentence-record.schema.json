{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwordbible.invalid/schema/sentence-record.schema.json",
  "title": "Open Word Bible sentence record",
  "description": "One source sentence with its literal gloss, translations at three levels, and the reasoning behind each translation decision.",
  "type": "object",
  "required": ["id", "refs", "source", "literal_gloss", "renderings", "decisions", "status"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "description": "Stable record id: first verse id, then the sentence number within that verse.",
      "type": "string",
      "pattern": "^[1-3]?[A-Z]{2,3}\\.[0-9]+\\.[0-9]+\\.s[0-9]+$"
    },
    "refs": {
      "description": "Verse ids the sentence covers, in order.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/verse_id"}
    },
    "source": {
      "type": "object",
      "required": ["language", "text_id", "tokens"],
      "additionalProperties": false,
      "properties": {
        "language": {"enum": ["grc", "hbo", "arc"]},
        "text_id": {"description": "Edition and version of the source text.", "enum": ["SBLGNT@v1.2"]},
        "tokens": {
          "description": "Source word ids (MACULA xml:id), in text order.",
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/token_id"}
        },
        "text": {
          "description": "The source text of these tokens. Generated from source data by scripts/build_skeleton.py; never edited by hand.",
          "type": "string"
        }
      }
    },
    "literal_gloss": {
      "description": "A word-for-word English gloss of the source, in source order.",
      "type": "string"
    },
    "renderings": {
      "description": "Translation per language code, at each level: L = Literal (OWB-L), B = Balanced (OWB-B), R = Readable (OWB-R). Text may contain {{setting:default|alt}} spans.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/language"},
      "additionalProperties": {
        "type": "object",
        "required": ["L", "B", "R"],
        "additionalProperties": false,
        "properties": {
          "L": {"type": "string"},
          "B": {"type": "string"},
          "R": {"type": "string"}
        }
      }
    },
    "alignments": {
      "description": "Optional links from source tokens to a span of one rendering.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tokens", "language", "level", "target_span"],
        "additionalProperties": false,
        "properties": {
          "tokens": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token_id"}},
          "language": {"$ref": "#/$defs/language"},
          "level": {"$ref": "#/$defs/level"},
          "target_span": {"description": "Text that occurs in that rendering.", "type": "string"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "status": {"enum": ["ai_draft", "meaning_reviewed", "reviewed", "revised"]}
  },
  "$defs": {
    "verse_id": {"type": "string", "pattern": "^[1-3]?[A-Z]{2,3}\\.[0-9]+\\.[0-9]+$"},
    "token_id": {"type": "string", "pattern": "^n[0-9]{11}$"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "level": {"enum": ["L", "B", "R"]},
    "decision": {
      "description": "One translation decision. Meaning decisions are written once per passage and shared by every language and level; rendering decisions belong to one language and one or more levels.",
      "type": "object",
      "required": ["id", "layer", "language", "category", "tokens", "choice", "alternatives", "reason", "uncertain", "footnote"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "layer": {"enum": ["meaning", "rendering"]},
        "language": {"type": ["string", "null"]},
        "levels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
        "category": {
          "enum": ["text_variant", "punctuation", "word_sense", "grammar", "allusion", "idiom", "culture", "theology", "word_choice", "word_order", "register", "supplied_words", "setting_alternative"]
        },
        "tokens": {"type": "array", "items": {"$ref": "#/$defs/token_id"}},
        "choice": {"type": "string"},
        "alternatives": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": "string"},
        "uncertain": {"type": "boolean"},
        "footnote": {"type": "boolean"}
      },
      "if": {"properties": {"layer": {"const": "meaning"}}},
      "then": {
        "properties": {
          "language": {"type": "null"},
          "category": {
            "description": "Meaning decisions state the sense only; wording categories belong to rendering decisions.",
            "enum": ["text_variant", "punctuation", "word_sense", "grammar", "allusion", "idiom", "culture", "theology"]
          }
        },
        "not": {"required": ["levels"]}
      },
      "else": {"properties": {"language": {"$ref": "#/$defs/language"}}, "required": ["levels"]}
    }
  }
}
